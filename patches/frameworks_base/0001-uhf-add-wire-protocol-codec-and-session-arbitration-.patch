+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.uhf;
+
+/**
+ * Abstraction over the physical link to the reader, so that {@link UhfSessionArbiter} — the class
+ * that actually encodes the platform's policy (exclusivity, the antenna-check interlock, the
+ * power ceiling, streaming's mutual exclusion with everything else) — can be unit tested on the
+ * host with a fake, without a reader, a tty, or even a JNI layer.
+ *
+ * <p>Per UHF-SRS-001 &sect;3.2's "phased alternative", this is implemented in Phase 1 by
+ * {@code UhfSerialTransport}, a thin JNI shim opened directly from {@code system_server} against
+ * {@code /dev/ttyUSB*}. In Phase 2 the same interface is satisfied instead by a Binder proxy to
+ * the vendor HAL (AIDL {@code vendor.rockchip.hardware.uhf.IUhfReader}), and
+ * {@link UhfSessionArbiter} does not change at all — this boundary is exactly where &sect;3.2 says
+ * the HAL split happens.
+ */
+public interface UhfTransport {
+
+    /** Opens the link. Idempotent: calling it while already open is a no-op. */
+    void open() throws UhfTransportException;
+
+    /** Closes the link. Idempotent: calling it while already closed is a no-op. */
+    void close();
+
+    boolean isOpen();
+
+    /**
+     * Sends one framed command and returns its payload once a reply whose {@code reCmd} matches
+     * {@code command} has been received (UhfProtocol#reCmdMatches), or throws on timeout or a
+     * reader-reported error status. Multi-frame replies (status 0x03) are assembled internally;
+     * callers see one concatenated result.
+     */
+    byte[] transact(int command, byte[] payload, int timeoutMs) throws UhfTransportException;
+
+    /**
+     * Enters real-time streaming mode (cmd 0x76) and delivers batches to {@code callback} until
+     * {@link #stopStream} is called. Returns once the mode-entry command is acknowledged; delivery
+     * happens asynchronously on an implementation-owned thread.
+     */
+    void startStream(StreamCallback callback) throws UhfTransportException;
+
+    /**
+     * Leaves real-time mode. Per FR-STR-07, a correct implementation retries the stop frame and
+     * confirms the port has gone quiet before returning; this interface only promises that once
+     * this call returns, no further {@link StreamCallback} invocation for this stream instance
+     * will occur.
+     */
+    void stopStream();
+
+    /** Delivery sink for {@link #startStream}. */
+    interface StreamCallback {
+        void onTagBatch(byte[][] rawTagRecords);
+        void onError(int transportErrorCode);
+    }
+}
