+package com.android.server.uhf;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Wire-protocol codec for the UHF RFID reader (UHF-SRS-001 R1/R2).
+ *
+ * <p>This class owns exactly what the reader's wire format requires and nothing else: framing,
+ * CRC16, resync-on-corruption, reply matching, and decoding the handful of response payloads this
+ * phase of the platform needs (identify, inventory). It has no dependency on Android framework
+ * classes and no I/O of its own — {@link UhfTransport} supplies raw bytes, this class turns them
+ * into {@link Frame}s and back. That separation is deliberate: per UHF-SRS-001 &sect;3.2, this
+ * logic is the part that later moves into the vendor HAL essentially unchanged, and it is the part
+ * with the highest cost of being wrong (FR-LNK-06's note describes a corrupted-command failure
+ * mode that a naive implementation reproduces easily).
+ *
+ * <p><b>What is settled vs. assumed.</b> The frame shape, the requirement that CRC over the whole
+ * frame (including its own CRC bytes) come out to zero, the resync rule, and the reCmd-matching
+ * rule are all directly and unambiguously stated in UHF-SRS-001 &sect;4.3 and are implemented
+ * exactly as specified. The one thing the SRS does not pin down is the CRC16 variant: "CRC16" is
+ * an algorithm family, not one algorithm. This class assumes CRC-16/MODBUS (reflected, poly
+ * 0xA001, init 0xFFFF, no xorout) because that is the variant used by every other reader in this
+ * family's lineage that exposes this exact frame shape, but until R1/R3 is on disk (SRS OI-01)
+ * this is an inference, not a verified fact — see {@link #CRC16_INIT}. If it is wrong, exactly one
+ * constant changes; every test in UhfProtocolTest that depends on it is written against that same
+ * constant, not against a hand-computed magic number, so a wrong assumption fails loudly instead
+ * of silently.
+ */
+public final class UhfProtocol {
+
+    private UhfProtocol() {}
+
+    /** Minimum legal value of the on-wire Len byte: Adr + Cmd + CRC-L + CRC-H, no data. */
+    public static final int MIN_LEN_FIELD = 4;
+
+    /** Maximum on-wire Len byte value (it is a single unsigned byte). */
+    public static final int MAX_LEN_FIELD = 0xFF;
+
+    /**
+     * CRC-16/MODBUS initial register value. See the class doc: this is an inference pending R1,
+     * isolated to this one constant on purpose.
+     */
+    static final int CRC16_INIT = 0xFFFF;
+
+    // -------------------------------------------------------------------------------------------
+    // CRC16
+    // -------------------------------------------------------------------------------------------
+
+    /**
+     * Computes CRC-16/MODBUS (reflected, poly 0xA001, init {@link #CRC16_INIT}, xorout 0) over
+     * {@code length} bytes of {@code data} starting at {@code offset}.
+     */
+    public static int crc16(byte[] data, int offset, int length) {
+        if (data == null) {
+            throw new NullPointerException("data");
+        }
+        if (offset < 0 || length < 0 || offset + length > data.length) {
+            throw new IndexOutOfBoundsException(
+                    "offset=" + offset + " length=" + length + " data.length=" + data.length);
+        }
+        int crc = CRC16_INIT;
+        for (int i = 0; i < length; i++) {
+            crc ^= (data[offset + i] & 0xFF);
+            for (int bit = 0; bit < 8; bit++) {
+                boolean lsbSet = (crc & 0x0001) != 0;
+                crc >>>= 1;
+                if (lsbSet) {
+                    crc ^= 0xA001;
+                }
+            }
+        }
+        return crc & 0xFFFF;
+    }
+
+    /**
+     * Whether {@code data[offset..offset+length)} is a structurally complete frame whose trailing
+     * two bytes are its own correct CRC16, per FR-LNK-03: CRC is computed over the whole frame
+     * <em>including</em> its CRC bytes and must come out to zero.
+     */
+    public static boolean isCrcValid(byte[] data, int offset, int length) {
+        if (length < 2) {
+            return false;
+        }
+        return crc16(data, offset, length) == 0;
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // Frame model and building
+    // -------------------------------------------------------------------------------------------
+
+    /** One decoded serial frame: {@code Len | Adr | Cmd | Data[] | CRC16-LSB | CRC16-MSB}. */
+    public static final class Frame {
+        /** Reader address; {@link #ADDRESS_BROADCAST} (0xFF) means "any reader". */
+        public final int address;
+        /** Command byte. On a reply this is {@code reCmd} — see {@link #reCmdMatches}. */
+        public final int command;
+        /** Payload bytes, i.e. everything between Cmd and the CRC. Never null; may be empty. */
+        public final byte[] data;
+        /** Total on-wire size of this frame in bytes, including the leading Len byte. */
+        public final int wireLength;
+
+        Frame(int address, int command, byte[] data, int wireLength) {
+            this.address = address;
+            this.command = command;
+            this.data = data;
+            this.wireLength = wireLength;
+        }
+
+        /**
+         * The first payload byte, by convention the reader's status/result code for the command
+         * families that use one (inventory, buffered inventory, real-time mode). Callers that
+         * know their command doesn't use a leading status byte (e.g. 0x21 identify) should not
+         * call this and should index {@link #data} directly instead.
+         */
+        public int statusByte() {
+            if (data.length == 0) {
+                throw new IllegalStateException("frame for cmd 0x"
+                        + Integer.toHexString(command) + " carries no data/status byte");
+            }
+            return data[0] & 0xFF;
+        }
+    }
+
+    public static final int ADDRESS_BROADCAST = 0xFF;
+
+    /**
+     * Builds a complete on-wire frame for {@code command} with {@code payload} as its data,
+     * addressed to {@code address}, including a correct trailing CRC16.
+     */
+    public static byte[] buildFrame(int address, int command, byte[] payload) {
+        if (payload == null) {
+            payload = new byte[0];
+        }
+        int len = 2 + payload.length + 2; // Adr + Cmd + Data + CRC16(2)
+        if (len > MAX_LEN_FIELD) {
+            throw new IllegalArgumentException(
+                    "payload too large: encoded Len " + len + " exceeds " + MAX_LEN_FIELD);
+        }
+        byte[] frame = new byte[1 + len];
+        frame[0] = (byte) len;
+        frame[1] = (byte) address;
+        frame[2] = (byte) command;
+        System.arraycopy(payload, 0, frame, 3, payload.length);
+        int crc = crc16(frame, 0, 3 + payload.length);
+        frame[3 + payload.length] = (byte) (crc & 0xFF);         // CRC16-LSB
+        frame[3 + payload.length + 1] = (byte) ((crc >>> 8) & 0xFF); // CRC16-MSB
+        return frame;
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // Parsing / resync
+    // -------------------------------------------------------------------------------------------
+
+    /** Outcome of one scan attempt over a receive buffer. */
+    public enum ScanOutcome {
+        /** A complete, CRC-valid frame was found at the scan start position. */
+        FRAME,
+        /** Not enough bytes buffered yet to know either way; keep the bytes and read more. */
+        NEED_MORE_DATA,
+        /**
+         * The byte(s) at the scan start position cannot begin a valid frame (FR-LNK-04): either
+         * the leading byte is below {@link #MIN_LEN_FIELD}, or a full-length frame's CRC did not
+         * check out. The caller must discard exactly {@link ScanResult#bytesToDiscard} byte(s)
+         * and scan again — never discard the whole buffer, or a real frame one byte later is
+         * lost along with the garbage.
+         */
+        RESYNC,
+    }
+
+    /** Result of one {@link #scan} call. */
+    public static final class ScanResult {
+        public final ScanOutcome outcome;
+        /** Valid only when {@code outcome == FRAME}. */
+        public final Frame frame;
+        /** Valid only when {@code outcome == RESYNC}: how many leading bytes to drop. */
+        public final int bytesToDiscard;
+
+        private ScanResult(ScanOutcome outcome, Frame frame, int bytesToDiscard) {
+            this.outcome = outcome;
+            this.frame = frame;
+            this.bytesToDiscard = bytesToDiscard;
+        }
+
+        static ScanResult frame(Frame f) {
+            return new ScanResult(ScanOutcome.FRAME, f, 0);
+        }
+
+        static ScanResult needMoreData() {
+            return new ScanResult(ScanOutcome.NEED_MORE_DATA, null, 0);
+        }
+
+        static ScanResult resync(int bytesToDiscard) {
+            return new ScanResult(ScanOutcome.RESYNC, null, bytesToDiscard);
+        }
+    }
+
+    /**
+     * Scans for one frame starting at {@code buf[offset]}, within the {@code length} valid bytes
+     * available. Implements FR-LNK-03/04 exactly: a leading length byte below
+     * {@link #MIN_LEN_FIELD} is immediately unrecoverable garbage (discard 1 byte and rescan); a
+     * structurally complete candidate frame whose CRC does not check out is also discarded one
+     * byte at a time, never assumed to be "nearly right" and repaired.
+     *
+     * <p>This method never throws on malformed input and never reads past {@code offset+length}
+     * — see UhfProtocolTest's fuzz test (NFR-R-05: "a byte stream of random data shall be consumed
+     * without exception").
+     */
+    public static ScanResult scan(byte[] buf, int offset, int length) {
+        if (length <= 0) {
+            return ScanResult.needMoreData();
+        }
+        int lenField = buf[offset] & 0xFF;
+        if (lenField < MIN_LEN_FIELD) {
+            return ScanResult.resync(1);
+        }
+        int wireLength = 1 + lenField;
+        if (length < wireLength) {
+            return ScanResult.needMoreData();
+        }
+        if (!isCrcValid(buf, offset, wireLength)) {
+            return ScanResult.resync(1);
+        }
+        int address = buf[offset + 1] & 0xFF;
+        int command = buf[offset + 2] & 0xFF;
+        int dataLen = lenField - 4; // Adr + Cmd + CRC16(2) accounted for
+        byte[] data = new byte[dataLen];
+        System.arraycopy(buf, offset + 3, data, 0, dataLen);
+        return ScanResult.frame(new Frame(address, command, data, wireLength));
+    }
+
+    /**
+     * Like {@link #scan}, but additionally implements FR-LNK-05's half of frame recovery: a
+     * leading length byte can be syntactically valid (&gt;= {@link #MIN_LEN_FIELD}) while actually
+     * being corrupted receive noise that happens to decode to a large value — for example, the
+     * CRC byte of a previous corrupted frame, reinterpreted as the next frame's length prefix. A
+     * bare {@link #scan} correctly reports {@link ScanOutcome#NEED_MORE_DATA} for that case: it
+     * cannot know the candidate is bogus without the bytes its own length field promises. That is
+     * exactly right on a live, still-receiving connection, and wrong forever on a stalled one —
+     * FR-LNK-05 specifies the reader-side half of this ("keep the inter-byte gap below 15&nbsp;ms
+     * or the reader discards the partial frame"); this is the receive-side half of the same idea.
+     *
+     * @param staleTimeoutElapsed whether the transport's inter-byte timeout (FR-LNK-05) has
+     *     elapsed since the last byte was appended to this buffer with no new bytes arriving. When
+     *     {@code false} this behaves exactly like {@link #scan}. When {@code true} and the
+     *     underlying scan is still waiting on more bytes, the leading byte is treated as receive
+     *     noise and discarded — the same one-byte-at-a-time recovery {@link #scan} already applies
+     *     to a bad CRC, just triggered by a stall instead of a checksum mismatch.
+     */
+    public static ScanResult scanWithStallRecovery(
+            byte[] buf, int offset, int length, boolean staleTimeoutElapsed) {
+        ScanResult r = scan(buf, offset, length);
+        if (r.outcome == ScanOutcome.NEED_MORE_DATA && length > 0 && staleTimeoutElapsed) {
+            return ScanResult.resync(1);
+        }
+        return r;
+    }
+
+    /**
+     * FR-LNK-06: a reply is only accepted as the answer to {@code sentCommand} if its echoed
+     * command byte equals what was sent — a structurally valid, CRC-correct frame is not enough,
+     * because in real-time mode the port is flooded with unsolicited 0xEE tag frames that pass
+     * both those checks.
+     */
+    public static boolean reCmdMatches(Frame reply, int sentCommand) {
+        return reply.command == sentCommand;
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // Status -> API error mapping (SRS §5.5, normative)
+    // -------------------------------------------------------------------------------------------
+
+    public static final int STATUS_INVENTORY_COMPLETE = 0x01;
+    public static final int STATUS_INVENTORY_TIMEOUT_PARTIAL = 0x02;
+    public static final int STATUS_MORE_FRAMES_FOLLOW = 0x03;
+    public static final int STATUS_READER_MEMORY_FULL = 0x04;
+    public static final int STATUS_ANTENNA_CHECK_FAILURE = 0xF8;
+    public static final int STATUS_COMMAND_EXECUTION_ERROR = 0xF9;
+    public static final int STATUS_NO_OPERABLE_TAGS = 0xFB;
+    public static final int STATUS_COMMAND_LENGTH_ERROR = 0xFD;
+    public static final int STATUS_ILLEGAL_COMMAND_OR_CRC = 0xFE;
+    public static final int STATUS_PARAMETER_ERROR = 0xFF;
+
+    /** Stable API error codes surfaced to {@code UhfException}. 0 means "not an error". */
+    public static final int ERROR_NONE = 0;
+    public static final int ERROR_BUFFER_FULL = 1;
+    public static final int ERROR_ANTENNA_FAULT = 2;
+    public static final int ERROR_COMMAND_REJECTED = 3;
+    public static final int ERROR_PROTOCOL = 4;
+    public static final int ERROR_INVALID_PARAMETER = 5;
+    public static final int ERROR_TIMEOUT = 6;
+    public static final int ERROR_DEVICE_LOST = 7;
+    public static final int ERROR_BUSY = 8;
+
+    /**
+     * Maps a reader status byte to the stable API error per SRS §5.5. {@code 0x00}, {@code 0x01}
+     * and {@code 0xFB} map to {@link #ERROR_NONE} deliberately: success, "inventory complete", and
+     * "no tags in field" are all ordinary outcomes, not exceptions (FR-INV-08) — a caller that
+     * throws on an empty field forces every inventory call into a try/catch for a non-error.
+     * {@code 0x03} ("more frames follow") is internal to frame assembly and must never reach this
+     * method; passing it is a bug in the caller, not a reader condition, so it throws rather than
+     * returning a plausible-looking wrong answer.
+     */
+    public static int mapStatusToError(int status) {
+        switch (status) {
+            case 0x00:
+            case STATUS_INVENTORY_COMPLETE:
+            case STATUS_NO_OPERABLE_TAGS:
+                return ERROR_NONE;
+            case STATUS_INVENTORY_TIMEOUT_PARTIAL:
+                return ERROR_NONE; // caller marks the result partial; not an exception
+            case STATUS_READER_MEMORY_FULL:
+                return ERROR_BUFFER_FULL;
+            case STATUS_ANTENNA_CHECK_FAILURE:
+                return ERROR_ANTENNA_FAULT;
+            case STATUS_COMMAND_EXECUTION_ERROR:
+                return ERROR_COMMAND_REJECTED;
+            case STATUS_COMMAND_LENGTH_ERROR:
+            case STATUS_ILLEGAL_COMMAND_OR_CRC:
+                return ERROR_PROTOCOL;
+            case STATUS_PARAMETER_ERROR:
+                return ERROR_INVALID_PARAMETER;
+            case STATUS_MORE_FRAMES_FOLLOW:
+                throw new IllegalArgumentException(
+                        "0x03 (more frames follow) is a continuation marker, not a terminal "
+                                + "status; the frame assembler must consume it, never the mapper");
+            default:
+                throw new IllegalArgumentException(
+                        "unmapped reader status 0x" + Integer.toHexString(status)
+                                + " — §5.5 has no row for this; add one rather than guessing");
+        }
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // 0x21 — reader identity decode (FR-INF-01..03)
+    // -------------------------------------------------------------------------------------------
+
+    /** Decoded response to command 0x21 ("get reader information"). */
+    public static final class ReaderInfo {
+        public final int versionMajor;
+        public final int versionMinor;
+        public final int modelType;
+        public final boolean supportsIso18000_6c;
+        public final boolean supportsIso18000_6b;
+        public final int bandCode;
+        public final int maxRfPower;
+        public final int scanTimeUnits; // reader's native 100ms units; see FR-INV-07
+        public final int antennaMask;
+        public final boolean antennaCheckEnabled;
+
+        ReaderInfo(int versionMajor, int versionMinor, int modelType,
+                boolean supportsIso18000_6c, boolean supportsIso18000_6b, int bandCode,
+                int maxRfPower, int scanTimeUnits, int antennaMask, boolean antennaCheckEnabled) {
+            this.versionMajor = versionMajor;
+            this.versionMinor = versionMinor;
+            this.modelType = modelType;
+            this.supportsIso18000_6c = supportsIso18000_6c;
+            this.supportsIso18000_6b = supportsIso18000_6b;
+            this.bandCode = bandCode;
+            this.maxRfPower = maxRfPower;
+            this.scanTimeUnits = scanTimeUnits;
+            this.antennaMask = antennaMask;
+            this.antennaCheckEnabled = antennaCheckEnabled;
+        }
+
+        public String firmwareVersionString() {
+            return versionMajor + "." + versionMinor;
+        }
+    }
+
+    // Field offsets within the 0x21 response payload. FR-INF-02 is the load-bearing requirement
+    // here: Version is TWO bytes (major, minor), and every offset below is one higher than a
+    // naive one-byte-Version reading would produce. Getting this wrong doesn't fail loudly (see
+    // the SRS's "why FR-INF-02 is called out separately" note) — it produces a different,
+    // plausible-looking, wrong band/power/mask. The offsets are named constants for exactly that
+    // reason: a reviewer can check them against R1 without re-deriving the arithmetic.
+    private static final int OFF_VERSION_MAJOR = 0;
+    private static final int OFF_VERSION_MINOR = 1;
+    private static final int OFF_MODEL_TYPE = 2;
+    private static final int OFF_PROTOCOL_SUPPORT = 3; // bit0: 6C, bit1: 6B (Confirm; see OI-01)
+    private static final int OFF_DMAXFRE = 4;
+    private static final int OFF_DMINFRE = 5;
+    private static final int OFF_POWER = 6;
+    private static final int OFF_SCANTIME = 7;
+    private static final int OFF_ANTENNA_MASK = 8;
+    private static final int OFF_ANTENNA_CHECK = 9;
+    private static final int MIN_IDENTIFY_PAYLOAD_LEN = 10;
+
+    /**
+     * Decodes an 0x21 response payload per FR-INF-01..03. Throws {@link IllegalArgumentException}
+     * on a payload shorter than the fields this decode needs, rather than silently reading zeros
+     * — a truncated identify response is a protocol bug worth surfacing, not a set of defaults
+     * worth guessing (compare TST-U-03, which pins this decode against a full captured response).
+     */
+    public static ReaderInfo decodeReaderInfo(byte[] payload) {
+        if (payload == null || payload.length < MIN_IDENTIFY_PAYLOAD_LEN) {
+            throw new IllegalArgumentException("0x21 payload too short: "
+                    + (payload == null ? "null" : payload.length + " bytes") + ", need >= "
+                    + MIN_IDENTIFY_PAYLOAD_LEN);
+        }
+        int versionMajor = payload[OFF_VERSION_MAJOR] & 0xFF;
+        int versionMinor = payload[OFF_VERSION_MINOR] & 0xFF;
+        int modelType = payload[OFF_MODEL_TYPE] & 0xFF;
+        int protocolSupport = payload[OFF_PROTOCOL_SUPPORT] & 0xFF;
+        int dmaxfre = payload[OFF_DMAXFRE] & 0xFF;
+        int dminfre = payload[OFF_DMINFRE] & 0xFF;
+        int power = payload[OFF_POWER] & 0xFF;
+        int scanTime = payload[OFF_SCANTIME] & 0xFF;
+        int antennaMask = payload[OFF_ANTENNA_MASK] & 0xFF;
+        boolean antennaCheck = (payload[OFF_ANTENNA_CHECK] & 0xFF) != 0;
+
+        // FR-INF-03: band code = (dmaxfre >> 6) << 2 | (dminfre >> 6), verbatim from the SRS.
+        int bandCode = ((dmaxfre >> 6) << 2) | (dminfre >> 6);
+
+        return new ReaderInfo(versionMajor, versionMinor, modelType,
+                (protocolSupport & 0x01) != 0, (protocolSupport & 0x02) != 0,
+                bandCode, power, scanTime, antennaMask, antennaCheck);
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // Region / frequency plan (§4.4, band formulae table — normative)
+    // -------------------------------------------------------------------------------------------
+
+    /** One row of the §4.4 band-formula table. */
+    public static final class BandPlan {
+        public final int code;
+        public final String name;
+        public final double startMhz;
+        public final double stepMhz;
+        public final int maxN;
+
+        BandPlan(int code, String name, double startMhz, double stepMhz, int maxN) {
+            this.code = code;
+            this.name = name;
+            this.startMhz = startMhz;
+            this.stepMhz = stepMhz;
+            this.maxN = maxN;
+        }
+
+        public double centerFrequencyMhz(int n) {
+            if (n < 0 || n > maxN) {
+                throw new IllegalArgumentException(
+                        "N=" + n + " out of range [0," + maxN + "] for band " + name);
+            }
+            return startMhz + n * stepMhz;
+        }
+    }
+
+    private static final BandPlan[] BAND_PLANS = {
+        new BandPlan(0b0001, "China band 2", 920.125, 0.25, 19),
+        new BandPlan(0b0010, "US", 902.75, 0.5, 49),
+        new BandPlan(0b0011, "Korea", 917.1, 0.2, 31),
+        new BandPlan(0b0100, "EU", 865.1, 0.2, 14),
+        new BandPlan(0b0110, "Ukraine", 868.0, 0.1, 6),
+        new BandPlan(0b0111, "Peru", 916.2, 0.9, 11),
+        new BandPlan(0b1000, "China band 1", 840.125, 0.25, 19),
+        new BandPlan(0b1001, "EU3", 865.7, 0.6, 3),
+        new BandPlan(0b1010, "Taiwan", 922.25, 0.5, 11),
+        new BandPlan(0b1100, "US band 3", 902.0, 0.5, 52),
+    };
+
+    /** Looks up the band plan for a band code, or {@code null} if the code is unassigned. */
+    public static BandPlan bandPlanForCode(int code) {
+        for (BandPlan p : BAND_PLANS) {
+            if (p.code == code) {
+                return p;
+            }
+        }
+        return null;
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // Multi-frame inventory assembly (FR-INV-02/03) and payload decode (FR-INV-10)
+    // -------------------------------------------------------------------------------------------
+
+    /** One tag record extracted from an inventory response payload, per FR-INV-10. */
+    public static final class TagRecord {
+        public final byte[] epc;
+        /** Non-null only when the EPC+TID bit was set for this record. */
+        public final byte[] tid;
+        public final int rssi;
+
+        TagRecord(byte[] epc, byte[] tid, int rssi) {
+            this.epc = epc;
+            this.tid = tid;
+            this.rssi = rssi;
+        }
+    }
+
+    // FR-INV-10: "the EPC block length field's bit 7 (EPC+TID present) and bit 6 (phase and
+    // frequency data follow), masking the length to bits 5-0."
+    private static final int FLAG_EPC_TID_PRESENT = 0x80;
+    private static final int FLAG_PHASE_FREQ_PRESENT = 0x40;
+    private static final int LENGTH_MASK = 0x3F;
+
+    /**
+     * Concatenates the data payloads of a chain of inventory-response frames that share one
+     * {@code reCmd} while intermediate frames report {@link #STATUS_MORE_FRAMES_FOLLOW}
+     * (FR-INV-02), then decodes the result into individual tag records (FR-INV-10). The chain
+     * must be non-empty and every frame but the last must carry status 0x03; the last frame's
+     * status is returned separately so the caller can apply {@link #mapStatusToError} to it
+     * (FR-INV-03: the read terminates on any status other than 0x03, not a fixed idle timer, so
+     * the terminal status is a real caller-visible signal, not incidental).
+     */
+    public static List<TagRecord> assembleAndDecodeInventory(List<Frame> chain) {
+        if (chain == null || chain.isEmpty()) {
+            throw new IllegalArgumentException("empty frame chain");
+        }
+        int totalDataLen = 0;
+        for (int i = 0; i < chain.size(); i++) {
+            Frame f = chain.get(i);
+            boolean isLast = (i == chain.size() - 1);
+            int status = f.statusByte();
+            if (!isLast && status != STATUS_MORE_FRAMES_FOLLOW) {
+                throw new IllegalArgumentException(
+                        "frame " + i + " of " + chain.size() + " is not last but has status 0x"
+                                + Integer.toHexString(status) + " instead of 0x03");
+            }
+            if (isLast && status == STATUS_MORE_FRAMES_FOLLOW) {
+                throw new IllegalArgumentException(
+                        "last frame in chain still reports 0x03 (more frames follow) — caller "
+                                + "handed over an incomplete chain");
+            }
+            // status byte is not tag data; skip it when concatenating.
+            totalDataLen += f.data.length - 1;
+        }
+        byte[] combined = new byte[totalDataLen];
+        int pos = 0;
+        for (Frame f : chain) {
+            int n = f.data.length - 1;
+            System.arraycopy(f.data, 1, combined, pos, n);
+            pos += n;
+        }
+        return decodeTagRecords(combined);
+    }
+
+    /** Decodes a concatenated tag-record blob (post status-byte-stripping) per FR-INV-10. */
+    public static List<TagRecord> decodeTagRecords(byte[] data) {
+        List<TagRecord> out = new ArrayList<>();
+        int pos = 0;
+        while (pos < data.length) {
+            if (pos + 1 > data.length) {
+                throw new IllegalArgumentException("truncated tag record at offset " + pos);
+            }
+            int lenByte = data[pos] & 0xFF;
+            boolean hasTid = (lenByte & FLAG_EPC_TID_PRESENT) != 0;
+            boolean hasPhaseFreq = (lenByte & FLAG_PHASE_FREQ_PRESENT) != 0;
+            int epcWords = lenByte & LENGTH_MASK;
+            int epcBytes = epcWords * 2;
+            pos += 1;
+            if (pos + epcBytes > data.length) {
+                throw new IllegalArgumentException(
+                        "tag record at offset " + (pos - 1) + " declares " + epcBytes
+                                + " EPC bytes but only " + (data.length - pos) + " remain");
+            }
+            byte[] epc = new byte[epcBytes];
+            System.arraycopy(data, pos, epc, 0, epcBytes);
+            pos += epcBytes;
+
+            byte[] tid = null;
+            if (hasTid) {
+                if (pos + 1 > data.length) {
+                    throw new IllegalArgumentException("truncated TID length at offset " + pos);
+                }
+                int tidWords = data[pos] & 0xFF;
+                int tidBytes = tidWords * 2;
+                pos += 1;
+                if (pos + tidBytes > data.length) {
+                    throw new IllegalArgumentException("truncated TID data at offset " + pos);
+                }
+                tid = new byte[tidBytes];
+                System.arraycopy(data, pos, tid, 0, tidBytes);
+                pos += tidBytes;
+            }
+
+            if (hasPhaseFreq) {
+                // Phase/frequency trailer is documented but not yet needed by any Phase-1
+                // consumer; skip its fixed-size trailer rather than mis-parsing it as RSSI.
+                // Width is Confirm-status pending R1 — tracked alongside OI-01.
+                pos += 3;
+                if (pos > data.length) {
+                    throw new IllegalArgumentException(
+                            "phase/freq trailer runs past end of payload");
+                }
+            }
+
+            if (pos + 1 > data.length) {
+                throw new IllegalArgumentException("truncated RSSI byte at offset " + pos);
+            }
+            int rssi = data[pos] & 0xFF;
+            pos += 1;
+
+            out.add(new TagRecord(epc, tid, rssi));
+        }
+        return out;
+    }
+}
