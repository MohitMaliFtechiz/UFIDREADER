+package com.android.server.uhf;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import com.android.server.uhf.UhfSessionArbiter.StreamRequest;
+import com.android.server.uhf.UhfSessionArbiter.UhfBusyException;
+import com.android.server.uhf.UhfSessionArbiter.UhfSafetyCeilingExceededException;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Host-side, no-hardware unit tests for {@link UhfSessionArbiter}: the state machine behind
+ * session exclusivity (FR-LC-03/04/05/09), the antenna-check interlock (FR-ANT-02), the RF power
+ * ceiling (FR-PWR-03), and the streaming/buffered/tag-op mutual exclusion added in Rev B
+ * (FR-STR-13, FR-BUF-07). {@link FakeTransport} records every call it receives in order, which is
+ * what makes the interlock- and restart-ordering tests meaningful rather than just
+ * state-at-the-end checks.
+ */
+public class UhfSessionArbiterTest {
+
+    private FakeTransport transport;
+    private FakeRegionStore regionStore;
+    private FakeEventLog eventLog;
+    private UhfSessionArbiter arbiter;
+
+    @Before
+    public void setUp() throws Exception {
+        transport = new FakeTransport();
+        regionStore = new FakeRegionStore();
+        eventLog = new FakeEventLog();
+        arbiter = new UhfSessionArbiter(transport, regionStore, eventLog);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-LC-05 / FR-LC-09: startup reset
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void startupReset_forcesRealtimeModeOffUnconditionally() throws Exception {
+        arbiter.performStartupReset();
+        assertTrue(transport.calls.contains("open"));
+        assertTrue("must force out of real-time mode even though we have no idea what mode "
+                        + "the reader booted into",
+                transport.calls.contains("transact(0x76)"));
+    }
+
+    @Test
+    public void startupReset_reappliesPersistedRegionRegardlessOfReaderState() throws Exception {
+        regionStore.persisted = 0b0100; // EU
+        arbiter.performStartupReset();
+        assertTrue(transport.calls.contains("transact(0x22)"));
+        assertEquals(0b0100, transport.lastRegionWritten);
+    }
+
+    @Test
+    public void startupReset_orderIsRealtimeOffThenRegion() throws Exception {
+        arbiter.performStartupReset();
+        int realtimeIdx = transport.calls.indexOf("transact(0x76)");
+        int regionIdx = transport.calls.indexOf("transact(0x22)");
+        assertTrue(realtimeIdx >= 0 && regionIdx >= 0);
+        assertTrue("region should be reasserted after the port is known-idle",
+                realtimeIdx < regionIdx);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-LC-03/04: exclusivity and crash recovery
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void openSession_secondClientIsRejectedWhileFirstHolds() throws Exception {
+        Object clientA = new Object();
+        Object clientB = new Object();
+        arbiter.openSession(clientA);
+        try {
+            arbiter.openSession(clientB);
+            fail("expected UhfBusyException");
+        } catch (UhfBusyException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void openSession_availableAgainAfterGracefulClose() throws Exception {
+        Object clientA = new Object();
+        Object clientB = new Object();
+        arbiter.openSession(clientA);
+        arbiter.closeSession(clientA);
+        arbiter.openSession(clientB); // must not throw
+        assertTrue(arbiter.isHeldBy(clientB));
+    }
+
+    @Test
+    public void onClientDied_releasesSessionAndReturnsReaderToIdle() throws Exception {
+        Object clientA = new Object();
+        arbiter.openSession(clientA);
+        arbiter.startStreaming(clientA, new StreamRequest(4, 0), noopCallback());
+        assertTrue(arbiter.isStreaming(clientA));
+
+        arbiter.onClientDied(clientA); // simulates FR-LC-04's crash path
+
+        assertFalse(arbiter.isSessionOpen());
+        assertTrue("dying mid-stream must still stop the stream",
+                transport.calls.contains("stopStream"));
+        Object clientB = new Object();
+        arbiter.openSession(clientB); // must not still be BUSY
+    }
+
+    @Test
+    public void onClientDied_forAnUnrelatedTokenIsSafelyIgnored() throws Exception {
+        Object holder = new Object();
+        Object bystander = new Object();
+        arbiter.openSession(holder);
+        arbiter.onClientDied(bystander); // must not throw, must not release holder's session
+        assertTrue(arbiter.isHeldBy(holder));
+    }
+
+    @Test
+    public void onClientDied_neverThrowsEvenIfTransportCleanupFails() throws Exception {
+        Object clientA = new Object();
+        arbiter.openSession(clientA);
+        arbiter.startStreaming(clientA, new StreamRequest(4, 0), noopCallback());
+        transport.failStopStream = true;
+
+        arbiter.onClientDied(clientA); // must not throw despite the failing cleanup
+
+        assertFalse(arbiter.isSessionOpen());
+    }
+
+    @Test
+    public void closeSession_byNonHolderIsRejected() throws Exception {
+        Object holder = new Object();
+        Object other = new Object();
+        arbiter.openSession(holder);
+        try {
+            arbiter.closeSession(other);
+            fail("expected rejection: only the holder may close its own session");
+        } catch (IllegalStateException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void anyOperation_withoutAnOpenSessionIsRejected() {
+        Object bystander = new Object();
+        try {
+            arbiter.setRfPower(bystander, 10, false);
+            fail("expected rejection: no session is open at all");
+        } catch (Exception expected) {
+            assertTrue(expected instanceof IllegalStateException);
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-ANT-02: antenna-check interlock ordering
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void setEnabledAntennas_disablesCheckWritesMaskThenReenablesCheck_whenCheckWasOn()
+            throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.setAntennaCheckEnabled(client, true);
+        transport.reset(); // isolate the mask-write sequence from setup noise
+
+        arbiter.setEnabledAntennas(client, 0b0011);
+
+        assertEquals("check-off, write-mask, check-on — exactly three calls, in that order",
+                List.of("transact(0x66)", "transact(0x3f)", "transact(0x66)"), transport.calls);
+        assertEquals(0, transport.lastAntennaCheckValue(0)); // first 0x66 call disabled it
+        assertEquals(1, transport.lastAntennaCheckValue(1)); // second 0x66 call re-enabled it
+    }
+
+    @Test
+    public void setEnabledAntennas_skipsTheInterlockWhenCheckWasAlreadyOff() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        // antennaCheckEnabled defaults to false; no setAntennaCheckEnabled(true) call.
+
+        arbiter.setEnabledAntennas(client, 0b0001);
+
+        assertEquals("no need to toggle a check that was never on",
+                List.of("transact(0x3f)"), transport.calls);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-PWR-02/03: power ceiling
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void setRfPower_atOrBelowSafeCeilingSucceedsWithoutOverride() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.setRfPower(client, UhfSessionArbiter.DEFAULT_SAFE_POWER_CEILING, false);
+        assertEquals(UhfSessionArbiter.DEFAULT_SAFE_POWER_CEILING, arbiter.getRfPower(client));
+    }
+
+    @Test
+    public void setRfPower_aboveCeilingWithoutOverrideIsRejectedBeforeReachingTheReader()
+            throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        transport.reset();
+        try {
+            arbiter.setRfPower(client, UhfSessionArbiter.DEFAULT_SAFE_POWER_CEILING + 1, false);
+            fail("expected UhfSafetyCeilingExceededException");
+        } catch (UhfSafetyCeilingExceededException expected) {
+            assertEquals(UhfSessionArbiter.DEFAULT_SAFE_POWER_CEILING, expected.ceiling);
+            assertEquals(UhfSessionArbiter.DEFAULT_SAFE_POWER_CEILING + 1, expected.requested);
+        }
+        assertTrue("must be rejected in software, never sent to the reader",
+                transport.calls.isEmpty());
+    }
+
+    @Test
+    public void setRfPower_aboveCeilingSucceedsWithExplicitOverride() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.setRfPower(client, 30, true);
+        assertEquals(30, arbiter.getRfPower(client));
+    }
+
+    @Test
+    public void setRfPower_aboveReaderMaximumIsRejectedEvenWithOverride() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        try {
+            arbiter.setRfPower(client, 31, true); // reader max is 30 by default
+            fail("FR-PWR-02: reader hardware max is not overridable by the safety flag");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void setRfPower_negativeIsRejected() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        try {
+            arbiter.setRfPower(client, -1, true);
+            fail("expected rejection of a negative power");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void safePowerCeiling_isConfigurableAndDefaultsCorrectly() {
+        assertEquals(UhfSessionArbiter.DEFAULT_SAFE_POWER_CEILING, arbiter.getSafePowerCeiling());
+        arbiter.setSafePowerCeiling(15);
+        assertEquals(15, arbiter.getSafePowerCeiling());
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-FRQ-04 / FR-LC-09: region changes are persisted and logged
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void setRegion_persistsAndLogsTheChange() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.setRegion(client, 0b0010); // US
+
+        assertEquals(0b0010, regionStore.persisted);
+        assertEquals(1, eventLog.regionChanges.size());
+        assertEquals(0b0010, (int) eventLog.regionChanges.get(0));
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-STR-01/07: basic streaming lifecycle
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void startStreaming_thenStopStreaming_roundTrips() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.startStreaming(client, new StreamRequest(4, 0), noopCallback());
+        assertTrue(arbiter.isStreaming(client));
+
+        arbiter.stopStreaming(client);
+        assertFalse(arbiter.isStreaming(client));
+    }
+
+    @Test
+    public void startStreaming_rejectsASecondStartWhileAlreadyStreaming() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.startStreaming(client, new StreamRequest(4, 0), noopCallback());
+        try {
+            arbiter.startStreaming(client, new StreamRequest(4, 0), noopCallback());
+            fail("expected rejection of a redundant start");
+        } catch (IllegalStateException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void stopStreaming_explicitStopPreventsAnyLaterAutoRestart() throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.startStreaming(client, new StreamRequest(4, 0), noopCallback());
+        arbiter.stopStreaming(client);
+        transport.reset();
+
+        // A subsequent config write must NOT restart a stream the caller explicitly stopped.
+        arbiter.setEnabledAntennas(client, 0b0001);
+
+        assertFalse(arbiter.isStreaming(client));
+        assertFalse(transport.calls.contains("startStream"));
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-STR-13 (Rev B): non-streaming calls stop-apply-restart around an active stream
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void setEnabledAntennas_whileStreaming_stopsAppliesThenRestartsTheStream()
+            throws Exception {
+        Object client = new Object();
+        arbiter.openSession(client);
+        arbiter.startStreaming(client, new StreamRequest(4, 0), noopCallback());
+        transport.reset();
+
+        arbiter.setEnabledAntennas(client, 0b0010);
+
+        assertEquals(List.of("stopStream", "transact(0x3f)", "startStream"), transport.calls);
+        assertTrue("stream must be running again afterward", arbiter.isStreaming(client));
+    }
