+
+package com.android.server.uhf;
+
+/**
+ * Thrown by {@link UhfTransport} for link-level failures: timeout, device-lost, or a reader status
+ * byte that {@link UhfProtocol#mapStatusToError} maps to something other than
+ * {@link UhfProtocol#ERROR_NONE}. Carries the mapped stable error code so callers up the stack
+ * (ultimately {@code UhfException} at the API boundary) don't need to know wire-protocol details.
+ */
+public class UhfTransportException extends Exception {
+    private final int errorCode;
+
+    public UhfTransportException(int errorCode, String message) {
+        super(message);
+        this.errorCode = errorCode;
+    }
+
+    public int getErrorCode() {
+        return errorCode;
+    }
+}
