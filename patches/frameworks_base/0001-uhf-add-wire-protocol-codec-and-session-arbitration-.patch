--- /dev/null
+++ b/services/core/java/com/android/server/uhf/UhfSessionArbiter.java
@@ -0,0 +1,420 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.uhf;
+
+import java.util.concurrent.Callable;
+
+/**
+ * The policy engine behind {@code UhfService}: session exclusivity, the antenna-check interlock,
+ * the RF power ceiling, region persistence, and the mutual-exclusion rules between streaming and
+ * everything else. Every one of those is a requirement in UHF-SRS-001 with a documented hardware
+ * or regulatory reason (FR-LC-03/04/05/09, FR-ANT-02, FR-PWR-03, FR-STR-08/13, FR-BUF-07,
+ * NFR-C-01) — this class is where they are actually enforced, deliberately kept independent of
+ * Binder, permissions, and AIDL so it can be unit tested without a framework build (see
+ * {@code UhfSessionArbiterTest}).
+ *
+ * <p>"Client" is an opaque {@code Object} token here rather than an {@code IBinder}; the real
+ * {@code UhfService} passes the caller's actual {@code IBinder} session token and wires
+ * {@link #onClientDied} to an {@code IBinder.DeathRecipient} callback. Nothing in this class
+ * depends on that being a real Binder object, which is exactly what makes it testable with a
+ * plain {@code new Object()} standing in for a client process.
+ *
+ * <p>All public methods are synchronized: NFR-C-01 requires every reader transaction to be
+ * serialized onto one logical thread, and the simplest way to guarantee that from the policy
+ * layer is to hold the arbiter's own lock for the duration of each operation, including the
+ * transport call it makes. A slow transport therefore serializes callers too, by design — that is
+ * the "reader accepts one command per cycle" constraint made visible instead of hidden behind a
+ * queue that could reorder things.
+ */
+public final class UhfSessionArbiter {
+
+    // Command bytes this class issues directly. Frame building/parsing is UhfProtocol's job; this
+    // class only decides *which* commands to send and in *what order* — the policy, not the wire
+    // format.
+    private static final int CMD_REALTIME_MODE = 0x76;
+    private static final int CMD_ANTENNA_MASK = 0x3F;
+    private static final int CMD_ANTENNA_CHECK = 0x66;
+    private static final int CMD_RF_POWER = 0x2F;
+    private static final int CMD_REGION = 0x22;
+    private static final int CMD_BUFFERED_START = 0x18; // FR-BUF-01, status Confirm pending OI-01
+    private static final int CMD_BUFFERED_STOP = 0x1A;  // FR-BUF-04, status Confirm pending OI-01
+
+    private static final int DEFAULT_TIMEOUT_MS = 500;
+
+    /** FR-PWR-03: default safe ceiling; exceeding it requires the caller's explicit override. */
+    public static final int DEFAULT_SAFE_POWER_CEILING = 20;
+
+    private enum ReaderMode { IDLE, STREAMING, BUFFERED }
+
+    /** Persisted region state, independent of reader readback — see FR-LC-09. */
+    public interface RegionStore {
+        int getPersistedRegionCode();
+        void setPersistedRegionCode(int bandCode);
+    }
+
+    private final UhfTransport transport;
+    private final RegionStore regionStore;
+    private final EventLog eventLog;
+
+    /** Structured audit sink for the log-worthy events (FR-FRQ-04, FR-SEC-07). */
+    public interface EventLog {
+        void onRegionChanged(Object clientToken, int newBandCode);
+    }
+
+    private Object holder; // null = no session held
+    private ReaderMode mode = ReaderMode.IDLE;
+    private int antennaMask;
+    private int rfPower;
+    private boolean antennaCheckEnabled;
+    private int safePowerCeiling = DEFAULT_SAFE_POWER_CEILING;
+    private int maxRfPowerFromReader = 30; // FR-PWR-02 ceiling; refreshed by identify() in practice
+    private StreamRequest lastStreamRequest; // for FR-STR-13's auto-restart
+
+    /** Minimal description of an active stream, enough to restart it after a forced stop. */
+    public static final class StreamRequest {
+        public final int qValue;
+        public final int session;
+
+        public StreamRequest(int qValue, int session) {
+            this.qValue = qValue;
+            this.session = session;
+        }
+    }
+
+    public UhfSessionArbiter(UhfTransport transport, RegionStore regionStore, EventLog eventLog) {
+        this.transport = transport;
+        this.regionStore = regionStore;
+        this.eventLog = eventLog;
+    }
+
+    /**
+     * FR-LC-05 and FR-LC-09, run once at construction time (i.e. at service start / after any HAL
+     * restart): force the reader out of real-time mode regardless of what it booted into, and
+     * re-apply the persisted region rather than trusting whatever the reader currently reports.
+     * Must be called before the first {@link #openSession} succeeds.
+     */
+    public synchronized void performStartupReset() throws UhfTransportException {
+        transport.open();
+        // FR-LC-05: unconditional — do not check current mode first, because a device that was
+        // streaming when powered off answers this exact query with more streamed tag frames, not
+        // a clean answer. Force the transition every time.
+        transport.transact(CMD_REALTIME_MODE, new byte[] {0x00}, DEFAULT_TIMEOUT_MS);
+        mode = ReaderMode.IDLE;
+
+        // FR-LC-09: region is reasserted from platform storage, not read back and trusted. If the
+        // HAL just restarted after a crash mid-session, the reader's own idea of its region might
+        // still be correct — or might not be, and there is no way to tell the difference from here
+        // without an unlogged guess. Always write it.
+        int persisted = regionStore.getPersistedRegionCode();
+        transport.transact(CMD_REGION, new byte[] {(byte) persisted}, DEFAULT_TIMEOUT_MS);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-LC-03/04: exclusive sessions
+    // ---------------------------------------------------------------------------------------
+
+    public synchronized void openSession(Object clientToken) throws UhfBusyException {
+        if (clientToken == null) {
+            throw new NullPointerException("clientToken");
+        }
+        if (holder != null) {
+            throw new UhfBusyException();
+        }
+        holder = clientToken;
+    }
+
+    /** Graceful close, called by the client itself. */
+    public synchronized void closeSession(Object clientToken) {
+        requireHolder(clientToken);
+        releaseInternal();
+    }
+
+    /**
+     * FR-LC-04: the involuntary path, driven by the client process's Binder death. Unlike
+     * {@link #closeSession} this must never throw — a dying client is exactly the moment nothing
+     * can be assumed about its future behaviour, and a policy that throws here would leave the
+     * arbiter permanently wedged with a holder that will never call {@code closeSession}.
+     */
+    public synchronized void onClientDied(Object clientToken) {
+        if (holder == clientToken) {
+            releaseInternal();
+        }
+    }
+
+    private void releaseInternal() {
+        if (mode != ReaderMode.IDLE) {
+            stopActiveModeBestEffort();
+        }
+        holder = null;
+        lastStreamRequest = null;
+        activeStreamCallback = null;
+        streamSuspendedForBuffered = false;
+        suspendedStreamRequest = null;
+        suspendedStreamCallback = null;
+    }
+
+    private void stopActiveModeBestEffort() {
+        try {
+            if (mode == ReaderMode.STREAMING) {
+                transport.stopStream();
+            } else if (mode == ReaderMode.BUFFERED) {
+                transport.transact(CMD_BUFFERED_STOP, new byte[0], DEFAULT_TIMEOUT_MS);
+            }
+        } catch (UhfTransportException e) {
+            // Best-effort: releasing a session (especially on client death) must not throw. The
+            // reader may be left in a stale mode; performStartupReset() on the next boot/restart
+            // is the backstop, and a live service would log this rather than swallow it silently.
+        } finally {
+            mode = ReaderMode.IDLE;
+        }
+    }
+
+    public synchronized boolean isHeldBy(Object clientToken) {
+        return holder == clientToken;
+    }
+
+    public synchronized boolean isSessionOpen() {
+        return holder != null;
+    }
+
+    private void requireHolder(Object clientToken) {
+        if (holder != clientToken) {
+            throw new IllegalStateException("caller does not hold the session");
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-ANT-01/02: antenna mask, with the undocumented check-off/write/check-on interlock
+    // ---------------------------------------------------------------------------------------
+
+    public synchronized void setEnabledAntennas(Object clientToken, int mask)
+            throws UhfTransportException {
+        requireHolder(clientToken);
+        runExclusiveOfActiveMode(() -> {
+            boolean checkWasOn = antennaCheckEnabled;
+            // FR-ANT-02: 0x3F is rejected with 0xF9 while the check is on. Order matters and is
+            // not optional: off, write, back on — never write with the check still enabled.
+            if (checkWasOn) {
+                transport.transact(CMD_ANTENNA_CHECK, new byte[] {0x00}, DEFAULT_TIMEOUT_MS);
+            }
+            transport.transact(CMD_ANTENNA_MASK, new byte[] {(byte) mask}, DEFAULT_TIMEOUT_MS);
+            if (checkWasOn) {
+                transport.transact(CMD_ANTENNA_CHECK, new byte[] {0x01}, DEFAULT_TIMEOUT_MS);
+            }
+            antennaMask = mask;
+            return null;
+        });
+    }
+
+    public synchronized int getEnabledAntennas(Object clientToken) {
+        requireHolder(clientToken);
+        return antennaMask;
+    }
+
+    public synchronized void setAntennaCheckEnabled(Object clientToken, boolean enabled)
+            throws UhfTransportException {
+        requireHolder(clientToken);
+        transport.transact(CMD_ANTENNA_CHECK, new byte[] {(byte) (enabled ? 1 : 0)},
+                DEFAULT_TIMEOUT_MS);
+        antennaCheckEnabled = enabled;
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-PWR-01..03: RF power with the enforced safe ceiling
+    // ---------------------------------------------------------------------------------------
+
+    public synchronized void setRfPower(Object clientToken, int power, boolean allowAboveSafeCeiling)
+            throws UhfTransportException {
+        requireHolder(clientToken);
+        if (power < 0 || power > maxRfPowerFromReader) {
+            // FR-PWR-02: reject before it ever reaches the reader.
+            throw new IllegalArgumentException(
+                    "power " + power + " outside [0," + maxRfPowerFromReader + "]");
+        }
+        if (power > safePowerCeiling && !allowAboveSafeCeiling) {
+            // FR-PWR-03: the brownout-at-30/30 failure mode presents as "reader works, sees no
+            // tags" with no error anywhere — this exception is the only place that failure mode
+            // is prevented rather than merely documented.
+            throw new UhfSafetyCeilingExceededException(safePowerCeiling, power);
+        }
+        transport.transact(CMD_RF_POWER, new byte[] {(byte) power}, DEFAULT_TIMEOUT_MS);
+        rfPower = power;
+    }
+
+    public synchronized int getRfPower(Object clientToken) {
+        requireHolder(clientToken);
+        return rfPower;
+    }
+
+    public synchronized void setSafePowerCeiling(int ceiling) {
+        this.safePowerCeiling = ceiling;
+    }
+
+    public synchronized int getSafePowerCeiling() {
+        return safePowerCeiling;
+    }
+
+    void setMaxRfPowerFromReaderForTest(int max) { // test-only seam; identify() sets this in prod
+        this.maxRfPowerFromReader = max;
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-FRQ-04 / FR-LC-09: region, persisted independent of the general restore mechanism
+    // ---------------------------------------------------------------------------------------
+
+    public synchronized void setRegion(Object clientToken, int bandCode)
+            throws UhfTransportException {
+        requireHolder(clientToken);
+        transport.transact(CMD_REGION, new byte[] {(byte) bandCode}, DEFAULT_TIMEOUT_MS);
+        regionStore.setPersistedRegionCode(bandCode);
+        eventLog.onRegionChanged(clientToken, bandCode); // FR-FRQ-04: every deliberate change logged
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // FR-STR-01/07/08/13, FR-BUF-01/04/07: streaming and buffered inventory, mutually exclusive
+    // with each other and with everything else, per NFR-C-01 (one command per cycle).
+    // ---------------------------------------------------------------------------------------
+
+    public synchronized void startStreaming(Object clientToken, StreamRequest request,
+            UhfTransport.StreamCallback callback) throws UhfTransportException {
+        requireHolder(clientToken);
+        if (mode != ReaderMode.IDLE) {
+            throw new IllegalStateException("reader is already " + mode + "; stop it first");
+        }
+        transport.startStream(callback);
+        mode = ReaderMode.STREAMING;
+        lastStreamRequest = request;
+        activeStreamCallback = callback;
+    }
+
+    /** Explicit stop by the caller: FR-STR-13's auto-restart does not apply afterward. */
+    public synchronized void stopStreaming(Object clientToken) {
+        requireHolder(clientToken);
+        if (mode == ReaderMode.STREAMING) {
+            transport.stopStream();
+            mode = ReaderMode.IDLE;
+        }
+        lastStreamRequest = null; // an explicit stop cancels any pending auto-restart intent
+    }
+
+    public synchronized boolean isStreaming(Object clientToken) {
+        requireHolder(clientToken);
+        return mode == ReaderMode.STREAMING;
+    }
+
+    // Bookkeeping for the buffered-inventory span specifically: unlike the momentary suspension
+    // in runExclusiveOfActiveMode (stop, do one thing, restart immediately), a stream interrupted
+    // by FR-BUF-07 must stay stopped for the *entire* buffered session and only come back when
+    // the caller ends it with stopBufferedInventory — potentially many calls later.
+    private boolean streamSuspendedForBuffered;
+    private StreamRequest suspendedStreamRequest;
+    private UhfTransport.StreamCallback suspendedStreamCallback;
+
+    public synchronized void startBufferedInventory(Object clientToken)
+            throws UhfTransportException {
+        requireHolder(clientToken);
+        if (mode == ReaderMode.STREAMING) {
+            transport.stopStream();
+            streamSuspendedForBuffered = true;
+            suspendedStreamRequest = lastStreamRequest;
+            suspendedStreamCallback = activeStreamCallback;
+        }
+        transport.transact(CMD_BUFFERED_START, new byte[0], DEFAULT_TIMEOUT_MS);
+        mode = ReaderMode.BUFFERED;
+    }
+
+    public synchronized void stopBufferedInventory(Object clientToken)
+            throws UhfTransportException {
+        requireHolder(clientToken);
+        if (mode != ReaderMode.BUFFERED) {
+            return;
+        }
+        transport.transact(CMD_BUFFERED_STOP, new byte[0], DEFAULT_TIMEOUT_MS);
+        mode = ReaderMode.IDLE;
+        if (streamSuspendedForBuffered) {
+            streamSuspendedForBuffered = false;
+            transport.startStream(suspendedStreamCallback);
+            mode = ReaderMode.STREAMING;
+            lastStreamRequest = suspendedStreamRequest;
+            activeStreamCallback = suspendedStreamCallback;
+        }
+    }
+
+    /**
+     * FR-STR-13: runs {@code op} with any active stream stopped first, and restarts it
+     * immediately afterward with its original parameters if — and only if — the caller had not
+     * explicitly stopped it. This is for momentary operations (a configuration write, a tag
+     * memory access) that complete within this one call; buffered inventory's suspension spans
+     * multiple calls and is handled by {@link #startBufferedInventory}/{@link
+     * #stopBufferedInventory} directly instead of through here.
+     */
+    private <T> T runExclusiveOfActiveMode(Callable<T> op) throws UhfTransportException {
+        boolean wasStreaming = (mode == ReaderMode.STREAMING);
+        StreamRequest saved = lastStreamRequest;
+        UhfTransport.StreamCallback savedCallback = wasStreaming ? activeStreamCallback : null;
+        if (wasStreaming) {
+            transport.stopStream();
+            mode = ReaderMode.IDLE;
+        }
+        boolean restarted = false;
+        try {
+            T result = op.call();
+            return result;
+        } catch (UhfTransportException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        } finally {
+            if (wasStreaming && mode == ReaderMode.IDLE) {
+                try {
+                    transport.startStream(savedCallback);
+                    mode = ReaderMode.STREAMING;
+                    lastStreamRequest = saved;
+                    restarted = true;
+                } catch (UhfTransportException e) {
+                    // The original op's own exception (if any) already propagated; a failed
+                    // auto-restart surfaces as the stream simply being stopped, which is
+                    // observable via isStreaming() and is a service responsibility to surface
+                    // as onStreamError, not this method's to hide behind a swallowed exception.
+                }
+            }
+        }
+    }
+
+    // Tracked so runExclusiveOfActiveMode can restart with the same sink. Set by startStreaming.
+    private UhfTransport.StreamCallback activeStreamCallback;
+
+    // ---------------------------------------------------------------------------------------
+    // Exceptions
+    // ---------------------------------------------------------------------------------------
+
+    /** FR-LC-03: another client already holds the session (API error {@code ERROR_BUSY}). */
+    public static final class UhfBusyException extends Exception {}
+
+    /** FR-PWR-03: the requested power exceeds the safe ceiling without an explicit override. */
+    public static final class UhfSafetyCeilingExceededException extends RuntimeException {
+        public final int ceiling;
+        public final int requested;
+
+        UhfSafetyCeilingExceededException(int ceiling, int requested) {
+            super("requested power " + requested + " exceeds safe ceiling " + ceiling
+                    + "; pass allowAboveSafeCeiling=true to override");
+            this.ceiling = ceiling;
+            this.requested = requested;
+        }
+    }
+}
