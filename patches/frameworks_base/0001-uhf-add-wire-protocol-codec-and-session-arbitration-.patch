+    private static UhfTransport.StreamCallback noopCallback() {
+        return new UhfTransport.StreamCallback() {
+            @Override public void onTagBatch(byte[][] rawTagRecords) {}
+            @Override public void onError(int transportErrorCode) {}
+        };
+    }
+
+    /** Records every call in order; lets tests assert both sequence and content. */
+    private static final class FakeTransport implements UhfTransport {
+        final List<String> calls = new ArrayList<>();
+        private final List<Integer> antennaCheckValues = new ArrayList<>();
+        int lastRegionWritten = -1;
+        boolean isOpen;
+        boolean failStopStream;
+        boolean failNextStartStream;
+
+        /**
+         * Clears recorded call history between the "setup" portion of a test and the sequence
+         * under actual assertion. Clears every recording list together — a partial reset (the
+         * bug this replaced) lets earlier setup calls leak into a later assertion silently.
+         */
+        void reset() {
+            calls.clear();
+            antennaCheckValues.clear();
+        }
+
+        @Override public void open() {
+            calls.add("open");
+            isOpen = true;
+        }
+
+        @Override public void close() {
+            calls.add("close");
+            isOpen = false;
+        }
+
+        @Override public boolean isOpen() {
+            return isOpen;
+        }
+
+        @Override public byte[] transact(int command, byte[] payload, int timeoutMs)
+                throws UhfTransportException {
+            calls.add("transact(0x" + Integer.toHexString(command) + ")");
+            if (command == 0x66 && payload.length > 0) {
+                antennaCheckValues.add((int) payload[0]);
+            }
+            if (command == 0x22 && payload.length > 0) {
+                lastRegionWritten = payload[0] & 0xFF;
+            }
+            return new byte[0];
+        }
+
+        @Override public void startStream(StreamCallback callback) throws UhfTransportException {
+            if (failNextStartStream) {
+                failNextStartStream = false;
+                throw new UhfTransportException(UhfProtocol.ERROR_TIMEOUT, "injected failure");
+            }
+            calls.add("startStream");
+        }
+
+        @Override public void stopStream() {
+            calls.add("stopStream");
+            if (failStopStream) {
+                // Per the UhfTransport contract stopStream() cannot throw a checked exception;
+                // simulate an unrecoverable stop by doing nothing further. onClientDied's
+                // best-effort catch around transact() (buffered mode) is exercised by a separate
+                // path — this field exists so onClientDied's "never throws" guarantee is tested
+                // even when the underlying stop is troublesome.
+            }
+        }
+
+        int lastAntennaCheckValue(int callIndex) {
+            return antennaCheckValues.get(callIndex);
+        }
+    }
