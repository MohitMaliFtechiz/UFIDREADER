+
+package com.android.server.uhf;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import com.android.server.uhf.UhfProtocol.BandPlan;
+import com.android.server.uhf.UhfProtocol.Frame;
+import com.android.server.uhf.UhfProtocol.ReaderInfo;
+import com.android.server.uhf.UhfProtocol.ScanOutcome;
+import com.android.server.uhf.UhfProtocol.ScanResult;
+import com.android.server.uhf.UhfProtocol.TagRecord;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Random;
+
+/**
+ * Host-side, no-hardware unit tests for {@link UhfProtocol}. This file implements UHF-SRS-001
+ * &sect;9.1 TST-U-01 through TST-U-08 directly (each test method says which one it is), plus
+ * additional edge cases the SRS's own "measured, a mistake worth not repeating" notes call out as
+ * traps: the reCmd-vs-CRC distinction (FR-LNK-06), the Version-is-two-bytes offset bug
+ * (FR-INF-02), and the requirement that a random byte stream never throws (NFR-R-05).
+ *
+ * <p>No real captured frames from R3 exist yet (SRS &sect;1.4: R1/R3 were not on disk when this
+ * was written). Fixtures below are synthetic but protocol-correct: built with
+ * {@link UhfProtocol#buildFrame} and hand-verified band/version math, so a wrong CRC assumption
+ * or a wrong offset shows up as a test failure against the *specification*, even before a real
+ * capture is available to test against the *hardware*. TST-U-02 and TST-U-03 as literally written
+ * in the SRS ("byte-for-byte match against captured command bytes") cannot be satisfied without
+ * R3; the versions here assert everything that is checkable without it and are marked so no one
+ * mistakes a passing synthetic-fixture test for hardware verification.
+ */
+public class UhfProtocolTest {
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-01: CRC16 over every captured frame in R3 — result is 0 for each complete frame.
+    // R3 isn't available; this instead proves the CRC round-trips through build+validate for a
+    // wide sweep of address/command/payload combinations, including the boundary cases that would
+    // expose an off-by-one in which bytes get included in the check.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void crc16_isZeroOverFrameIncludingItsOwnCrcBytes() {
+        int[] addresses = {0x00, 0x01, 0x7F, UhfProtocol.ADDRESS_BROADCAST};
+        int[] commands = {0x00, 0x01, 0x21, 0x76, 0xFF};
+        int[] payloadLens = {0, 1, 2, 17, 64, 250}; // 250 keeps total frame <= 255 (Len is 1 byte)
+
+        for (int addr : addresses) {
+            for (int cmd : commands) {
+                for (int payloadLen : payloadLens) {
+                    byte[] payload = new byte[payloadLen];
+                    new Random(addr * 31 + cmd * 17 + payloadLen).nextBytes(payload);
+                    byte[] frame = UhfProtocol.buildFrame(addr, cmd, payload);
+                    assertTrue("addr=" + addr + " cmd=" + cmd + " payloadLen=" + payloadLen,
+                            UhfProtocol.isCrcValid(frame, 0, frame.length));
+                    assertEquals(0, UhfProtocol.crc16(frame, 0, frame.length));
+                }
+            }
+        }
+    }
+
+    @Test
+    public void crc16_flippingAnyByteInvalidatesTheFrame() {
+        byte[] frame = UhfProtocol.buildFrame(0xFF, 0x21, new byte[] {1, 2, 3, 4, 5});
+        for (int i = 0; i < frame.length; i++) {
+            byte[] corrupted = frame.clone();
+            corrupted[i] = (byte) (corrupted[i] ^ 0xFF);
+            assertFalse("corrupting byte " + i + " must invalidate CRC",
+                    UhfProtocol.isCrcValid(corrupted, 0, corrupted.length));
+        }
+    }
+
+    @Test
+    public void crc16_isDeterministicAndOrderSensitive() {
+        byte[] a = {0x05, (byte) 0xFF, 0x21, 0x01, 0x02};
+        byte[] b = {0x05, (byte) 0xFF, 0x21, 0x02, 0x01}; // same bytes, different order
+        assertEquals(UhfProtocol.crc16(a, 0, a.length), UhfProtocol.crc16(a, 0, a.length));
+        assertTrue(UhfProtocol.crc16(a, 0, a.length) != UhfProtocol.crc16(b, 0, b.length));
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-02: frame builder against captured command bytes — byte-for-byte match including
+    // CRC order. No R3 capture available; this instead pins the *structure* byte-for-byte
+    // against the SRS's own frame definition, which is the part not gated on hardware access.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void buildFrame_structureMatchesSpecifiedLayout() {
+        byte[] payload = {0x11, 0x22, 0x33};
+        byte[] frame = UhfProtocol.buildFrame(0xFF, 0x21, payload);
+
+        // Len | Adr | Cmd | Data[] | CRC16-LSB | CRC16-MSB
+        assertEquals("Len = Adr+Cmd+Data+CRC(2)", 2 + payload.length + 2, frame[0] & 0xFF);
+        assertEquals(0xFF, frame[1] & 0xFF); // Adr
+        assertEquals(0x21, frame[2] & 0xFF); // Cmd
+        assertArrayEquals(payload, Arrays.copyOfRange(frame, 3, 3 + payload.length));
+        assertEquals("total wire length is Len+1", (frame[0] & 0xFF) + 1, frame.length);
+
+        int crc = UhfProtocol.crc16(frame, 0, frame.length - 2);
+        assertEquals("CRC16-LSB first", crc & 0xFF, frame[frame.length - 2] & 0xFF);
+        assertEquals("CRC16-MSB second", (crc >>> 8) & 0xFF, frame[frame.length - 1] & 0xFF);
+    }
+
+    @Test
+    public void buildFrame_emptyPayloadProducesMinimumLenField() {
+        byte[] frame = UhfProtocol.buildFrame(0x01, 0x76, new byte[0]);
+        assertEquals(UhfProtocol.MIN_LEN_FIELD, frame[0] & 0xFF);
+    }
+
+    @Test
+    public void buildFrame_rejectsPayloadThatWouldOverflowTheLenByte() {
+        // Len must fit one byte (max 0xFF); Adr+Cmd+CRC already cost 4, so payload > 251 overflows.
+        byte[] tooLong = new byte[UhfProtocol.MAX_LEN_FIELD - 4 + 1];
+        try {
+            UhfProtocol.buildFrame(0xFF, 0x01, tooLong);
+            fail("expected rejection of an over-length payload");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-03: 0x21 decode of the captured 18-byte response — passes when it yields v1.24, EU
+    // band, 865.1-867.9 MHz, power 30, ports 1+2. No captured 18-byte payload is available (R3),
+    // so this builds a synthetic payload whose fields are chosen to reproduce exactly those
+    // documented values, and additionally proves FR-INF-02 (Version is 2 bytes, not 1) by showing
+    // a naive 1-byte-Version decode produces a *different, still-plausible* wrong answer — which
+    // is exactly the failure mode the SRS warns is easy to miss.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void decodeReaderInfo_matchesDocumentedExampleValues() {
+        // FR-INF-03: bandCode = (dmaxfre>>6)<<2 | (dminfre>>6). EU band code is 0b0100 = 4.
+        // Any dmaxfre/dminfre pair whose top two bits are 0b01 (dmaxfre) and 0b00 (dminfre)
+        // reproduces it; the actual MHz value is a separate reader field this decode does not
+        // derive (that's §4.4's job, exercised by bandPlan tests below).
+        int dmaxfre = 0b01_000000; // top 2 bits -> band nibble high half = 01
+        int dminfre = 0b00_000000; // top 2 bits -> band nibble low half  = 00
+        byte[] payload = {
+            1, 24,              // Version: major=1, minor=24  -> "1.24"
+            0x07,               // model type (arbitrary, not asserted below)
+            0x01,               // protocol support: bit0 set -> 6C supported, 6B not
+            (byte) dmaxfre,
+            (byte) dminfre,
+            30,                 // Power
+            10,                 // ScanTime (10 * 100ms = 1000ms; not asserted here)
+            0b0011,             // antenna mask: ports 1+2 enabled
+            0x01,               // antenna check enabled
+        };
+
+        ReaderInfo info = UhfProtocol.decodeReaderInfo(payload);
+
+        assertEquals("1.24", info.firmwareVersionString());
+        assertEquals(0b0100, info.bandCode);
+        assertEquals(30, info.maxRfPower);
+        assertEquals(0b0011, info.antennaMask);
+        assertTrue(info.supportsIso18000_6c);
+        assertFalse(info.supportsIso18000_6b);
+        assertTrue(info.antennaCheckEnabled);
+
+        BandPlan eu = UhfProtocol.bandPlanForCode(info.bandCode);
+        assertEquals("EU", eu.name);
+        assertEquals(865.1, eu.centerFrequencyMhz(0), 1e-9);
+        assertEquals(867.9, eu.centerFrequencyMhz(14), 1e-9); // 865.1 + 14*0.2 = 867.9
+    }
+
+    @Test
+    public void decodeReaderInfo_versionMustBeTwoBytesNotOne() {
+        // This is FR-INF-02's regression test by construction: treating Version as one byte
+        // shifts every subsequent field left by one position. We build a payload correct under
+        // the two-byte reading and show that mis-decoding it as one-byte-Version yields a
+        // *different* band code — i.e. the bug is silent, not a crash, exactly as the SRS warns.
+        byte[] payload = {
+            1, 24, 0x07, 0x01,
+            (byte) 0b01_000000, (byte) 0b00_000000, // dmaxfre/dminfre -> EU (0b0100) when correct
+            30, 10, 0b0011, 0x01,
+        };
+        ReaderInfo correct = UhfProtocol.decodeReaderInfo(payload);
+        assertEquals(0b0100, correct.bandCode); // EU, as intended
+
+        // Simulate the one-byte-Version bug: everything shifts left by one, so "dmaxfre" is read
+        // from where "dminfre" actually is, etc. This must NOT equal the correct band code.
+        byte[] shiftedAsIfOneByteVersion = Arrays.copyOfRange(payload, 1, payload.length);
+        // Pad back to the minimum decodable length so the decode doesn't fail on length alone —
+        // the point is that it succeeds and is wrong, not that it throws.
+        byte[] padded = Arrays.copyOf(shiftedAsIfOneByteVersion, 10);
+        ReaderInfo buggy = UhfProtocol.decodeReaderInfo(padded);
+        assertTrue("a 1-byte-Version bug must not coincidentally decode the same band",
+                buggy.bandCode != correct.bandCode);
+    }
+
+    @Test
+    public void decodeReaderInfo_rejectsTruncatedPayloadInsteadOfGuessing() {
+        try {
+            UhfProtocol.decodeReaderInfo(new byte[] {1, 24, 0x07}); // way too short
+            fail("expected rejection of a truncated 0x21 payload");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void decodeReaderInfo_rejectsNullPayload() {
+        try {
+            UhfProtocol.decodeReaderInfo(null);
+            fail("expected rejection of a null payload");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-04: multi-frame inventory assembly with status 0x03 — all seven tags returned, none
+    // dropped.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void assembleAndDecodeInventory_sevenTagsAcrossThreeFrames_noneDropped() {
+        List<TagRecord> want = new ArrayList<>();
+        List<byte[]> tagBlobs = new ArrayList<>();
+        for (int i = 0; i < 7; i++) {
+            byte[] epc = {(byte) 0xE2, (byte) i, 0x00, 0x01};
+            int rssi = 100 + i;
+            tagBlobs.add(encodeOneTagNoTidNoPhase(epc, rssi));
+        }
+        // Split the seven encoded tags across three frames arbitrarily: 3 + 2 + 2.
+        List<Frame> chain = Arrays.asList(
+                statusFrame(UhfProtocol.STATUS_MORE_FRAMES_FOLLOW, concat(tagBlobs.subList(0, 3))),
+                statusFrame(UhfProtocol.STATUS_MORE_FRAMES_FOLLOW, concat(tagBlobs.subList(3, 5))),
+                statusFrame(UhfProtocol.STATUS_INVENTORY_COMPLETE, concat(tagBlobs.subList(5, 7))));
+
+        List<TagRecord> got = UhfProtocol.assembleAndDecodeInventory(chain);
+
+        assertEquals(7, got.size());
+        for (int i = 0; i < 7; i++) {
+            assertArrayEquals("tag " + i, new byte[] {(byte) 0xE2, (byte) i, 0x00, 0x01},
+                    got.get(i).epc);
+            assertEquals("tag " + i, 100 + i, got.get(i).rssi);
+        }
+    }
+
+    @Test
+    public void assembleAndDecodeInventory_singleFrameNoContinuation() {
+        byte[] blob = encodeOneTagNoTidNoPhase(new byte[] {1, 2, 3, 4}, 77);
+        List<Frame> chain = Arrays.asList(statusFrame(UhfProtocol.STATUS_INVENTORY_COMPLETE, blob));
+        List<TagRecord> got = UhfProtocol.assembleAndDecodeInventory(chain);
+        assertEquals(1, got.size());
+        assertEquals(77, got.get(0).rssi);
+    }
+
+    @Test
+    public void assembleAndDecodeInventory_rejectsChainWhereNonLastFrameLacksContinuationStatus() {
+        List<Frame> chain = Arrays.asList(
+                statusFrame(UhfProtocol.STATUS_INVENTORY_COMPLETE, new byte[0]), // wrong: not last
+                statusFrame(UhfProtocol.STATUS_INVENTORY_COMPLETE, new byte[0]));
+        try {
+            UhfProtocol.assembleAndDecodeInventory(chain);
+            fail("expected rejection: only the last frame may end the 0x03 chain");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void assembleAndDecodeInventory_rejectsIncompleteChainStillMarkedContinuing() {
+        List<Frame> chain = Arrays.asList(
+                statusFrame(UhfProtocol.STATUS_MORE_FRAMES_FOLLOW, new byte[0]));
+        try {
+            UhfProtocol.assembleAndDecodeInventory(chain);
+            fail("expected rejection: caller handed over a chain that isn't actually complete");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void assembleAndDecodeInventory_rejectsEmptyChain() {
+        try {
+            UhfProtocol.assembleAndDecodeInventory(new ArrayList<Frame>());
+            fail("expected rejection of an empty chain");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void decodeTagRecords_decodesEpcPlusTidWhenFlagSet() {
+        byte[] epc = {1, 2, 3, 4};
+        byte[] tid = {9, 8};
+        byte[] record = new byte[1 + epc.length + 1 + tid.length + 1];
+        int p = 0;
+        record[p++] = (byte) (0x80 | (epc.length / 2)); // bit7 set: EPC+TID present
+        System.arraycopy(epc, 0, record, p, epc.length);
+        p += epc.length;
+        record[p++] = (byte) (tid.length / 2);
+        System.arraycopy(tid, 0, record, p, tid.length);
+        p += tid.length;
+        record[p] = (byte) 55; // rssi
+
+        List<TagRecord> got = UhfProtocol.decodeTagRecords(record);
+        assertEquals(1, got.size());
+        assertArrayEquals(epc, got.get(0).epc);
+        assertArrayEquals(tid, got.get(0).tid);
+        assertEquals(55, got.get(0).rssi);
+    }
+
+    @Test
+    public void decodeTagRecords_zeroLengthEpcIsNotAnInfiniteLoopOrCrash() {
+        // Length byte says "0 EPC words", no TID/phase flags, just an RSSI byte after.
+        byte[] record = {0x00, (byte) 33};
+        List<TagRecord> got = UhfProtocol.decodeTagRecords(record);
+        assertEquals(1, got.size());
+        assertEquals(0, got.get(0).epc.length);
+        assertEquals(33, got.get(0).rssi);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-05: parser fed 1 MB of random bytes — no exception, no unbounded buffer growth.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void scan_oneMegabyteOfRandomBytes_neverThrowsAndAlwaysMakesProgress() {
+        Random rnd = new Random(42);
+        byte[] buf = new byte[1024 * 1024];
+        rnd.nextBytes(buf);
+
+        int offset = 0;
+        int iterations = 0;
+        int maxIterations = buf.length + 10; // generous: each iteration consumes >=1 byte
+        while (offset < buf.length) {
+            iterations++;
+            if (iterations > maxIterations) {
+                fail("scan() made no progress — possible infinite loop over random input");
+            }
+            ScanResult r = UhfProtocol.scan(buf, offset, buf.length - offset);
+            switch (r.outcome) {
+                case FRAME:
+                    assertTrue(r.frame.wireLength >= 1 + UhfProtocol.MIN_LEN_FIELD);
+                    offset += r.frame.wireLength;
+                    break;
+                case RESYNC:
+                    assertTrue("resync must discard at least one byte", r.bytesToDiscard >= 1);
+                    offset += r.bytesToDiscard;
+                    break;
+                case NEED_MORE_DATA:
+                    offset = buf.length; // end of available input; stop
+                    break;
+            }
+        }
+        // Reaching here without throwing and without exceeding maxIterations is the assertion.
+    }
+
+    @Test
+    public void scan_allZeroBuffer_resyncsByteByByteWithoutHanging() {
+        byte[] buf = new byte[500]; // all zero; 0x00 < MIN_LEN_FIELD everywhere
+        int offset = 0;
+        int discardedTotal = 0;
+        while (offset < buf.length) {
+            ScanResult r = UhfProtocol.scan(buf, offset, buf.length - offset);
+            assertEquals(ScanOutcome.RESYNC, r.outcome);
+            assertEquals(1, r.bytesToDiscard);
+            offset += r.bytesToDiscard;
+            discardedTotal += r.bytesToDiscard;
+        }
+        assertEquals(buf.length, discardedTotal);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-06: resync past leading bytes below 4 — next valid frame is recovered.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void scan_recoversValidFrameAfterGarbageBelowMinLen() {
+        byte[] garbage = {0x00, 0x01, 0x02, 0x03}; // all < MIN_LEN_FIELD (4)
+        byte[] validFrame = UhfProtocol.buildFrame(0xFF, 0x21, new byte[] {9, 9});
+        byte[] buf = concatArrays(garbage, validFrame);
+
+        int offset = 0;
+        int resyncCount = 0;
+        ScanResult r;
+        do {
+            r = UhfProtocol.scan(buf, offset, buf.length - offset);
+            if (r.outcome == ScanOutcome.RESYNC) {
+                resyncCount++;
+                offset += r.bytesToDiscard;
+            }
+        } while (r.outcome == ScanOutcome.RESYNC);
+
+        assertEquals(garbage.length, resyncCount);
+        assertEquals(ScanOutcome.FRAME, r.outcome);
+        assertEquals(0x21, r.frame.command);
+        assertArrayEquals(new byte[] {9, 9}, r.frame.data);
+    }
+
+    @Test
+    public void scan_recoversAfterCrcCorruptedFrameFollowedByGoodOne() {
+        byte[] corrupted = UhfProtocol.buildFrame(0xFF, 0x01, new byte[] {1, 2, 3});
+        corrupted[corrupted.length - 1] ^= 0x01; // wreck the CRC only
+        byte[] good = UhfProtocol.buildFrame(0xFF, 0x21, new byte[] {5});
+        byte[] buf = concatArrays(corrupted, good);
+
+        // Plain scan() must get all the way to needing more data at some point: the corrupted
+        // CRC's trailing byte can itself look like a plausible (oversized) length prefix once
+        // resync passes it, and scan() is correct to refuse to guess past that ambiguity from a
+        // single call — see scanWithStallRecovery's doc for why. This buffer is engineered to hit
+        // exactly that case, so the plain-scan half of this test is really asserting the ambiguity
+        // exists, not that it's resolved.
+        int offset = 0;
+        ScanResult r;
+        int guard = 0;
+        while (true) {
+            r = UhfProtocol.scan(buf, offset, buf.length - offset);
+            if (r.outcome != ScanOutcome.RESYNC) {
+                break;
+            }
+            offset += r.bytesToDiscard;
+            assertTrue("must not loop forever recovering from one corrupted frame", ++guard < 300);
+        }
+        assertEquals("this buffer is constructed to stall plain scan() on ambiguous length data",
+                ScanOutcome.NEED_MORE_DATA, r.outcome);
+
+        // A live connection would eventually deliver more bytes (or none, forever). A transport
+        // that has instead hit its FR-LNK-05 inter-byte timeout with no new byte arriving must
+        // resolve the stall via scanWithStallRecovery rather than blocking indefinitely.
+        guard = 0;
+        while (true) {
+            r = UhfProtocol.scanWithStallRecovery(buf, offset, buf.length - offset, true);
+            if (r.outcome != ScanOutcome.RESYNC) {
+                break;
+            }
+            offset += r.bytesToDiscard;
+            assertTrue("stall recovery must not loop forever either", ++guard < 300);
+        }
+        assertEquals(ScanOutcome.FRAME, r.outcome);
+        assertEquals(0x21, r.frame.command);
+    }
+
+    @Test
+    public void scanWithStallRecovery_doesNotDiscardWhileConnectionIsStillLive() {
+        // staleTimeoutElapsed=false must behave exactly like plain scan(): a length byte
+        // promising more data is patience, not noise, until the timeout says otherwise.
+        byte[] full = UhfProtocol.buildFrame(0xFF, 0x21, new byte[] {1, 2, 3, 4, 5});
+        byte[] truncated = Arrays.copyOf(full, full.length - 2);
+        ScanResult r = UhfProtocol.scanWithStallRecovery(truncated, 0, truncated.length, false);
+        assertEquals(ScanOutcome.NEED_MORE_DATA, r.outcome);
+    }
+
+    @Test
+    public void scanWithStallRecovery_doesNotAlterAFrameOrAnAlreadyCrcResyncOutcome() {
+        byte[] good = UhfProtocol.buildFrame(0xFF, 0x21, new byte[] {1});
+        ScanResult frameResult = UhfProtocol.scanWithStallRecovery(good, 0, good.length, true);
+        assertEquals(ScanOutcome.FRAME, frameResult.outcome);
+
+        byte[] junk = {0x00};
+        ScanResult resyncResult = UhfProtocol.scanWithStallRecovery(junk, 0, junk.length, true);
+        assertEquals(ScanOutcome.RESYNC, resyncResult.outcome);
+    }
+
+    @Test
+    public void scan_needsMoreData_whenLenFieldPromisesBytesNotYetBuffered() {
+        byte[] full = UhfProtocol.buildFrame(0xFF, 0x21, new byte[] {1, 2, 3, 4, 5});
+        byte[] truncated = Arrays.copyOf(full, full.length - 2); // hold back the last 2 bytes
+        ScanResult r = UhfProtocol.scan(truncated, 0, truncated.length);
+        assertEquals(ScanOutcome.NEED_MORE_DATA, r.outcome);
+    }
+
+    @Test
+    public void scan_emptyBufferNeedsMoreData() {
+        ScanResult r = UhfProtocol.scan(new byte[0], 0, 0);
+        assertEquals(ScanOutcome.NEED_MORE_DATA, r.outcome);
+    }
+
+    @Test
+    public void scan_singleByteBelowMinLenIsImmediateResyncNotNeedMoreData() {
+        // A length byte of e.g. 2 can *never* be valid (min is 4) regardless of how much more
+        // data arrives, so this must resync immediately rather than waiting for "more data".
+        ScanResult r = UhfProtocol.scan(new byte[] {0x02}, 0, 1);
+        assertEquals(ScanOutcome.RESYNC, r.outcome);
+        assertEquals(1, r.bytesToDiscard);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-07: reply matching while tag frames are interleaved — only the frame whose reCmd
+    // matches is accepted.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void reCmdMatches_rejectsInterleavedRealTimeTagFrameEvenThoughItsCrcIsValid() {
+        // Simulates FR-LNK-06's exact failure mode: a real-time-mode tag frame (cmd 0xEE) is a
+        // perfectly valid, CRC-correct frame that happens to arrive while we're waiting on the
+        // reply to an 0x3F (set antenna mask) command.
+        byte[] tagFrame = UhfProtocol.buildFrame(0xFF, 0xEE, new byte[] {1, 2, 3});
+        byte[] realReply = UhfProtocol.buildFrame(0xFF, 0x3F, new byte[] {0x00});
+        byte[] buf = concatArrays(tagFrame, realReply);
+
+        int sentCommand = 0x3F;
+        int offset = 0;
+        Frame accepted = null;
+        int guard = 0;
+        while (offset < buf.length && ++guard < 100) {
+            ScanResult r = UhfProtocol.scan(buf, offset, buf.length - offset);
+            if (r.outcome == ScanOutcome.FRAME) {
+                offset += r.frame.wireLength;
+                if (UhfProtocol.reCmdMatches(r.frame, sentCommand)) {
+                    accepted = r.frame;
+                    break;
+                }
+                // structurally valid but not our reply (the tag frame) — correctly skipped.
+            } else if (r.outcome == ScanOutcome.RESYNC) {
+                offset += r.bytesToDiscard;
+            } else {
+                break;
+            }
+        }
+
+        assertTrue("the real reply must eventually be accepted", accepted != null);
+        assertEquals(0x3F, accepted.command);
+        assertArrayEquals(new byte[] {0x00}, accepted.data);
+    }
+
+    @Test
+    public void reCmdMatches_falseWhenCommandDiffersEvenIfEverythingElseMatches() {
+        assertFalse(UhfProtocol.reCmdMatches(frameWithCommand(0x21), 0x22));
+        assertTrue(UhfProtocol.reCmdMatches(frameWithCommand(0x22), 0x22));
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // TST-U-08: status-to-error mapping table — matches §5.5 exactly; 0xFB yields an empty list,
+    // not a throw. ("Empty list" is the caller's job once ERROR_NONE comes back for 0xFB; this
+    // test asserts the mapping itself.)
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void mapStatusToError_matchesSection5point5ExactlyForEveryDocumentedStatus() {
+        assertEquals(UhfProtocol.ERROR_NONE, UhfProtocol.mapStatusToError(0x00));
+        assertEquals(UhfProtocol.ERROR_NONE, UhfProtocol.mapStatusToError(0x01));
+        assertEquals(UhfProtocol.ERROR_NONE, UhfProtocol.mapStatusToError(0x02)); // partial, not error
+        assertEquals(UhfProtocol.ERROR_BUFFER_FULL, UhfProtocol.mapStatusToError(0x04));
+        assertEquals(UhfProtocol.ERROR_ANTENNA_FAULT, UhfProtocol.mapStatusToError(0xF8));
+        assertEquals(UhfProtocol.ERROR_COMMAND_REJECTED, UhfProtocol.mapStatusToError(0xF9));
+        assertEquals(UhfProtocol.ERROR_NONE, UhfProtocol.mapStatusToError(0xFB)); // no throw, no error
+        assertEquals(UhfProtocol.ERROR_PROTOCOL, UhfProtocol.mapStatusToError(0xFD));
+        assertEquals(UhfProtocol.ERROR_PROTOCOL, UhfProtocol.mapStatusToError(0xFE));
+        assertEquals(UhfProtocol.ERROR_INVALID_PARAMETER, UhfProtocol.mapStatusToError(0xFF));
+    }
+
+    @Test
+    public void mapStatusToError_0xFB_isNotAnException() {
+        // The literal TST-U-08 wording: "0xFB yields an empty list, not a throw." At the mapper
+        // level that means: it must not throw, and it must not signal an error the caller would
+        // be forced to catch around an ordinary "no tags in field" outcome.
+        int error = UhfProtocol.mapStatusToError(UhfProtocol.STATUS_NO_OPERABLE_TAGS);
+        assertEquals(UhfProtocol.ERROR_NONE, error);
+    }
+
+    @Test
+    public void mapStatusToError_0x03MustNeverReachTheMapper() {
+        // 0x03 is a continuation marker consumed by frame assembly, not a terminal status. A
+        // caller that forwards it to the mapper has a bug; the mapper must say so loudly rather
+        // than inventing a plausible mapping for it.
+        try {
+            UhfProtocol.mapStatusToError(UhfProtocol.STATUS_MORE_FRAMES_FOLLOW);
+            fail("0x03 must not have a silent mapping");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void mapStatusToError_unknownStatusThrowsRatherThanGuessing() {
+        try {
+            UhfProtocol.mapStatusToError(0x37); // not in §5.5
+            fail("an unmapped status must not silently succeed");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Additional edge cases beyond the SRS's own TST-U-* list.
+    // ---------------------------------------------------------------------------------------
+
+    @Test
+    public void bandPlan_rejectsNOutsideDocumentedRange() {
+        BandPlan eu = UhfProtocol.bandPlanForCode(0b0100);
+        try {
+            eu.centerFrequencyMhz(15); // EU's max N is 14
+            fail("N=15 is out of range for EU (max 14)");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+        try {
+            eu.centerFrequencyMhz(-1);
+            fail("negative N must be rejected");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void bandPlan_unassignedCodeReturnsNullNotAWrongGuess() {
+        assertNull(UhfProtocol.bandPlanForCode(0b0101)); // not in the §4.4 table
+    }
+
+    @Test
+    public void buildFrame_defaultsNullPayloadToEmpty() {
+        byte[] frame = UhfProtocol.buildFrame(0xFF, 0x76, null);
+        assertEquals(UhfProtocol.MIN_LEN_FIELD, frame[0] & 0xFF);
+    }
+
+    @Test
+    public void statusByte_throwsRatherThanIndexingAnEmptyPayload() {
+        Frame f = frameWithNoData(0x21);
+        try {
+            f.statusByte();
+            fail("a frame with no data has no status byte to read");
+        } catch (IllegalStateException expected) {
+            // pass
+        }
+    }
+
+    @Test
+    public void crc16_boundsCheckedAgainstBufferLength() {
+        byte[] buf = new byte[4];
+        try {
+            UhfProtocol.crc16(buf, 2, 10); // runs past the end
+            fail("expected bounds check to reject this");
+        } catch (IndexOutOfBoundsException expected) {
+            // pass
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Test fixtures / helpers
+    // ---------------------------------------------------------------------------------------
+
+    private static Frame statusFrame(int status, byte[] tagBlob) {
+        byte[] data = new byte[1 + tagBlob.length];
+        data[0] = (byte) status;
+        System.arraycopy(tagBlob, 0, data, 1, tagBlob.length);
+        return frameFromParts(0xFF, 0x01, data);
+    }
+
+    private static byte[] encodeOneTagNoTidNoPhase(byte[] epc, int rssi) {
+        byte[] out = new byte[1 + epc.length + 1];
+        out[0] = (byte) (epc.length / 2); // no flags set, plain EPC-word-count length byte
+        System.arraycopy(epc, 0, out, 1, epc.length);
+        out[1 + epc.length] = (byte) rssi;
+        return out;
+    }
+
+    private static byte[] concat(List<byte[]> parts) {
+        int total = 0;
+        for (byte[] p : parts) total += p.length;
+        byte[] out = new byte[total];
+        int pos = 0;
+        for (byte[] p : parts) {
+            System.arraycopy(p, 0, out, pos, p.length);
+            pos += p.length;
+        }
+        return out;
+    }
+
+    private static byte[] concatArrays(byte[] a, byte[] b) {
+        byte[] out = new byte[a.length + b.length];
+        System.arraycopy(a, 0, out, 0, a.length);
+        System.arraycopy(b, 0, out, a.length, b.length);
+        return out;
+    }
+
+    /** Builds a {@link Frame} directly (bypassing the wire) for tests that only need the model. */
+    private static Frame frameFromParts(int address, int command, byte[] data) {
+        byte[] wire = UhfProtocol.buildFrame(address, command, data);
+        ScanResult r = UhfProtocol.scan(wire, 0, wire.length);
+        if (r.outcome != ScanOutcome.FRAME) {
+            throw new AssertionError("test helper built an unparseable frame");
+        }
+        return r.frame;
+    }
+
+    private static Frame frameWithCommand(int command) {
+        return frameFromParts(0xFF, command, new byte[] {0x00});
+    }
+
+    private static Frame frameWithNoData(int command) {
+        return frameFromParts(0xFF, command, new byte[0]);
+    }
+}
