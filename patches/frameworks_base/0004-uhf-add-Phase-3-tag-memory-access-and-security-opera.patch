@@ -21,15 +21,18 @@ import android.hardware.uhf.IUhfTagCallback;
 import android.hardware.uhf.InventoryParams;
 import android.hardware.uhf.StreamParams;
 import android.hardware.uhf.StreamStats;
+import android.hardware.uhf.TagFilter;
 import android.hardware.uhf.UhfDeviceInfo;
 import android.hardware.uhf.UhfReaderInfo;
 import android.hardware.uhf.UhfTag;
 
 /**
  * Binder interface behind {@code UhfManager}/{@code UhfSession}, implemented by
- * {@code com.android.server.uhf.UhfService}. UHF-SRS-001 Phase 1 scope only (§4.1-4.8); tag
- * memory/security/protection/EAS/peripherals/diagnostics (§4.9-4.16) are added in later phases
- * without needing to change any method declared here.
+ * {@code com.android.server.uhf.UhfService}. Covers UHF-SRS-001 §4.1-4.11 (Phase 1's lifecycle
+ * through inventory/streaming, plus Phase 3's tag memory access and security operations).
+ * Read protection/EAS/vendor-extensions/peripherals/diagnostics (§4.12-4.16) are not yet
+ * implemented — their wire payloads are unspecified beyond a command byte (SRS Confirm status)
+ * and were left for when real hardware can confirm them, rather than guessed at wholesale.
  *
  * <p>Every non-oneway method here may throw {@link android.os.ServiceSpecificException} with one
  * of {@code UhfException.ERROR_*} as its code; {@code UhfManager}/{@code UhfSession} catch it and
@@ -104,4 +107,39 @@ interface IUhfService {
     StreamStats getStreamStats(IBinder sessionToken);
 
     void resetStreamStats(IBinder sessionToken);
+
+    // ---- §4.10 Tag memory access, §4.11 Tag security (Phase 3) ----
+    // All of these are governed by FR-STR-13: an active stream is stopped first and restarted
+    // afterward if the caller had not explicitly stopped it, the same as §4.9's buffered
+    // inventory. UHF_WRITE-gated except readTagMemory (UHF_READ; reading is not writing).
+
+    byte[] readTagMemory(IBinder sessionToken, in TagFilter filter, int bank, int wordAddress,
+            int wordCount);
+
+    void writeTagMemory(IBinder sessionToken, in TagFilter filter, int bank, int wordAddress,
+            in byte[] data);
+
+    void writeEpc(IBinder sessionToken, in TagFilter filter, in byte[] newEpc);
+
+    void blockWrite(IBinder sessionToken, in TagFilter filter, int bank, int wordAddress,
+            in byte[] data);
+
+    void blockErase(IBinder sessionToken, in TagFilter filter, int bank, int wordAddress,
+            int wordCount);
+
+    void setVerifyWrites(IBinder sessionToken, boolean verify);
+
+    /** FR-SEC-02: rejected if {@code killPassword} is all zeros. */
+    void killTag(IBinder sessionToken, in TagFilter filter, in byte[] killPassword);
+
+    /** FR-SEC-04: {@code confirmIrreversible} must be {@code true} to request one of the two
+     * permanent lock states. */
+    void lockTag(IBinder sessionToken, in TagFilter filter, int region, int lockState,
+            in byte[] accessPassword, boolean confirmIrreversible);
+
+    void setAccessPassword(IBinder sessionToken, in TagFilter filter, in byte[] oldPassword,
+            in byte[] newPassword);
+
+    void setKillPassword(IBinder sessionToken, in TagFilter filter, in byte[] accessPassword,
+            in byte[] newKillPassword);
 }
