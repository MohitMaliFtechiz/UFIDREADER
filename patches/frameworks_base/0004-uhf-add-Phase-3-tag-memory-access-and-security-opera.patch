@@ -24,6 +24,7 @@ import android.hardware.uhf.IUhfTagCallback;
 import android.hardware.uhf.InventoryParams;
 import android.hardware.uhf.StreamParams;
 import android.hardware.uhf.StreamStats;
+import android.hardware.uhf.TagFilter;
 import android.hardware.uhf.UhfDeviceInfo;
 import android.hardware.uhf.UhfManager;
 import android.hardware.uhf.UhfReaderInfo;
@@ -138,8 +139,34 @@ public final class UhfService extends SystemService {
         super(context);
         UhfTransport transport = new UhfHalTransport();
         SettingsRegionStore regionStore = new SettingsRegionStore(context);
-        mArbiter = new UhfSessionArbiter(transport, regionStore, (client, bandCode) ->
-                Slog.i(TAG, "region changed to band 0x" + Integer.toHexString(bandCode))); // FR-FRQ-04
+        mArbiter = new UhfSessionArbiter(transport, regionStore, new UhfSessionArbiter.EventLog() {
+            @Override
+            public void onRegionChanged(Object clientToken, int newBandCode) {
+                // FR-FRQ-04: region is a regulatory-visible change.
+                Slog.i(TAG, "region changed to band 0x" + Integer.toHexString(newBandCode)
+                        + " by uid " + Binder.getCallingUid());
+            }
+
+            @Override
+            public void onIrreversibleOperation(Object clientToken, String operation,
+                    UhfSessionArbiter.TagFilterSpec filter) {
