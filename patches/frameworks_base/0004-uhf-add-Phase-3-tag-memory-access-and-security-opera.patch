+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.annotation.SystemApi;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * Selects which tag a §4.10-4.13 memory/security/protection operation targets, per UHF-SRS-001's
+ * §4.10 code sample. {@link #any()} is only valid when the caller already knows exactly one tag
+ * is in field — the service does not resolve ambiguity for the caller.
+ *
+ * @hide
+ */
+@SystemApi
+public final class TagFilter implements Parcelable {
+
+    private static final int KIND_EPC = 0;
+    private static final int KIND_TID = 1;
+    private static final int KIND_ANY = 2;
+
+    private final int mKind;
+    private final byte[] mEpc;
+    private final byte[] mTid;
+    private final byte[] mAccessPassword; // null unless supplied
+
+    private TagFilter(int kind, byte[] epc, byte[] tid, byte[] accessPassword) {
+        mKind = kind;
+        mEpc = epc;
+        mTid = tid;
+        mAccessPassword = accessPassword;
+    }
+
+    @NonNull
+    public static TagFilter byEpc(@NonNull byte[] epc) {
+        return new TagFilter(KIND_EPC, requireNonEmpty(epc, "epc"), null, null);
+    }
+
+    @NonNull
+    public static TagFilter byEpc(@NonNull byte[] epc, @NonNull byte[] accessPassword) {
+        return new TagFilter(KIND_EPC, requireNonEmpty(epc, "epc"), null,
+                requirePasswordLength(accessPassword));
+    }
+
+    @NonNull
+    public static TagFilter byTid(@NonNull byte[] tid) {
+        return new TagFilter(KIND_TID, null, requireNonEmpty(tid, "tid"), null);
+    }
+
+    /** Valid only when exactly one tag is in field; the reader (not this filter) enforces that. */
+    @NonNull
+    public static TagFilter any() {
+        return new TagFilter(KIND_ANY, null, null, null);
+    }
+
+    public boolean isByEpc() {
+        return mKind == KIND_EPC;
+    }
+
+    public boolean isByTid() {
+        return mKind == KIND_TID;
+    }
+
+    public boolean isAny() {
+        return mKind == KIND_ANY;
+    }
+
+    /** Non-null only when {@link #isByEpc()}. */
+    @Nullable
+    public byte[] getEpc() {
+        return mEpc;
+    }
+
+    /** Non-null only when {@link #isByTid()}. */
+    @Nullable
+    public byte[] getTid() {
+        return mTid;
+    }
+
+    /** May be null even when {@link #isByEpc()}: the single-arg {@link #byEpc(byte[])} does not
+     * supply one, for tags that do not require one to be written. */
+    @Nullable
+    public byte[] getAccessPassword() {
+        return mAccessPassword;
+    }
+
+    private static byte[] requireNonEmpty(byte[] value, String name) {
+        if (value == null || value.length == 0) {
+            throw new IllegalArgumentException(name + " must not be null or empty");
+        }
+        return value;
+    }
+
+    private static byte[] requirePasswordLength(byte[] password) {
+        if (password == null || password.length != 4) {
+            // EPC C1G2 access/kill passwords are 32 bits (Reserved bank words 2-3 / 0-1).
+            throw new IllegalArgumentException("access password must be exactly 4 bytes");
+        }
+        return password;
+    }
+
+    private TagFilter(Parcel in) {
+        mKind = in.readInt();
+        mEpc = in.createByteArray();
+        mTid = in.createByteArray();
+        mAccessPassword = in.createByteArray();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeInt(mKind);
+        dest.writeByteArray(mEpc);
+        dest.writeByteArray(mTid);
+        dest.writeByteArray(mAccessPassword);
+    }
+
+    @NonNull
+    public static final Creator<TagFilter> CREATOR = new Creator<TagFilter>() {
+        @Override
+        public TagFilter createFromParcel(Parcel in) {
+            return new TagFilter(in);
+        }
+
+        @Override
+        public TagFilter[] newArray(int size) {
+            return new TagFilter[size];
+        }
+    };
+}
diff --git a/core/java/android/hardware/uhf/UhfSession.java b/core/java/android/hardware/uhf/UhfSession.java
index 9c350143..06f411f0 100644
