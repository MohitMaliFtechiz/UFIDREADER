+++ b/core/java/android/hardware/uhf/UhfSession.java
@@ -17,6 +17,7 @@
 package android.hardware.uhf;
 
 import android.annotation.NonNull;
+import android.annotation.Nullable;
 import android.annotation.SystemApi;
 import android.os.IBinder;
 import android.os.RemoteException;
@@ -279,6 +280,146 @@ public final class UhfSession implements AutoCloseable {
         }
     }
 
+    // ---------------------------------------------------------------------------------------
+    // §4.10 Tag memory access, §4.11 Tag security (Phase 3)
+    // ---------------------------------------------------------------------------------------
+
+    public static final int BANK_RESERVED = 0;
+    public static final int BANK_EPC = 1;
+    public static final int BANK_TID = 2;
+    public static final int BANK_USER = 3;
+
+    public static final int LOCK_REGION_KILL_PW = 0;
+    public static final int LOCK_REGION_ACCESS_PW = 1;
+    public static final int LOCK_REGION_EPC = 2;
+    public static final int LOCK_REGION_TID = 3;
+    public static final int LOCK_REGION_USER = 4;
+
+    public static final int LOCK_OPEN = 0;
+    public static final int LOCK_LOCKED = 1;
+    public static final int LOCK_PERM_OPEN = 2;
+    public static final int LOCK_PERM_LOCKED = 3;
+
+    @NonNull
+    public byte[] readTagMemory(@NonNull TagFilter filter, int bank, int wordAddress,
+            int wordCount) throws UhfException {
+        try {
+            return mService.readTagMemory(mSessionToken, filter, bank, wordAddress, wordCount);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void writeTagMemory(@NonNull TagFilter filter, int bank, int wordAddress,
+            @NonNull byte[] data) throws UhfException {
+        try {
+            mService.writeTagMemory(mSessionToken, filter, bank, wordAddress, data);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void writeEpc(@NonNull TagFilter filter, @NonNull byte[] newEpc) throws UhfException {
+        try {
+            mService.writeEpc(mSessionToken, filter, newEpc);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Falls back to sequential word writes when the tag does not support block write
+     * (FR-MEM-04) — that fallback happens service-side, transparently to this call. */
+    public void blockWrite(@NonNull TagFilter filter, int bank, int wordAddress,
+            @NonNull byte[] data) throws UhfException {
+        try {
+            mService.blockWrite(mSessionToken, filter, bank, wordAddress, data);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void blockErase(@NonNull TagFilter filter, int bank, int wordAddress, int wordCount)
+            throws UhfException {
+        try {
+            mService.blockErase(mSessionToken, filter, bank, wordAddress, wordCount);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** FR-MEM-07: on by default; disable only for bulk commissioning where the write throughput
+     * cost of a read-back on every word matters more than catching a partial write immediately. */
+    public void setVerifyWrites(boolean verify) throws UhfException {
+        try {
+            mService.setVerifyWrites(mSessionToken, verify);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** FR-SEC-02: {@code killPassword} must not be all zeros — that would kill unconditionally
+     * and is refused rather than honoured. Requires {@code UHF_WRITE}; every call is recorded in
+     * the system event log with the calling package and target EPC (FR-SEC-07). */
+    public void killTag(@NonNull TagFilter filter, @NonNull byte[] killPassword)
+            throws UhfException {
+        try {
+            mService.killTag(mSessionToken, filter, killPassword);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** FR-SEC-04: {@code confirmIrreversible} must be {@code true} to request
+     * {@link #LOCK_PERM_OPEN} or {@link #LOCK_PERM_LOCKED} — both are permanent and cannot be
+     * undone by any later call. */
+    public void lockTag(@NonNull TagFilter filter, int region, int lockState,
+            @Nullable byte[] accessPassword, boolean confirmIrreversible) throws UhfException {
+        try {
+            mService.lockTag(mSessionToken, filter, region, lockState, accessPassword,
+                    confirmIrreversible);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void setAccessPassword(@NonNull TagFilter filter, @NonNull byte[] oldPassword,
+            @NonNull byte[] newPassword) throws UhfException {
+        try {
+            mService.setAccessPassword(mSessionToken, filter, oldPassword, newPassword);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void setKillPassword(@NonNull TagFilter filter, @NonNull byte[] accessPassword,
+            @NonNull byte[] newKillPassword) throws UhfException {
+        try {
+            mService.setKillPassword(mSessionToken, filter, accessPassword, newKillPassword);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
     private static UhfException toUhfException(ServiceSpecificException e) {
         return new UhfException(e.errorCode, e.getMessage());
     }
