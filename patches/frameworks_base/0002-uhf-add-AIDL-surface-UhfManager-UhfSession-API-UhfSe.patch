+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.SystemApi;
+
+/**
+ * Thrown for a reader/link-level failure, carrying one of the stable {@code ERROR_*} codes from
+ * UHF-SRS-001 §5.5. Wire status bytes never reach the caller directly — {@code UhfService} maps
+ * them once, centrally, so app code (and this class's own callers) never need to know the wire
+ * protocol. Two statuses are deliberately <em>not</em> represented here at all: {@code 0x01}
+ * (inventory complete) and {@code 0xFB} (no operable tags) are ordinary outcomes, not exceptions
+ * (FR-INV-08) — an API that throws on an empty field forces every caller into a try/catch around
+ * a non-error.
+ *
+ * @hide
+ */
+@SystemApi
+public final class UhfException extends Exception {
+
+    public static final int ERROR_BUFFER_FULL = 1;
+    public static final int ERROR_ANTENNA_FAULT = 2;
+    public static final int ERROR_COMMAND_REJECTED = 3;
+    public static final int ERROR_PROTOCOL = 4;
+    public static final int ERROR_INVALID_PARAMETER = 5;
+    public static final int ERROR_TIMEOUT = 6;
+    public static final int ERROR_DEVICE_LOST = 7;
+    public static final int ERROR_BUSY = 8;
+
+    private final int mErrorCode;
+
+    public UhfException(int errorCode, @NonNull String message) {
+        super(message);
+        mErrorCode = errorCode;
+    }
+
+    public int getErrorCode() {
+        return mErrorCode;
+    }
+}
diff --git a/core/java/android/hardware/uhf/UhfManager.java b/core/java/android/hardware/uhf/UhfManager.java
new file mode 100644
index 00000000..96b9a431
--- /dev/null
+++ b/core/java/android/hardware/uhf/UhfManager.java
@@ -0,0 +1,155 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.annotation.SystemApi;
+import android.annotation.SystemService;
+import android.content.Context;
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+import android.util.Log;
+
+import java.util.List;
+import java.util.concurrent.Executor;
+
+/**
+ * Entry point for the platform's UHF RFID reader (UHF-SRS-001). Obtain with
+ * {@code context.getSystemService(UhfManager.class)}, or {@code null} on a device without
+ * {@link android.content.pm.PackageManager#FEATURE_UHF_READER} (NFR-C-06) — this class never
+ * throws for that reason, so callers do not need a try/catch just to probe for the feature.
+ *
+ * <p>Nothing here touches the wire protocol or even knows a reader is a serial device; that is
+ * {@code UhfService}'s and (from Phase 2) the vendor HAL's job (§3.2/§3.4). This class is
+ * intentionally thin: parameter validation that can be done without a session, and marshalling
+ * callbacks onto the caller's {@link Executor} — see SDK-03, which holds the SDK to the same
+ * standard for the same reason.
+ *
+ * @hide
+ */
+@SystemApi
+@SystemService(Context.UHF_SERVICE)
+public final class UhfManager {
+    private static final String TAG = "UhfManager";
+
+    public static final int STATE_ABSENT = 0;
+    public static final int STATE_ATTACHED = 1;
+    public static final int STATE_READY = 2;
+    public static final int STATE_BUSY = 3;
+    public static final int STATE_ERROR = 4;
+
+    private final Context mContext;
+    private final IUhfService mService;
+
+    /** @hide */
+    public UhfManager(@NonNull Context context, @NonNull IUhfService service) {
+        mContext = context;
+        mService = service;
+    }
+
+    /** FR-LC-01: distinguishes "no hardware" from "hardware present but unavailable" only in
+     * that the latter is also {@code false} here — see {@link StateCallback} for the distinction
+     * once a session shows the reader is {@link #STATE_ATTACHED} but not yet {@link #STATE_READY}. */
+    public boolean isReaderAvailable() {
+        try {
+            return mService.isReaderAvailable();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** FR-LC-02. Most devices have exactly one reader; {@link #openSession()} skips this call. */
+    @NonNull
+    public List<UhfDeviceInfo> getReaders() {
+        try {
+            return mService.getReaders();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Opens a session on a specific reader (FR-LC-03), or the default reader if
+     * {@code readerId} is {@code null}. Throws {@link UhfException} with
+     * {@link UhfException#ERROR_BUSY} if another client already holds it. */
+    @NonNull
+    public UhfSession openSession(@Nullable String readerId) throws UhfException {
+        IBinder clientToken = new Binder();
+        try {
+            IBinder sessionToken = mService.openSession(readerId, clientToken);
+            return new UhfSession(mService, sessionToken);
+        } catch (ServiceSpecificException e) {
+            throw new UhfException(e.errorCode, e.getMessage());
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Opens a session on the device's default (usually only) reader. */
+    @NonNull
+    public UhfSession openSession() throws UhfException {
+        return openSession(/* readerId= */ null);
+    }
+
+    /**
+     * Registers for {@link #STATE_ABSENT}/{@code ATTACHED}/{@code READY}/{@code BUSY}/
+     * {@code ERROR} notifications (FR-LC-06/07), delivered on {@code executor}. Independent of
+     * whether this caller holds a session — this is how a caller decides whether to try
+     * {@link #openSession} at all, or reacts to another client's session ending.
+     */
+    public void registerStateCallback(@NonNull Executor executor, @NonNull StateCallback callback) {
+        IUhfStateCallback wrapper = new IUhfStateCallback.Stub() {
+            @Override
+            public void onStateChanged(int state) {
+                executor.execute(() -> callback.onStateChanged(state));
+            }
+        };
+        callback.mWrapper = wrapper;
+        try {
+            mService.registerStateCallback(wrapper);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void unregisterStateCallback(@NonNull StateCallback callback) {
+        IUhfStateCallback wrapper = callback.mWrapper;
+        if (wrapper == null) {
+            return; // never registered, or already unregistered; not an error either way
+        }
+        try {
+            mService.unregisterStateCallback(wrapper);
+        } catch (RemoteException e) {
+            Log.w(TAG, "unregisterStateCallback: service already gone", e);
+        }
+        callback.mWrapper = null;
+    }
+
+    /**
+     * Reader presence/availability listener for {@link #registerStateCallback}.
+     *
+     * @hide
+     */
+    @SystemApi
+    public abstract static class StateCallback {
+        private volatile IUhfStateCallback mWrapper;
+
+        public abstract void onStateChanged(int state);
+    }
+}
