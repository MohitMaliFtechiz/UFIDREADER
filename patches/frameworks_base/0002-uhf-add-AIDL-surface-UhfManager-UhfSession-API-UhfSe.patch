+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.SystemApi;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * Reader identity and current configuration, per UHF-SRS-001 FR-INF-01. Obtained from
+ * {@link UhfSession#getReaderInfo()}; the service caches it for the life of a session and
+ * invalidates the cache on any configuration write (FR-INF-05), so reading it in a loop does not
+ * generate serial traffic.
+ *
+ * @hide
+ */
+@SystemApi
+public final class UhfReaderInfo implements Parcelable {
+    private final String mFirmwareVersion;
+    private final int mModelType;
+    private final boolean mSupportsIso18000_6c;
+    private final boolean mSupportsIso18000_6b;
+    private final int mBandCode;
+    private final String mBandName;
+    private final double mMinFrequencyMhz;
+    private final double mMaxFrequencyMhz;
+    private final int mMaxRfPower;
+    private final int mScanTimeMs;
+    private final int mAntennaMask;
+    private final boolean mAntennaCheckEnabled;
+
+    /** @hide */
+    public UhfReaderInfo(@NonNull String firmwareVersion, int modelType,
+            boolean supportsIso18000_6c, boolean supportsIso18000_6b, int bandCode,
+            @NonNull String bandName, double minFrequencyMhz, double maxFrequencyMhz,
+            int maxRfPower, int scanTimeMs, int antennaMask, boolean antennaCheckEnabled) {
+        mFirmwareVersion = firmwareVersion;
+        mModelType = modelType;
+        mSupportsIso18000_6c = supportsIso18000_6c;
+        mSupportsIso18000_6b = supportsIso18000_6b;
+        mBandCode = bandCode;
+        mBandName = bandName;
+        mMinFrequencyMhz = minFrequencyMhz;
+        mMaxFrequencyMhz = maxFrequencyMhz;
+        mMaxRfPower = maxRfPower;
+        mScanTimeMs = scanTimeMs;
+        mAntennaMask = antennaMask;
+        mAntennaCheckEnabled = antennaCheckEnabled;
+    }
+
+    /** e.g. {@code "1.24"}. */
+    @NonNull
+    public String getFirmwareVersion() {
+        return mFirmwareVersion;
+    }
+
+    public int getModelType() {
+        return mModelType;
+    }
+
+    public boolean supportsIso18000_6c() {
+        return mSupportsIso18000_6c;
+    }
+
+    /** Always {@code false} for this reader family; kept for API symmetry with §1.2's scope note. */
+    public boolean supportsIso18000_6b() {
+        return mSupportsIso18000_6b;
+    }
+
+    /** Raw 4-bit band code; see {@link #getBandName()} for the resolved region. */
+    public int getBandCode() {
+        return mBandCode;
+    }
+
+    /** e.g. {@code "EU"}; empty string if {@link #getBandCode()} is not one of §4.4's rows. */
+    @NonNull
+    public String getBandName() {
+        return mBandName;
+    }
+
+    public double getMinFrequencyMhz() {
+        return mMinFrequencyMhz;
+    }
+
+    public double getMaxFrequencyMhz() {
+        return mMaxFrequencyMhz;
+    }
+
+    /** FR-PWR-02: the ceiling {@link UhfSession#setRfPower} enforces regardless of the safe cap. */
+    public int getMaxRfPower() {
+        return mMaxRfPower;
+    }
+
+    public int getScanTimeMs() {
+        return mScanTimeMs;
+    }
+
+    /** Bit 0 = antenna port 1 .. bit 3 = port 4 (FR-ANT-01). */
+    public int getAntennaMask() {
+        return mAntennaMask;
+    }
+
+    public boolean isAntennaCheckEnabled() {
+        return mAntennaCheckEnabled;
+    }
+
+    private UhfReaderInfo(Parcel in) {
+        mFirmwareVersion = in.readString();
+        mModelType = in.readInt();
+        mSupportsIso18000_6c = in.readBoolean();
+        mSupportsIso18000_6b = in.readBoolean();
+        mBandCode = in.readInt();
+        mBandName = in.readString();
+        mMinFrequencyMhz = in.readDouble();
+        mMaxFrequencyMhz = in.readDouble();
+        mMaxRfPower = in.readInt();
+        mScanTimeMs = in.readInt();
+        mAntennaMask = in.readInt();
+        mAntennaCheckEnabled = in.readBoolean();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeString(mFirmwareVersion);
+        dest.writeInt(mModelType);
+        dest.writeBoolean(mSupportsIso18000_6c);
+        dest.writeBoolean(mSupportsIso18000_6b);
+        dest.writeInt(mBandCode);
+        dest.writeString(mBandName);
+        dest.writeDouble(mMinFrequencyMhz);
+        dest.writeDouble(mMaxFrequencyMhz);
+        dest.writeInt(mMaxRfPower);
+        dest.writeInt(mScanTimeMs);
+        dest.writeInt(mAntennaMask);
+        dest.writeBoolean(mAntennaCheckEnabled);
+    }
+
+    @NonNull
+    public static final Creator<UhfReaderInfo> CREATOR = new Creator<UhfReaderInfo>() {
+        @Override
+        public UhfReaderInfo createFromParcel(Parcel in) {
+            return new UhfReaderInfo(in);
+        }
+
+        @Override
+        public UhfReaderInfo[] newArray(int size) {
+            return new UhfReaderInfo[size];
+        }
+    };
+}
diff --git a/core/java/android/hardware/uhf/UhfSession.java b/core/java/android/hardware/uhf/UhfSession.java
new file mode 100644
index 00000000..9c350143
--- /dev/null
+++ b/core/java/android/hardware/uhf/UhfSession.java
@@ -0,0 +1,285 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.SystemApi;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+import android.util.Log;
+
+import java.util.List;
+import java.util.concurrent.Executor;
+
+/**
+ * An exclusive, single-reader session (FR-LC-03), obtained from {@link UhfManager#openSession}.
+ * {@link AutoCloseable}: closing it (directly, or via try-with-resources as in §5.1's example)
+ * releases the reader and returns it to answering mode, mirroring what
+ * {@code UhfService}/{@code UhfSessionArbiter} already does automatically if this process dies
+ * instead (FR-LC-04) — a graceful close and a crash converge on the same reader-side state.
+ *
+ * <p>Every method here requires the session still be open; calling one after {@link #close()} (or
+ * after this process's Binder connection to {@code UhfService} has otherwise invalidated the
+ * token) surfaces as {@link UhfException} with {@link UhfException#ERROR_BUSY} from the service,
+ * the same as it would for a second, unrelated caller — this class does not add a separate local
+ * "already closed" exception type, so callers have exactly one failure mode to handle rather than
+ * two that mean almost the same thing.
+ *
+ * @hide
+ */
+@SystemApi
+public final class UhfSession implements AutoCloseable {
+    private static final String TAG = "UhfSession";
+
+    private final IUhfService mService;
+    private final IBinder mSessionToken;
+    private volatile boolean mClosed;
+    private volatile IUhfTagCallback mStreamWrapper;
+
+    /** @hide */
+    public UhfSession(@NonNull IUhfService service, @NonNull IBinder sessionToken) {
+        mService = service;
+        mSessionToken = sessionToken;
+    }
+
+    /** Whether this session has not been {@link #close()}d locally. Does not itself confirm the
+     * service still honours the token — see the class doc. */
+    public boolean isValid() {
+        return !mClosed;
+    }
+
+    @Override
+    public void close() {
+        if (mClosed) {
+            return; // AutoCloseable convention: close() is idempotent.
+        }
+        mClosed = true;
+        try {
+            mService.closeSession(mSessionToken);
+        } catch (RemoteException e) {
+            Log.w(TAG, "close: service already gone", e);
+        }
+    }
+
+    @NonNull
+    public UhfReaderInfo getReaderInfo() throws UhfException {
+        try {
+            return mService.getReaderInfo(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void setRegion(int bandCode) throws UhfException {
+        try {
+            mService.setRegion(mSessionToken, bandCode);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Equivalent to {@code setRfPower(power, false)}. */
+    public void setRfPower(int power) throws UhfException {
+        setRfPower(power, /* allowAboveSafeCeiling= */ false);
+    }
+
+    /** FR-PWR-03: {@code allowAboveSafeCeiling} must be {@code true} to exceed
+     * {@link #getSafeRfPowerCeiling()}; see the class-level note on why this is not the default. */
+    public void setRfPower(int power, boolean allowAboveSafeCeiling) throws UhfException {
+        try {
+            mService.setRfPower(mSessionToken, power, allowAboveSafeCeiling);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public int getRfPower() throws UhfException {
+        try {
+            return mService.getRfPower(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** FR-PWR-02: the reader's own hardware ceiling, not overridable by {@code allowAboveSafeCeiling}. */
+    public int getMaxRfPower() throws UhfException {
+        return getReaderInfo().getMaxRfPower();
+    }
+
+    public int getSafeRfPowerCeiling() throws UhfException {
+        try {
+            return mService.getSafeRfPowerCeiling(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void setEnabledAntennas(int mask) throws UhfException {
+        try {
+            mService.setEnabledAntennas(mSessionToken, mask);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public int getEnabledAntennas() throws UhfException {
+        try {
+            return mService.getEnabledAntennas(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void setAntennaCheckEnabled(boolean enabled) throws UhfException {
+        try {
+            mService.setAntennaCheckEnabled(mSessionToken, enabled);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public boolean isAntennaCheckEnabled() throws UhfException {
+        try {
+            return mService.isAntennaCheckEnabled(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** One polled inventory round with default parameters (Q=4, session S0). */
+    @NonNull
+    public List<UhfTag> inventory() throws UhfException {
+        return inventory(new InventoryParams.Builder().build());
+    }
+
+    @NonNull
+    public List<UhfTag> inventory(@NonNull InventoryParams params) throws UhfException {
+        try {
+            return mService.inventory(mSessionToken, params);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Must be called before {@link #startStreaming}; FR-STR-08 applies it the next time
+     * streaming (re)starts, not retroactively to an already-running stream. */
+    public void setStreamParams(@NonNull StreamParams params) throws UhfException {
+        try {
+            mService.setStreamParams(mSessionToken, params);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** FR-STR-01/02: {@code callback}'s methods are invoked on {@code executor}, never on a
+     * Binder thread directly. */
+    public void startStreaming(@NonNull Executor executor, @NonNull TagCallback callback)
+            throws UhfException {
+        IUhfTagCallback wrapper = new IUhfTagCallback.Stub() {
+            @Override
+            public void onTagsRead(List<UhfTag> batch) {
+                executor.execute(() -> callback.onTagsRead(batch));
+            }
+
+            @Override
+            public void onStreamError(int errorCode, String message) {
+                executor.execute(() -> callback.onStreamError(errorCode, message));
+            }
+
+            @Override
+            public void onBatchesDropped(int count) {
+                executor.execute(() -> callback.onBatchesDropped(count));
+            }
+        };
+        try {
+            mService.startStreaming(mSessionToken, wrapper);
+            mStreamWrapper = wrapper; // only retained after a successful start
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void stopStreaming() {
+        mStreamWrapper = null;
+        try {
+            mService.stopStreaming(mSessionToken);
+        } catch (RemoteException e) {
+            Log.w(TAG, "stopStreaming: service already gone", e);
+        }
+    }
+
+    public boolean isStreaming() throws UhfException {
+        try {
+            return mService.isStreaming(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    @NonNull
+    public StreamStats getStreamStats() throws UhfException {
+        try {
+            return mService.getStreamStats(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Resets both the counters and the elapsed-time base together — see {@link StreamStats}. */
+    public void resetStreamStats() throws UhfException {
+        try {
+            mService.resetStreamStats(mSessionToken);
+        } catch (ServiceSpecificException e) {
+            throw toUhfException(e);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    private static UhfException toUhfException(ServiceSpecificException e) {
+        return new UhfException(e.errorCode, e.getMessage());
+    }
+}
