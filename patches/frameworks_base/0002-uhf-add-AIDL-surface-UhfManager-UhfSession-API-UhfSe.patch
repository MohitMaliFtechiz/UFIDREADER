+package com.android.server.uhf;
+
+import android.Manifest;
+import android.content.Context;
+import android.hardware.uhf.IUhfService;
+import android.hardware.uhf.IUhfStateCallback;
+import android.hardware.uhf.IUhfTagCallback;
+import android.hardware.uhf.InventoryParams;
+import android.hardware.uhf.StreamParams;
+import android.hardware.uhf.StreamStats;
+import android.hardware.uhf.UhfDeviceInfo;
+import android.hardware.uhf.UhfManager;
+import android.hardware.uhf.UhfReaderInfo;
+import android.hardware.uhf.UhfTag;
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+import android.util.Slog;
+
+import com.android.server.SystemService;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * The {@code system_server} half of UHF-SRS-001. Binder/permission/lifecycle plumbing and the
+ * per-session bookkeeping that only makes sense at this layer (stream parameters, stream
+ * statistics, UID ownership of a session token) live here; the actual reader policy — exclusivity,
+ * the antenna interlock, the power ceiling, streaming's mutual exclusion with everything else —
+ * lives in {@link UhfSessionArbiter}, kept deliberately unit-testable without a framework build
+ * (see {@code UhfSessionArbiterTest}). This class, and only this class, is where
+ * {@code android.hardware.uhf.*} Parcelable types get translated to and from the framework-
+ * independent types {@link UhfProtocol} and {@link UhfSessionArbiter} use — neither of those two
+ * classes imports anything under {@code android.hardware.uhf}, on purpose.
+ *
+ * <p>Per SRS §3.2's "phased alternative", Phase 1 talks to the reader through
+ * {@link UhfSerialTransport} directly from this process rather than through a vendor HAL — that
+ * boundary is exactly {@link UhfTransport}, so the eventual HAL-backed transport is a drop-in
+ * replacement here, not a rewrite.
+ */
+public final class UhfService extends SystemService {
+    private static final String TAG = "UhfService";
+    private static final String DEFAULT_READER_ID = "uhf0";
+
+    // Mirrors android.hardware.uhf.UhfException.ERROR_*. Services code must not import framework
+    // @SystemApi classes for their constants the way app code would; these are the same stable
+    // values by contract (§5.5), not by a shared reference across the layering boundary.
+    private static final int UHF_ERROR_BUSY = 8;
+    private static final int UHF_ERROR_DEVICE_LOST = 7;
+    private static final int UHF_ERROR_INVALID_PARAMETER = 5;
+
+    private final UhfSessionArbiter mArbiter;
+    private final ConcurrentHashMap<IBinder, SessionState> mSessions = new ConcurrentHashMap<>();
+    private final CopyOnWriteArrayList<IUhfStateCallback> mStateCallbacks =
+            new CopyOnWriteArrayList<>();
+
+    /** Everything about one open session that belongs at the Binder/framework layer, not in
+     * {@link UhfSessionArbiter} (which only knows about reader *mode*, not app-facing config or
+     * per-client statistics). */
+    private static final class SessionState {
+        final int ownerUid;
+        final IBinder clientToken;
+        final IBinder.DeathRecipient deathRecipient;
+        volatile StreamParams streamParams = new StreamParams.Builder().build();
+        final StreamStatsAccumulator stats = new StreamStatsAccumulator();
+
+        SessionState(int ownerUid, IBinder clientToken, IBinder.DeathRecipient deathRecipient) {
+            this.ownerUid = ownerUid;
+            this.clientToken = clientToken;
+            this.deathRecipient = deathRecipient;
+        }
+    }
+
+    /** FR-STR-10: tracks stats from the first delivered read, not from {@code startStreaming()};
+     * see {@link StreamStats}'s doc for why that distinction is load-bearing. */
+    private static final class StreamStatsAccumulator {
+        private final Set<String> uniqueEpcHex = new HashSet<>();
+        private long totalReadCount;
+        private long droppedBatchCount;
+        private long firstReadNanos = -1;
+
+        synchronized void onBatch(List<UhfTag> batch) {
+            if (firstReadNanos < 0 && !batch.isEmpty()) {
+                firstReadNanos = System.nanoTime();
+            }
+            for (UhfTag tag : batch) {
+                uniqueEpcHex.add(tag.getEpcHex());
+            }
+            totalReadCount += batch.size();
+        }
+
+        synchronized void onBatchDropped() {
+            droppedBatchCount++;
+        }
+
+        synchronized StreamStats snapshot() {
+            long elapsedMs = firstReadNanos < 0 ? 0 : (System.nanoTime() - firstReadNanos) / 1_000_000;
+            double rate = elapsedMs > 0 ? (totalReadCount * 1000.0 / elapsedMs) : 0.0;
+            return new StreamStats(uniqueEpcHex.size(), totalReadCount, rate, droppedBatchCount,
+                    elapsedMs);
+        }
+
+        /** Resets counters and the elapsed-time base together — see {@link StreamStats}'s doc on
+         * why resetting one without the other drifts the rate upward across repeated runs. */
+        synchronized void reset() {
+            uniqueEpcHex.clear();
+            totalReadCount = 0;
+            droppedBatchCount = 0;
+            firstReadNanos = -1;
+        }
+    }
+
+    public UhfService(Context context) {
+        super(context);
+        UhfTransport transport = new UhfSerialTransport();
+        SettingsRegionStore regionStore = new SettingsRegionStore(context);
+        mArbiter = new UhfSessionArbiter(transport, regionStore, (client, bandCode) ->
+                Slog.i(TAG, "region changed to band 0x" + Integer.toHexString(bandCode))); // FR-FRQ-04
+    }
+
+    @Override
+    public void onStart() {
+        publishBinderService(Context.UHF_SERVICE, new BinderService());
+    }
+
+    @Override
+    public void onBootPhase(int phase) {
+        if (phase != SystemService.PHASE_SYSTEM_SERVICES_READY) {
+            return;
+        }
+        // FR-LC-05/09: unconditional, before any client can possibly call openSession().
+        try {
+            mArbiter.performStartupReset();
+            broadcastState(UhfManager.STATE_READY);
+        } catch (UhfTransportException e) {
+            // No reader attached, or it didn't answer. Not fatal to boot — FR-LC-01 requires the
+            // service to be able to report "hardware present but unavailable" rather than take
+            // system_server down over an unplugged reader.
+            Slog.w(TAG, "startup reset failed; reader absent or unresponsive", e);
+            broadcastState(UhfManager.STATE_ABSENT);
+        }
+        // Hot-plug (attach/detach after boot) requires a uevent listener wired into
+        // UhfSerialTransport; not implemented in this scaffold (see its class doc) — FR-LC-06's
+        // 2-second delivery bound is therefore unverified until that lands, tracked alongside it.
+    }
+
+    private void broadcastState(int state) {
+        for (IUhfStateCallback cb : mStateCallbacks) {
+            try {
+                cb.onStateChanged(state);
+            } catch (RemoteException e) {
+                mStateCallbacks.remove(cb);
+            }
+        }
+    }
+
+    private final class BinderService extends IUhfService.Stub {
+
+        @Override
+        public boolean isReaderAvailable() {
+            return mArbiter.isTransportOpen();
+        }
+
+        @Override
+        public List<UhfDeviceInfo> getReaders() {
+            // FR-LC-02: this reader family exposes exactly one device per service instance in
+            // Phase 1; multi-reader enumeration is Phase 2+ (OI-06 is still open on whether a
+            // second reader model is even in scope).
+            if (!mArbiter.isTransportOpen()) {
+                return Collections.emptyList();
+            }
+            return Collections.singletonList(
+                    new UhfDeviceInfo(DEFAULT_READER_ID, UhfSerialTransport.DEVICE_PATH));
+        }
+
+        @Override
+        public IBinder openSession(String readerId, IBinder clientToken) {
+            enforceRead();
+            IBinder sessionToken = new Binder();
+            try {
+                mArbiter.openSession(sessionToken);
+            } catch (UhfSessionArbiter.UhfBusyException e) {
+                throw new ServiceSpecificException(
+                        UHF_ERROR_BUSY, "reader session already held by another caller");
+            }
+            int callingUid = Binder.getCallingUid();
+            IBinder.DeathRecipient recipient = () -> {
+                Slog.w(TAG, "client for session " + sessionToken + " died; releasing (FR-LC-04)");
+                mArbiter.onClientDied(sessionToken);
+                mSessions.remove(sessionToken);
+            };
+            try {
+                clientToken.linkToDeath(recipient, 0);
+            } catch (RemoteException e) {
+                // Client was already dead by the time we tried to link. Release immediately
+                // rather than leaving a session no one will ever close.
+                mArbiter.onClientDied(sessionToken);
+                throw new ServiceSpecificException(UHF_ERROR_DEVICE_LOST, "client died mid-open");
+            }
+            mSessions.put(sessionToken, new SessionState(callingUid, clientToken, recipient));
+            return sessionToken;
+        }
+
+        @Override
+        public void closeSession(IBinder sessionToken) {
+            SessionState state = requireOwnedSession(sessionToken);
+            state.clientToken.unlinkToDeath(state.deathRecipient, 0);
+            mArbiter.closeSession(sessionToken);
+            mSessions.remove(sessionToken);
+        }
+
+        @Override
+        public void registerStateCallback(IUhfStateCallback callback) {
+            mStateCallbacks.add(callback);
+        }
+
+        @Override
+        public void unregisterStateCallback(IUhfStateCallback callback) {
+            mStateCallbacks.remove(callback);
+        }
+
+        @Override
+        public UhfReaderInfo getReaderInfo(IBinder sessionToken) {
+            enforceRead();
+            requireOwnedSession(sessionToken);
+            UhfProtocol.ReaderInfo info = runTransport(() -> mArbiter.getReaderInfo(sessionToken));
+            UhfProtocol.BandPlan band = UhfProtocol.bandPlanForCode(info.bandCode);
+            return new UhfReaderInfo(
+                    info.firmwareVersionString(),
+                    info.modelType,
+                    info.supportsIso18000_6c,
+                    info.supportsIso18000_6b,
+                    info.bandCode,
+                    band != null ? band.name : "",
+                    band != null ? band.centerFrequencyMhz(0) : 0.0,
+                    band != null ? band.centerFrequencyMhz(band.maxN) : 0.0,
+                    info.maxRfPower,
+                    info.scanTimeUnits * 100,
+                    info.antennaMask,
+                    info.antennaCheckEnabled);
+        }
+
+        @Override
+        public void setRegion(IBinder sessionToken, int bandCode) {
+            enforceConfigure();
+            requireOwnedSession(sessionToken);
+            runTransportVoid(() -> mArbiter.setRegion(sessionToken, bandCode));
+        }
+
+        @Override
+        public void setRfPower(IBinder sessionToken, int power, boolean allowAboveSafeCeiling) {
+            enforceConfigure();
+            requireOwnedSession(sessionToken);
+            try {
+                mArbiter.setRfPower(sessionToken, power, allowAboveSafeCeiling);
+            } catch (IllegalArgumentException | UhfSessionArbiter.UhfSafetyCeilingExceededException e) {
+                throw new ServiceSpecificException(UHF_ERROR_INVALID_PARAMETER, e.getMessage());
+            } catch (UhfTransportException e) {
+                throw toServiceSpecificException(e);
+            }
+        }
+
+        @Override
+        public int getRfPower(IBinder sessionToken) {
+            enforceConfigure();
+            requireOwnedSession(sessionToken);
+            return mArbiter.getRfPower(sessionToken);
+        }
+
+        @Override
+        public int getSafeRfPowerCeiling(IBinder sessionToken) {
+            enforceConfigure(); // see getEnabledAntennas()'s note
+            requireOwnedSession(sessionToken);
+            return mArbiter.getSafePowerCeiling();
+        }
+
+        @Override
+        public void setEnabledAntennas(IBinder sessionToken, int mask) {
+            enforceConfigure();
+            requireOwnedSession(sessionToken);
+            runTransportVoid(() -> mArbiter.setEnabledAntennas(sessionToken, mask));
+        }
+
+        @Override
+        public int getEnabledAntennas(IBinder sessionToken) {
+            // §2.3: region/power/antenna is the OEM-integrator's surface (UHF_CONFIGURE), not a
+            // plain app's (UHF_READ) — an app calls inventory()/startStreaming() and gets tags
+            // without ever needing to introspect radio config. Consistent with getRfPower() and
+            // isAntennaCheckEnabled() below; a plain UHF_READ holder can read tags but not the
+            // reader's RF configuration.
+            enforceConfigure();
+            requireOwnedSession(sessionToken);
+            return mArbiter.getEnabledAntennas(sessionToken);
+        }
+
+        @Override
+        public void setAntennaCheckEnabled(IBinder sessionToken, boolean enabled) {
+            enforceConfigure();
+            requireOwnedSession(sessionToken);
+            runTransportVoid(() -> mArbiter.setAntennaCheckEnabled(sessionToken, enabled));
+        }
+
+        @Override
+        public boolean isAntennaCheckEnabled(IBinder sessionToken) {
+            enforceConfigure(); // see getEnabledAntennas()'s note
+            requireOwnedSession(sessionToken);
+            return mArbiter.isAntennaCheckEnabled(sessionToken);
+        }
+
+        @Override
+        public List<UhfTag> inventory(IBinder sessionToken, InventoryParams params) {
+            enforceRead();
+            requireOwnedSession(sessionToken);
+            List<UhfProtocol.TagRecord> records = runTransport(() -> mArbiter.inventory(
+                    sessionToken,
+                    params.getQValue(),
+                    params.getSession(),
+                    params.hasAntennaTargetScanTime(),
+                    params.getAntenna(),
+                    params.getTarget(),
+                    params.getScanTimeMs()));
+            List<UhfTag> tags = new ArrayList<>(records.size());
+            long now = System.nanoTime();
+            int reportedAntenna = params.hasAntennaTargetScanTime() ? params.getAntenna() : 0;
+            for (int i = 0; i < records.size(); i++) {
+                UhfProtocol.TagRecord r = records.get(i);
+                tags.add(new UhfTag(r.epc, r.tid, r.rssi, reportedAntenna, now, i));
+            }
+            return tags;
+        }
+
+        @Override
+        public void setStreamParams(IBinder sessionToken, StreamParams params) {
+            enforceRead();
+            SessionState state = requireOwnedSession(sessionToken);
+            state.streamParams = params; // FR-STR-08 applies it next time streaming (re)starts
+        }
+
+        @Override
+        public void startStreaming(IBinder sessionToken, IUhfTagCallback callback) {
+            enforceRead();
+            SessionState state = requireOwnedSession(sessionToken);
+            StreamParams params = state.streamParams;
+            runTransportVoid(() -> mArbiter.startStreaming(sessionToken,
+                    new UhfSessionArbiter.StreamRequest(params.getQValue(), params.getSession()),
+                    new BinderStreamCallback(callback, state.stats)));
+        }
+
+        @Override
+        public void stopStreaming(IBinder sessionToken) {
+            requireOwnedSession(sessionToken);
+            mArbiter.stopStreaming(sessionToken);
+        }
+
+        @Override
+        public boolean isStreaming(IBinder sessionToken) {
+            requireOwnedSession(sessionToken);
+            return mArbiter.isStreaming(sessionToken);
+        }
+
+        @Override
+        public StreamStats getStreamStats(IBinder sessionToken) {
+            SessionState state = requireOwnedSession(sessionToken);
+            return state.stats.snapshot();
+        }
+
+        @Override
+        public void resetStreamStats(IBinder sessionToken) {
+            SessionState state = requireOwnedSession(sessionToken);
+            state.stats.reset();
+        }
+
+        // -----------------------------------------------------------------------------------
+
+        private void enforceRead() {
+            getContext().enforceCallingOrSelfPermission(
+                    Manifest.permission.UHF_READ, "requires android.permission.UHF_READ");
+        }
+
+        private void enforceConfigure() {
+            getContext().enforceCallingOrSelfPermission(
+                    Manifest.permission.UHF_CONFIGURE, "requires android.permission.UHF_CONFIGURE");
+        }
+
+        /**
+         * FR-LC-03's exclusivity is enforced by {@link UhfSessionArbiter} itself (only the caller
+         * holding the token may act on it); this additionally enforces NFR-S-03 ("verify the
+         * session token belongs to the calling UID") — a Binder-identity concern the arbiter has
+         * no way to check on its own since it doesn't know about UIDs at all.
+         */
+        private SessionState requireOwnedSession(IBinder sessionToken) {
+            SessionState state = mSessions.get(sessionToken);
+            if (state == null || state.ownerUid != Binder.getCallingUid()) {
+                throw new ServiceSpecificException(
+                        UHF_ERROR_BUSY, "no open session for this caller");
+            }
+            return state;
+        }
+    }
+
+    /** Runs a transport-touching call, mapping {@link UhfTransportException} once, centrally. */
+    private interface TransportCall<T> {
+        T call() throws UhfTransportException;
+    }
+
+    private static <T> T runTransport(TransportCall<T> call) {
+        try {
+            return call.call();
+        } catch (UhfTransportException e) {
+            throw toServiceSpecificException(e);
+        }
+    }
+
+    private interface TransportVoidCall {
+        void call() throws UhfTransportException;
+    }
+
+    private static void runTransportVoid(TransportVoidCall call) {
+        try {
+            call.call();
+        } catch (UhfTransportException e) {
+            throw toServiceSpecificException(e);
+        }
+    }
+
+    private static ServiceSpecificException toServiceSpecificException(UhfTransportException e) {
+        return new ServiceSpecificException(e.getErrorCode(), e.getMessage());
+    }
+
+    private final class BinderStreamCallback implements UhfTransport.StreamCallback {
+        private final IUhfTagCallback mCallback;
+        private final StreamStatsAccumulator mStats;
+
+        BinderStreamCallback(IUhfTagCallback callback, StreamStatsAccumulator stats) {
+            mCallback = callback;
+            mStats = stats;
+        }
+
+        @Override
+        public void onTagBatch(byte[][] rawTagRecords) {
+            List<UhfTag> batch = new ArrayList<>(rawTagRecords.length);
+            long now = System.nanoTime();
+            for (byte[] raw : rawTagRecords) {
+                // Decoding raw frame bytes into UhfProtocol.TagRecord (and from there into
+                // UhfTag, as inventory() above does) happens in the pump-thread path this
+                // scaffold does not yet implement end-to-end — see UhfSerialTransport's class
+                // doc. Tracked as follow-up work, not part of this commit's tested surface.
+                batch.add(new UhfTag(raw, null, 0, 0, now, batch.size()));
+            }
+            mStats.onBatch(batch);
+            try {
+                mCallback.onTagsRead(batch);
+            } catch (RemoteException e) {
+                Slog.w(TAG, "client gone mid-stream", e);
+            }
+        }
+
+        @Override
+        public void onError(int transportErrorCode) {
+            // Note: this is a transport failure, not FR-STR-11's "client fell behind" case —
+            // that requires a bounded per-client delivery queue that drops whole batches under
+            // backpressure, which this scaffold does not implement yet (today, onTagBatch calls
+            // straight through to the oneway Binder callback with no queue in between, so there
+            // is nothing yet for StreamStatsAccumulator.onBatchDropped() to observe). Wiring that
+            // queue is follow-up work; leaving it unimplemented rather than half-modeling it here
+            // with a wrong trigger.
+            try {
+                mCallback.onStreamError(transportErrorCode, "transport error");
+            } catch (RemoteException e) {
+                Slog.w(TAG, "client gone mid-stream error", e);
+            }
+        }
+    }
+}
