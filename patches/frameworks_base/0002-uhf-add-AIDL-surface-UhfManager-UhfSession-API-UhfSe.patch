+package android.hardware.uhf;
+
+import android.hardware.uhf.IUhfStateCallback;
+import android.hardware.uhf.IUhfTagCallback;
+import android.hardware.uhf.InventoryParams;
+import android.hardware.uhf.StreamParams;
+import android.hardware.uhf.StreamStats;
+import android.hardware.uhf.UhfDeviceInfo;
+import android.hardware.uhf.UhfReaderInfo;
+import android.hardware.uhf.UhfTag;
+
+/**
+ * Binder interface behind {@code UhfManager}/{@code UhfSession}, implemented by
+ * {@code com.android.server.uhf.UhfService}. UHF-SRS-001 Phase 1 scope only (§4.1-4.8); tag
+ * memory/security/protection/EAS/peripherals/diagnostics (§4.9-4.16) are added in later phases
+ * without needing to change any method declared here.
+ *
+ * <p>Every non-oneway method here may throw {@link android.os.ServiceSpecificException} with one
+ * of {@code UhfException.ERROR_*} as its code; {@code UhfManager}/{@code UhfSession} catch it and
+ * rethrow as {@code UhfException} so app code never sees a raw Binder exception. A method that
+ * needs a session throws {@code ERROR_BUSY} if {@code sessionToken} does not identify a session
+ * this caller's UID currently holds — including if it never held one, or held one that has since
+ * been closed.
+ *
+ * @hide
+ */
+interface IUhfService {
+    // ---- §4.1 Lifecycle and connection ----
+
+    boolean isReaderAvailable();
+
+    List<UhfDeviceInfo> getReaders();
+
+    /**
+     * Opens an exclusive session (FR-LC-03). {@code clientToken} is the caller's own token, used
+     * solely so the service can register a death recipient (FR-LC-04); the returned {@link
+     * IBinder} is a distinct, service-minted session token the caller passes to every other
+     * method here.
+     */
+    IBinder openSession(in String readerId, IBinder clientToken);
+
+    void closeSession(IBinder sessionToken);
+
+    void registerStateCallback(IUhfStateCallback callback);
+
+    void unregisterStateCallback(IUhfStateCallback callback);
+
+    // ---- §4.2 Reader identity ----
+
+    UhfReaderInfo getReaderInfo(IBinder sessionToken);
+
+    // ---- §4.4 Region ----
+
+    void setRegion(IBinder sessionToken, int bandCode);
+
+    // ---- §4.5 RF power ----
+
+    void setRfPower(IBinder sessionToken, int power, boolean allowAboveSafeCeiling);
+
+    int getRfPower(IBinder sessionToken);
+
+    int getSafeRfPowerCeiling(IBinder sessionToken);
+
+    // ---- §4.6 Antennas ----
+
+    void setEnabledAntennas(IBinder sessionToken, int mask);
+
+    int getEnabledAntennas(IBinder sessionToken);
+
+    void setAntennaCheckEnabled(IBinder sessionToken, boolean enabled);
+
+    boolean isAntennaCheckEnabled(IBinder sessionToken);
+
+    // ---- §4.7 Polled inventory ----
+
+    List<UhfTag> inventory(IBinder sessionToken, in InventoryParams params);
+
+    // ---- §4.8 Streaming ----
+
+    void setStreamParams(IBinder sessionToken, in StreamParams params);
+
+    void startStreaming(IBinder sessionToken, IUhfTagCallback callback);
+
+    void stopStreaming(IBinder sessionToken);
+
+    boolean isStreaming(IBinder sessionToken);
+
+    StreamStats getStreamStats(IBinder sessionToken);
+
+    void resetStreamStats(IBinder sessionToken);
+}
