+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.SystemApi;
+
+import java.util.List;
+
+/**
+ * Receives batches from {@link UhfSession#startStreaming}. Every method is invoked on the
+ * {@link java.util.concurrent.Executor} passed to {@code startStreaming}, never on a Binder
+ * thread directly.
+ *
+ * @hide
+ */
+@SystemApi
+public interface TagCallback {
+    /** One batch, per UHF-SRS-001 §3.3's batching rule — never one call per tag. */
+    void onTagsRead(@NonNull List<UhfTag> batch);
+
+    /** The stream ended abnormally; see {@link UhfException} for {@code errorCode}'s meaning. */
+    void onStreamError(int errorCode, @NonNull String message);
+
+    /** FR-STR-11: this many whole batches were dropped because this app fell behind. */
+    void onBatchesDropped(int count);
+}
