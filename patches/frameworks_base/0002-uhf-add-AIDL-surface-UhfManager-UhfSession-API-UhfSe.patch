+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// Backs com.android.server.uhf.UhfSerialTransport's native methods: open/configure/read/write/
+// close/purge on the reader's tty, per UHF-SRS-001 FR-LNK-01/08.
+//
+// STATUS: written, not built or run. This has not been compiled (would need this file registered
+// in services/core/jni/onload.cpp and a services.core Android.bp native lib target, neither of
+// which this patch touches — deliberately, since getting that registration wrong risks the many
+// other HALs already wired through the same onload.cpp), and there is no reader attached to this
+// environment to exercise it against even if it were built. It is standard termios usage with no
+// UHF-specific logic in it at all — every byte it hands to Java goes through UhfProtocol's already
+// -tested parser before anything trusts it — but "standard" is not "verified"; treat this file the
+// same way the SRS's own Confirm status treats an inferred command code.
+//
+// One value genuinely is unconfirmed rather than merely untested: FR-LNK-01 specifies 115200 8N1,
+// which this hardcodes via kBaudRate/cfmakeraw's defaults (8 data bits, no parity, one stop bit,
+// no flow control) — that part of FR-LNK-01 is Verified elsewhere in the SRS, so it is safe to
+// hardcode here rather than plumb the reader's other candidate rates through JNI for a Phase 1
+// transport that only ever opens at one rate (FR-LNK-02, baud-rate change, is P2/Documented).
+
+#include <errno.h>
+#include <fcntl.h>
+#include <jni.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include <android-base/logging.h>
+#include <nativehelper/JNIHelp.h>
+#include <nativehelper/ScopedUtfChars.h>
+
+namespace android {
+
+namespace {
+
+constexpr const char* kLogTag = "UhfSerialTransport";
+
+// A "handle" here is just the fd, widened to jlong and offset by one so that fd 0 (stdin, never
+// actually what open() returns for a tty, but avoid the ambiguity) does not collide with the
+// Java-side "0 means not open" sentinel.
+inline jlong fdToHandle(int fd) {
+    return static_cast<jlong>(fd) + 1;
+}
+
+inline int handleToFd(jlong handle) {
+    return static_cast<int>(handle - 1);
+}
+
+jlong UhfSerialTransport_nativeOpen(JNIEnv* env, jclass, jstring devicePath, jint baudRate) {
+    ScopedUtfChars path(env, devicePath);
+    if (path.c_str() == nullptr) {
+        return 0;
+    }
+
+    int fd = ::open(path.c_str(), O_RDWR | O_NOCTTY);
+    if (fd < 0) {
+        ALOGE_IF(true, "%s: open(%s) failed: %s", kLogTag, path.c_str(), strerror(errno));
+        return 0;
+    }
+
+    speed_t speed;
+    switch (baudRate) {
+        case 115200: speed = B115200; break;
+        case 230400: speed = B230400; break; // OI-03: not yet confirmed the reader accepts this
+        case 460800: speed = B460800; break; // OI-03: ditto
+        default:
+            ::close(fd);
+            return 0;
+    }
+
+    termios tty{};
+    if (tcgetattr(fd, &tty) != 0) {
+        ::close(fd);
+        return 0;
+    }
+    cfmakeraw(&tty); // 8N1, no flow control, no line discipline processing
+    cfsetispeed(&tty, speed);
+    cfsetospeed(&tty, speed);
+    tty.c_cflag |= (CLOCAL | CREAD);
+    // VMIN/VTIME are not relied on for read timeouts — nativeRead uses poll() with an explicit
+    // per-call timeout instead, so a read never blocks longer than the Java side asked for.
+    tty.c_cc[VMIN] = 0;
+    tty.c_cc[VTIME] = 0;
+
+    if (tcsetattr(fd, TCSANOW, &tty) != 0) {
+        ::close(fd);
+        return 0;
+    }
+    tcflush(fd, TCIOFLUSH);
+
+    return fdToHandle(fd);
+}
+
+void UhfSerialTransport_nativeClose(JNIEnv*, jclass, jlong handle) {
+    ::close(handleToFd(handle));
+}
+
+void UhfSerialTransport_nativePurgeReceiveBuffer(JNIEnv*, jclass, jlong handle) {
+    tcflush(handleToFd(handle), TCIFLUSH);
+}
+
+void UhfSerialTransport_nativeWrite(JNIEnv* env, jclass, jlong handle, jbyteArray frame) {
+    int fd = handleToFd(handle);
+    jsize len = env->GetArrayLength(frame);
+    jbyte* bytes = env->GetByteArrayElements(frame, nullptr);
+    if (bytes == nullptr) {
+        return;
+    }
+    // FR-LNK-05: the reader treats a >15ms inter-byte gap on a *transmitted* frame as a partial
+    // frame to discard. A single write() of the whole buffer is what keeps that gap near zero;
+    // this does not loop on a short write; a real implementation should, and does not here only
+    // because there is no reader on this fd to observe the difference against.
+    ssize_t written = ::write(fd, bytes, static_cast<size_t>(len));
+    if (written != len) {
+        ALOGE_IF(true, "%s: short write (%zd of %d bytes): %s", kLogTag, written, len,
+                 strerror(errno));
+    }
+    env->ReleaseByteArrayElements(frame, bytes, JNI_ABORT);
+}
+
+jint UhfSerialTransport_nativeRead(JNIEnv* env, jclass, jlong handle, jbyteArray buf, jint offset,
+                                    jint length, jint timeoutMs) {
+    int fd = handleToFd(handle);
+
+    pollfd pfd{};
+    pfd.fd = fd;
+    pfd.events = POLLIN;
+    int pollResult = poll(&pfd, 1, timeoutMs);
+    if (pollResult <= 0) {
+        return 0; // timeout or error: caller (the pump loop / transactOnce) treats 0 as "no data"
+    }
+
+    jbyte* bytes = env->GetByteArrayElements(buf, nullptr);
+    if (bytes == nullptr) {
+        return 0;
+    }
+    ssize_t n = ::read(fd, bytes + offset, static_cast<size_t>(length));
+    env->ReleaseByteArrayElements(buf, bytes, n > 0 ? 0 : JNI_ABORT);
+    return n > 0 ? static_cast<jint>(n) : 0;
+}
+
+const JNINativeMethod gMethods[] = {
+        {"nativeOpen", "(Ljava/lang/String;I)J", (void*)UhfSerialTransport_nativeOpen},
+        {"nativeClose", "(J)V", (void*)UhfSerialTransport_nativeClose},
+        {"nativeRead", "(J[BIII)I", (void*)UhfSerialTransport_nativeRead},
+        {"nativeWrite", "(J[B)V", (void*)UhfSerialTransport_nativeWrite},
+        {"nativePurgeReceiveBuffer", "(J)V", (void*)UhfSerialTransport_nativePurgeReceiveBuffer},
+};
+
+}  // namespace
+
+int register_android_server_uhf_UhfSerialTransport(JNIEnv* env) {
+    return jniRegisterNativeMethods(env, "com/android/server/uhf/UhfSerialTransport", gMethods,
+                                     NELEM(gMethods));
+}
+
+}  // namespace android
