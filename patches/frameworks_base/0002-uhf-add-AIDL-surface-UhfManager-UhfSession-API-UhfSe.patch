new file mode 100644
index 00000000..77e53373
--- /dev/null
+++ b/services/core/java/com/android/server/uhf/SettingsRegionStore.java
@@ -0,0 +1,55 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.uhf;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.provider.Settings;
+
+/**
+ * FR-LC-09's persistence: the last successfully applied regulatory region, stored in
+ * {@link Settings.Global} rather than read back from the reader. Deliberately not a per-user
+ * setting — a UHF reader is board-level hardware regulated per device, not per {@code Settings}
+ * user profile, the same reasoning {@code Settings.Global} itself documents for its other
+ * hardware-level entries.
+ *
+ * <p>The default (EU, band code {@code 0b0100}) matches the development unit this SRS was
+ * written against (§1's meta line, §4.4's table). A real product build overrides it with the
+ * region resource {@code config_uhfDefaultRegion} (SRS §8.1 row 17) rather than hardcoding a
+ * different literal here — this class only supplies the fallback for a factory-fresh device that
+ * has never had a region explicitly set.
+ */
+final class SettingsRegionStore implements UhfSessionArbiter.RegionStore {
+    private static final String KEY_REGION_BAND_CODE = "uhf_region_band_code";
+    private static final int DEFAULT_BAND_CODE = 0b0100; // EU
+
+    private final ContentResolver mResolver;
+
+    SettingsRegionStore(Context context) {
+        mResolver = context.getContentResolver();
+    }
+
+    @Override
+    public int getPersistedRegionCode() {
+        return Settings.Global.getInt(mResolver, KEY_REGION_BAND_CODE, DEFAULT_BAND_CODE);
+    }
+
+    @Override
+    public void setPersistedRegionCode(int bandCode) {
+        Settings.Global.putInt(mResolver, KEY_REGION_BAND_CODE, bandCode);
+    }
+}
diff --git a/services/core/java/com/android/server/uhf/UhfSerialTransport.java b/services/core/java/com/android/server/uhf/UhfSerialTransport.java
new file mode 100644
index 00000000..be002583
--- /dev/null
+++ b/services/core/java/com/android/server/uhf/UhfSerialTransport.java
@@ -0,0 +1,322 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.uhf;
+
+import android.util.Slog;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.locks.ReentrantLock;
+
+/**
+ * Phase 1's "JNI transport" from SRS §3.2: {@code UhfService} opens {@code /dev/ttyUSB*} directly
+ * from {@code system_server} through this class rather than through a vendor HAL. It is the one
+ * piece of this patch series that genuinely cannot be verified in this environment — there is no
+ * reader attached here, so nothing below has run against real hardware or even a real tty. What
+ * <em>can</em> be, and is, verified: the frame assembly and resync logic the pump loop calls
+ * ({@link UhfProtocol#scan}/{@link UhfProtocol#scanWithStallRecovery}) is the same code exercised
+ * by {@code UhfProtocolTest}'s 37 cases — this class's job is narrowly to get bytes on and off the
+ * wire and hand them to that already-tested logic, not to reimplement any of it.
+ *
+ * <p>Everything reader-transaction-shaped funnels through {@link #transact}, called with the
+ * arbiter's lock held (see {@link UhfSessionArbiter}'s class doc on why every public method there
+ * is {@code synchronized}) — so this class does not need its own transaction-level locking, only
+ * {@link #mIoLock} guarding the native handle against a concurrent {@link #close()}.
+ */
+final class UhfSerialTransport implements UhfTransport {
+    private static final String TAG = "UhfSerialTransport";
+
+    /** FR-LNK-07's OI-05 companion: this is the interim, unnarrowed match (SRS §8.2 Rev B note).
+     * A real device may have more than one {@code ttyUSB*}; Phase 1 assumes this is the only one,
+     * consistent with the interim ueventd rule matching every {@code ttyUSB*} on this product. */
+    static final String DEVICE_PATH = "/dev/ttyUSB0";
+
+    private static final int BAUD_RATE = 115200; // FR-LNK-01
+    private static final int READ_TIMEOUT_MS = 500;
+    private static final int MAX_TRANSACT_RETRIES = 2;
+
+    static {
+        // Unverified in this environment: no build of libuhf_jni has been attempted here (would
+        // require `m` against the full framework, per this patch series' cover note). The
+        // Android.bp target this expects is added alongside this file; see its comment for what
+        // is and is not confirmed about it.
+        System.loadLibrary("uhf_jni");
+    }
+
+    private final ReentrantLock mIoLock = new ReentrantLock();
+    private long mNativeHandle; // 0 == not open
+    private volatile boolean mStreaming;
+    private Thread mPumpThread;
+
+    @Override
+    public void open() throws UhfTransportException {
+        mIoLock.lock();
+        try {
+            if (mNativeHandle != 0) {
+                return; // already open; open() is idempotent per the UhfTransport contract
+            }
+            long handle = nativeOpen(DEVICE_PATH, BAUD_RATE);
+            if (handle == 0) {
+                throw new UhfTransportException(
+                        UhfProtocol.ERROR_DEVICE_LOST, "failed to open " + DEVICE_PATH);
+            }
+            mNativeHandle = handle;
+        } finally {
+            mIoLock.unlock();
+        }
+    }
+
+    @Override
+    public void close() {
+        mIoLock.lock();
+        try {
+            if (mNativeHandle == 0) {
+                return;
+            }
+            stopStream();
+            nativeClose(mNativeHandle);
+            mNativeHandle = 0;
+        } finally {
+            mIoLock.unlock();
+        }
+    }
+
+    @Override
+    public boolean isOpen() {
+        mIoLock.lock();
+        try {
+            return mNativeHandle != 0;
+        } finally {
+            mIoLock.unlock();
+        }
+    }
+
+    @Override
+    public byte[] transact(int command, byte[] payload, int timeoutMs)
+            throws UhfTransportException {
+        byte[] frame = UhfProtocol.buildFrame(UhfProtocol.ADDRESS_BROADCAST, command, payload);
+        UhfTransportException lastFailure = null;
+        for (int attempt = 0; attempt <= MAX_TRANSACT_RETRIES; attempt++) {
+            try {
+                return transactOnce(frame, command, timeoutMs);
+            } catch (UhfTransportException e) {
+                lastFailure = e;
+                if (e.getErrorCode() != UhfProtocol.ERROR_TIMEOUT) {
+                    throw e; // only a timeout is worth retrying; a mapped reader error is final
+                }
+            }
+        }
+        throw lastFailure;
+    }
+
+    private byte[] transactOnce(byte[] frame, int expectedCommand, int timeoutMs)
+            throws UhfTransportException {
+        mIoLock.lock();
+        try {
+            requireOpen();
+            nativePurgeReceiveBuffer(mNativeHandle); // FR-LNK-08
+            nativeWrite(mNativeHandle, frame);
+
+            List<byte[]> multiFrameData = new ArrayList<>();
+            byte[] buf = new byte[4096];
+            int len = 0;
+            long deadline = System.nanoTime() + timeoutMs * 1_000_000L;
+            long lastByteAt = System.nanoTime();
+
+            while (System.nanoTime() < deadline) {
+                int n = nativeRead(mNativeHandle, buf, len, buf.length - len,
+                        (int) Math.min(READ_TIMEOUT_MS, (deadline - System.nanoTime()) / 1_000_000));
+                if (n > 0) {
+                    len += n;
+                    lastByteAt = System.nanoTime();
+                }
+                boolean stale = (System.nanoTime() - lastByteAt) > FR_LNK_05_INTER_BYTE_GAP_NANOS;
+
+                int offset = 0;
+                while (offset < len) {
+                    UhfProtocol.ScanResult r =
+                            UhfProtocol.scanWithStallRecovery(buf, offset, len - offset, stale);
+                    if (r.outcome == UhfProtocol.ScanOutcome.NEED_MORE_DATA) {
+                        break;
+                    }
+                    if (r.outcome == UhfProtocol.ScanOutcome.RESYNC) {
+                        offset += r.bytesToDiscard;
+                        continue;
+                    }
+                    // FRAME
+                    offset += r.frame.wireLength;
+                    if (!UhfProtocol.reCmdMatches(r.frame, expectedCommand)) {
+                        continue; // FR-LNK-06: e.g. an interleaved 0xEE real-time tag frame
+                    }
+                    int status = r.frame.data.length > 0
+                            ? (r.frame.data[0] & 0xFF) : UhfProtocol.STATUS_INVENTORY_COMPLETE;
+                    multiFrameData.add(r.frame.data);
+                    if (status != UhfProtocol.STATUS_MORE_FRAMES_FOLLOW) {
+                        return concat(multiFrameData); // FR-INV-02: caller sees the assembled reply
+                    }
+                    // else: FR-INV-02, keep collecting frames for this same reCmd.
+                }
+                // Compact unconsumed bytes to the front of buf for the next read.
+                if (offset > 0) {
+                    System.arraycopy(buf, offset, buf, 0, len - offset);
+                    len -= offset;
+                }
+            }
+            throw new UhfTransportException(UhfProtocol.ERROR_TIMEOUT,
+                    "no matching reply to 0x" + Integer.toHexString(expectedCommand)
+                            + " within " + timeoutMs + "ms");
+        } finally {
+            mIoLock.unlock();
+        }
+    }
+
+    private static final long FR_LNK_05_INTER_BYTE_GAP_NANOS = 15_000_000L; // 15ms
+
+    private static byte[] concat(List<byte[]> parts) {
+        int total = 0;
+        for (byte[] p : parts) total += p.length;
+        byte[] out = new byte[total];
+        int pos = 0;
+        for (byte[] p : parts) {
+            System.arraycopy(p, 0, out, pos, p.length);
+            pos += p.length;
+        }
+        return out;
+    }
+
+    @Override
+    public void startStream(StreamCallback callback) throws UhfTransportException {
+        mIoLock.lock();
+        try {
+            requireOpen();
+            if (mStreaming) {
+                return;
+            }
+            byte[] enterRealtime = UhfProtocol.buildFrame(
+                    UhfProtocol.ADDRESS_BROADCAST, 0x76, new byte[] {0x01});
+            nativeWrite(mNativeHandle, enterRealtime);
+            mStreaming = true;
+            mPumpThread = new Thread(() -> pumpLoop(callback), "UhfStreamPump");
+            mPumpThread.start();
+        } finally {
+            mIoLock.unlock();
+        }
+    }
+
+    @Override
+    public void stopStream() {
+        if (!mStreaming) {
+            return;
+        }
+        mStreaming = false; // pump thread observes this and exits its loop
+        // FR-STR-07: retry the stop frame and confirm quiet before returning. This scaffold sends
+        // it once and joins the pump thread; the retry-and-verify loop the requirement actually
+        // asks for needs a live reader to validate the "confirm quiet" half against, so it is
+        // deliberately left as a documented gap rather than an unverified retry count.
+        try {
+            if (mNativeHandle != 0) {
+                nativeWrite(mNativeHandle,
+                        UhfProtocol.buildFrame(UhfProtocol.ADDRESS_BROADCAST, 0x76,
+                                new byte[] {0x00}));
+            }
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "failed to send stop-streaming frame", e);
+        }
+        Thread pump = mPumpThread;
+        if (pump != null) {
+            try {
+                pump.join(1000);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+        }
+        mPumpThread = null;
+    }
+
+    private void pumpLoop(StreamCallback callback) {
+        byte[] buf = new byte[4096];
+        int len = 0;
+        long lastByteAt = System.nanoTime();
+        while (mStreaming) {
+            int n;
+            try {
+                n = nativeRead(mNativeHandle, buf, len, buf.length - len, READ_TIMEOUT_MS);
+            } catch (RuntimeException e) {
+                callback.onError(UhfProtocol.ERROR_DEVICE_LOST);
+                return;
+            }
+            if (n > 0) {
+                len += n;
+                lastByteAt = System.nanoTime();
+            }
+            boolean stale = (System.nanoTime() - lastByteAt) > FR_LNK_05_INTER_BYTE_GAP_NANOS;
+
+            List<byte[]> batch = new ArrayList<>();
+            int offset = 0;
+            while (offset < len) {
+                UhfProtocol.ScanResult r =
+                        UhfProtocol.scanWithStallRecovery(buf, offset, len - offset, stale);
+                if (r.outcome == UhfProtocol.ScanOutcome.NEED_MORE_DATA) {
+                    break;
+                }
+                if (r.outcome == UhfProtocol.ScanOutcome.RESYNC) {
+                    offset += r.bytesToDiscard;
+                    continue;
+                }
+                offset += r.frame.wireLength;
+                if (r.frame.command == 0xEE) { // real-time tag frame; see UHF-SRS-001 §1.3
+                    batch.add(r.frame.data);
+                }
+            }
+            if (offset > 0) {
+                System.arraycopy(buf, offset, buf, 0, len - offset);
+                len -= offset;
+            }
+            if (!batch.isEmpty()) {
+                callback.onTagBatch(batch.toArray(new byte[0][]));
+            }
+        }
+    }
+
+    private void requireOpen() throws UhfTransportException {
+        if (mNativeHandle == 0) {
+            throw new UhfTransportException(UhfProtocol.ERROR_DEVICE_LOST, "transport not open");
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Native methods. Implemented by libuhf_jni (jni/uhf_serial_jni.cpp); see that file's header
+    // comment for exactly what is and is not confirmed about it — in short, it is a standard
+    // termios open/configure/read/write/close, structurally complete but never linked, loaded, or
+    // run in this environment.
+    // ---------------------------------------------------------------------------------------
+
+    /** @return an opaque non-zero handle, or 0 on failure. */
+    private static native long nativeOpen(String devicePath, int baudRate);
+
+    private static native void nativeClose(long handle);
+
+    /** @return the number of bytes read into {@code buf[offset..offset+length)}, or 0 on a read
+     * timeout; never blocks past {@code timeoutMs}. */
+    private static native int nativeRead(long handle, byte[] buf, int offset, int length,
+            int timeoutMs);
+
+    private static native void nativeWrite(long handle, byte[] frame);
+
+    /** FR-LNK-08: discard any bytes already buffered by the kernel driver before a transaction. */
+    private static native void nativePurgeReceiveBuffer(long handle);
+}
