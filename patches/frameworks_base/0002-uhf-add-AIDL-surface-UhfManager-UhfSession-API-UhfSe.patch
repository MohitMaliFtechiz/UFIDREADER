+
+package android.hardware.uhf;
+
+import android.hardware.uhf.UhfTag;
+
+/**
+ * Streaming tag delivery, from {@code UhfService} to one {@code UhfManager} client.
+ *
+ * {@code oneway}: per UHF-SRS-001 §3.3, the HAL pump thread must never block on a slow client, and
+ * {@code UhfService}'s dispatch to each registered client must not block on any other client
+ * either. A one-way callback is what makes that true at the Binder layer; {@code UhfService} is
+ * still responsible for FR-STR-11 (dropping whole batches for a client that cannot keep up) since
+ * {@code oneway} alone only prevents blocking, not unbounded queuing.
+ *
+ * @hide
+ */
+oneway interface IUhfTagCallback {
+    /** One batch of tag reads, per UHF-SRS-001 §3.3's 50ms/64-tag batching rule. */
+    void onTagsRead(in List<UhfTag> batch);
+
+    /** The stream ended abnormally; {@code errorCode} is one of {@code UhfException.ERROR_*}. */
+    void onStreamError(int errorCode, String message);
+
+    /** FR-STR-11: this many whole batches were dropped because this client fell behind. */
+    void onBatchesDropped(int count);
+}
diff --git a/core/java/android/hardware/uhf/InventoryParams.java b/core/java/android/hardware/uhf/InventoryParams.java
new file mode 100644
index 00000000..b745d87f
--- /dev/null
