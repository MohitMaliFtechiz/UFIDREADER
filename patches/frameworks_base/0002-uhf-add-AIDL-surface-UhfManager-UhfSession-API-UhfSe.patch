+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.annotation.SystemApi;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * One tag sighting: the result of {@link UhfSession#inventory()} or one entry in an
+ * {@code onTagsRead} batch. Per UHF-SRS-001's Definitions (§1.3): a tag seen ten times yields ten
+ * {@code UhfTag} reads and one unique EPC — this class deliberately does not deduplicate; that is
+ * {@code UhfSession.setStreamParams(StreamParams.Builder#setUniqueOnly)}'s job, applied in the
+ * framework, not silently baked into every read.
+ *
+ * @hide
+ */
+@SystemApi
+public final class UhfTag implements Parcelable {
+    private final byte[] mEpc;
+    private final byte[] mTid; // may be empty; getTid() returns null in that case
+    private final int mRssi;
+    private final int mAntenna;
+    private final long mTimestampNanos;
+    private final int mReadCount;
+
+    /** @hide */
+    public UhfTag(@NonNull byte[] epc, @Nullable byte[] tid, int rssi, int antenna,
+            long timestampNanos, int readCount) {
+        mEpc = epc;
+        mTid = tid;
+        mRssi = rssi;
+        mAntenna = antenna;
+        mTimestampNanos = timestampNanos;
+        mReadCount = readCount;
+    }
+
+    @NonNull
+    public byte[] getEpc() {
+        return mEpc;
+    }
+
+    @NonNull
+    public String getEpcHex() {
+        StringBuilder sb = new StringBuilder(mEpc.length * 2);
+        for (byte b : mEpc) {
+            sb.append(String.format("%02X", b));
+        }
+        return sb.toString();
+    }
+
+    /** Non-null only when FastID / EPC+TID inventory was requested and the tag supplied one. */
+    @Nullable
+    public byte[] getTid() {
+        return (mTid == null || mTid.length == 0) ? null : mTid;
+    }
+
+    public int getRssi() {
+        return mRssi;
+    }
+
+    /** The antenna port (1-4) that reported this sighting. */
+    public int getAntenna() {
+        return mAntenna;
+    }
+
+    public long getTimestampNanos() {
+        return mTimestampNanos;
+    }
+
+    /** This tag's ordinal position within the batch that delivered it; not a running total. */
+    public int getReadCount() {
+        return mReadCount;
+    }
+
+    private UhfTag(Parcel in) {
+        mEpc = in.createByteArray();
+        mTid = in.createByteArray();
+        mRssi = in.readInt();
+        mAntenna = in.readInt();
+        mTimestampNanos = in.readLong();
+        mReadCount = in.readInt();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeByteArray(mEpc);
+        dest.writeByteArray(mTid);
+        dest.writeInt(mRssi);
+        dest.writeInt(mAntenna);
+        dest.writeLong(mTimestampNanos);
+        dest.writeInt(mReadCount);
+    }
+
+    @NonNull
+    public static final Creator<UhfTag> CREATOR = new Creator<UhfTag>() {
+        @Override
+        public UhfTag createFromParcel(Parcel in) {
+            return new UhfTag(in);
+        }
+
+        @Override
+        public UhfTag[] newArray(int size) {
+            return new UhfTag[size];
+        }
+    };
+}
