+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * Parameters for {@link UhfSession#setStreamParams} / {@link UhfSession#startStreaming}
+ * (FR-STR-03/04/05). Deliberately has no scan-time field: FR-STR-12 / the §2.4 measured note
+ * ("scan time has no effect in real-time mode") means offering one here would document a knob
+ * that does nothing.
+ *
+ * @hide
+ */
+@SystemApi
+public final class StreamParams implements Parcelable {
+    private final int mReadPauseMs;
+    private final int mFilterTimeMs;
+    private final int mQValue;
+    private final int mSession;
+    private final int mBatchWindowMs;
+    private final int mMaxBatchSize;
+    private final boolean mUniqueOnly;
+
+    private StreamParams(Builder b) {
+        mReadPauseMs = b.mReadPauseMs;
+        mFilterTimeMs = b.mFilterTimeMs;
+        mQValue = b.mQValue;
+        mSession = b.mSession;
+        mBatchWindowMs = b.mBatchWindowMs;
+        mMaxBatchSize = b.mMaxBatchSize;
+        mUniqueOnly = b.mUniqueOnly;
+    }
+
+    public int getReadPauseMs() {
+        return mReadPauseMs;
+    }
+
+    /** FR-STR-05: 0 (the default) reports every sighting; enabling filtering is an explicit choice. */
+    public int getFilterTimeMs() {
+        return mFilterTimeMs;
+    }
+
+    public int getQValue() {
+        return mQValue;
+    }
+
+    public int getSession() {
+        return mSession;
+    }
+
+    /** FR-STR-03: the batch flushes on whichever of this or {@link #getMaxBatchSize()} is first. */
+    public int getBatchWindowMs() {
+        return mBatchWindowMs;
+    }
+
+    public int getMaxBatchSize() {
+        return mMaxBatchSize;
+    }
+
+    /** FR-STR-09: framework-side dedup by first-sighting-per-EPC, not the reader's own filter. */
+    public boolean isUniqueOnly() {
+        return mUniqueOnly;
+    }
+
+    /** Builder for {@link StreamParams}. */
+    public static final class Builder {
+        private int mReadPauseMs = 0;
+        private int mFilterTimeMs = 0;
+        private int mQValue = 4;
+        private int mSession = InventoryParams.SESSION_S0;
+        private int mBatchWindowMs = 50;
+        private int mMaxBatchSize = 64;
+        private boolean mUniqueOnly = false;
+
+        @NonNull
+        public Builder setReadPauseMs(int ms) {
+            requireNonNegative(ms, "readPauseMs");
+            mReadPauseMs = ms;
+            return this;
+        }
+
+        @NonNull
+        public Builder setFilterTimeMs(int ms) {
+            requireNonNegative(ms, "filterTimeMs");
+            mFilterTimeMs = ms;
+            return this;
+        }
+
+        @NonNull
+        public Builder setQValue(int q) {
+            if (q < 0 || q > 15) {
+                throw new IllegalArgumentException("qValue " + q + " outside [0,15]");
+            }
+            mQValue = q;
+            return this;
+        }
+
+        @NonNull
+        public Builder setSession(int session) {
+            mSession = session;
+            return this;
+        }
+
+        @NonNull
+        public Builder setBatchWindowMs(int ms) {
+            if (ms <= 0) {
+                throw new IllegalArgumentException("batchWindowMs must be positive, was " + ms);
+            }
+            mBatchWindowMs = ms;
+            return this;
+        }
+
+        @NonNull
+        public Builder setMaxBatchSize(int n) {
+            if (n <= 0) {
+                throw new IllegalArgumentException("maxBatchSize must be positive, was " + n);
+            }
+            mMaxBatchSize = n;
+            return this;
+        }
+
+        @NonNull
+        public Builder setUniqueOnly(boolean uniqueOnly) {
+            mUniqueOnly = uniqueOnly;
+            return this;
+        }
+
+        @NonNull
+        public StreamParams build() {
+            return new StreamParams(this);
+        }
+
+        private static void requireNonNegative(int value, String name) {
+            if (value < 0) {
+                throw new IllegalArgumentException(name + " must be >= 0, was " + value);
+            }
+        }
+    }
+
+    private StreamParams(Parcel in) {
+        mReadPauseMs = in.readInt();
+        mFilterTimeMs = in.readInt();
+        mQValue = in.readInt();
+        mSession = in.readInt();
+        mBatchWindowMs = in.readInt();
+        mMaxBatchSize = in.readInt();
+        mUniqueOnly = in.readBoolean();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeInt(mReadPauseMs);
+        dest.writeInt(mFilterTimeMs);
+        dest.writeInt(mQValue);
+        dest.writeInt(mSession);
+        dest.writeInt(mBatchWindowMs);
+        dest.writeInt(mMaxBatchSize);
+        dest.writeBoolean(mUniqueOnly);
+    }
+
+    @NonNull
+    public static final Creator<StreamParams> CREATOR = new Creator<StreamParams>() {
+        @Override
+        public StreamParams createFromParcel(Parcel in) {
+            return new StreamParams(in);
+        }
+
+        @Override
+        public StreamParams[] newArray(int size) {
+            return new StreamParams[size];
+        }
+    };
+}
