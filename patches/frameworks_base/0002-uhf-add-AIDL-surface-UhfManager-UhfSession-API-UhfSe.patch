+package android.hardware.uhf;
+
+/**
+ * Reader presence/availability notifications, independent of any particular session. Delivered to
+ * every registered listener regardless of who (if anyone) currently holds the session — this is
+ * how an app decides whether to even try {@code openSession()} (FR-LC-01/06).
+ *
+ * @hide
+ */
+oneway interface IUhfStateCallback {
+    /**
+     * @param state one of {@code UhfManager.STATE_ABSENT}, {@code STATE_ATTACHED},
+     *     {@code STATE_READY}, {@code STATE_BUSY}, {@code STATE_ERROR}.
+     */
+    void onStateChanged(int state);
+}
