+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.SystemApi;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * Streaming counters (FR-STR-10). {@link #getElapsedMillis()} is measured from the first
+ * delivered read, never from the {@code startStreaming()} call — UHF-SRS-001 §3.3/§4.8 document
+ * mode-entry as costing five to ten seconds of command round trips before the first tag arrives,
+ * and a rate computed from the call instead of the first read understated a real ~50 reads/sec
+ * link as ~24. {@link UhfSession#resetStreamStats()} resets both the counters and this time base
+ * together, for the same reason: resetting one without the other drifts the rate upward across
+ * repeated measurements.
+ *
+ * @hide
+ */
+@SystemApi
+public final class StreamStats implements Parcelable {
+    private final long mUniqueTagCount;
+    private final long mTotalReadCount;
+    private final double mReadsPerSecond;
+    private final long mDroppedBatchCount;
+    private final long mElapsedMillis;
+
+    /** @hide */
+    public StreamStats(long uniqueTagCount, long totalReadCount, double readsPerSecond,
+            long droppedBatchCount, long elapsedMillis) {
+        mUniqueTagCount = uniqueTagCount;
+        mTotalReadCount = totalReadCount;
+        mReadsPerSecond = readsPerSecond;
+        mDroppedBatchCount = droppedBatchCount;
+        mElapsedMillis = elapsedMillis;
+    }
+
+    public long getUniqueTagCount() {
+        return mUniqueTagCount;
+    }
+
+    public long getTotalReadCount() {
+        return mTotalReadCount;
+    }
+
+    public double getReadsPerSecond() {
+        return mReadsPerSecond;
+    }
+
+    /** FR-STR-11: whole batches dropped for this client because it fell behind. */
+    public long getDroppedBatchCount() {
+        return mDroppedBatchCount;
+    }
+
+    /** Milliseconds since the first delivered read, not since {@code startStreaming()}. */
+    public long getElapsedMillis() {
+        return mElapsedMillis;
+    }
+
+    private StreamStats(Parcel in) {
+        mUniqueTagCount = in.readLong();
+        mTotalReadCount = in.readLong();
+        mReadsPerSecond = in.readDouble();
+        mDroppedBatchCount = in.readLong();
+        mElapsedMillis = in.readLong();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeLong(mUniqueTagCount);
+        dest.writeLong(mTotalReadCount);
+        dest.writeDouble(mReadsPerSecond);
+        dest.writeLong(mDroppedBatchCount);
+        dest.writeLong(mElapsedMillis);
+    }
+
+    @NonNull
+    public static final Creator<StreamStats> CREATOR = new Creator<StreamStats>() {
+        @Override
+        public StreamStats createFromParcel(Parcel in) {
+            return new StreamStats(in);
+        }
+
+        @Override
+        public StreamStats[] newArray(int size) {
+            return new StreamStats[size];
+        }
+    };
+}
