+ * limitations under the License.
+ */
+
+package android.hardware.uhf;
+
+import android.annotation.NonNull;
+import android.annotation.SystemApi;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * Parameters for one {@link UhfSession#inventory(InventoryParams)} round (FR-INV-04/05).
+ * Defaults (Q=4, session S0, no explicit antenna/target) match {@link UhfSession#inventory()}.
+ *
+ * <p>Per FR-INV-05, {@code antenna}, {@code target} and {@code scanTimeMs} travel together or not
+ * at all — the reader rejects a partial set. {@link #hasAntennaTargetScanTime()} tells the service
+ * which case this instance is; the {@link Builder} enforces it can only produce one or the other.
+ *
+ * @hide
+ */
+@SystemApi
+public final class InventoryParams implements Parcelable {
+
+    public static final int SESSION_S0 = 0;
+    public static final int SESSION_S1 = 1;
+    public static final int SESSION_S2 = 2;
+    public static final int SESSION_S3 = 3;
+
+    public static final int TARGET_A = 0;
+    public static final int TARGET_B = 1;
+
+    private final int mQValue;
+    private final int mSession;
+    private final boolean mHasAntennaTargetScanTime;
+    private final int mAntenna;
+    private final int mTarget;
+    private final int mScanTimeMs;
+
+    private InventoryParams(Builder b) {
+        mQValue = b.mQValue;
+        mSession = b.mSession;
+        mHasAntennaTargetScanTime = b.mHasAntennaTargetScanTime;
+        mAntenna = b.mAntenna;
+        mTarget = b.mTarget;
+        mScanTimeMs = b.mScanTimeMs;
+    }
+
+    public int getQValue() {
+        return mQValue;
+    }
+
+    public int getSession() {
+        return mSession;
+    }
+
+    /** FR-INV-05: whether {@link #getAntenna()}/{@link #getTarget()}/{@link #getScanTimeMs()}
+     * are populated. When {@code false} the reader's currently configured antenna mask, its
+     * default target, and its currently configured scan time apply instead. */
+    public boolean hasAntennaTargetScanTime() {
+        return mHasAntennaTargetScanTime;
+    }
+
+    public int getAntenna() {
+        return mAntenna;
+    }
+
+    public int getTarget() {
+        return mTarget;
+    }
+
+    public int getScanTimeMs() {
+        return mScanTimeMs;
+    }
+
+    /** Builder for {@link InventoryParams}. */
+    public static final class Builder {
+        private int mQValue = 4;
+        private int mSession = SESSION_S0;
+        private boolean mHasAntennaTargetScanTime;
+        private int mAntenna = 1;
+        private int mTarget = TARGET_A;
+        private int mScanTimeMs = 1000;
+
+        /** @param q 0-15. */
+        @NonNull
+        public Builder setQValue(int q) {
+            if (q < 0 || q > 15) {
+                throw new IllegalArgumentException("qValue " + q + " outside [0,15]");
+            }
+            mQValue = q;
+            return this;
+        }
+
+        @NonNull
+        public Builder setSession(int session) {
+            mSession = session;
+            return this;
+        }
+
+        /**
+         * Sets antenna, target and scan time together, per FR-INV-05. There is no way to set only
+         * one of the three: doing so at the wire level is a request the reader rejects, so the
+         * API does not offer it as three separate setters.
+         */
+        @NonNull
+        public Builder setAntennaTargetScanTime(int antennaPort, int target, int scanTimeMs) {
+            mHasAntennaTargetScanTime = true;
+            mAntenna = antennaPort;
+            mTarget = target;
+            mScanTimeMs = scanTimeMs;
+            return this;
+        }
+
+        @NonNull
+        public InventoryParams build() {
+            return new InventoryParams(this);
+        }
+    }
+
+    private InventoryParams(Parcel in) {
+        mQValue = in.readInt();
+        mSession = in.readInt();
+        mHasAntennaTargetScanTime = in.readBoolean();
+        mAntenna = in.readInt();
+        mTarget = in.readInt();
+        mScanTimeMs = in.readInt();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeInt(mQValue);
+        dest.writeInt(mSession);
+        dest.writeBoolean(mHasAntennaTargetScanTime);
+        dest.writeInt(mAntenna);
+        dest.writeInt(mTarget);
+        dest.writeInt(mScanTimeMs);
+    }
+
+    @NonNull
+    public static final Creator<InventoryParams> CREATOR = new Creator<InventoryParams>() {
+        @Override
+        public InventoryParams createFromParcel(Parcel in) {
+            return new InventoryParams(in);
+        }
+
+        @Override
+        public InventoryParams[] newArray(int size) {
+            return new InventoryParams[size];
+        }
+    };
+}
