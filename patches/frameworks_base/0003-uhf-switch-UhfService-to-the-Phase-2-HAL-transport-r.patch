+package com.android.server.uhf;
+
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.ServiceSpecificException;
+import android.util.Slog;
+
+import rockchip.uhf.aidl.IUhfReader;
+import rockchip.uhf.aidl.IUhfReaderCallback;
+
+/**
+ * UHF-SRS-001 Phase 2's {@link UhfTransport}: a thin Binder proxy to the vendor HAL
+ * ({@code rockchip.uhf.aidl.IUhfReader}), replacing {@code UhfSerialTransport} (removed in this
+ * same change, per SRS §10.2 Phase 2's exit criterion "JNI path removed"). Everything this class
+ * does is marshal calls and translate exceptions — the actual framing, CRC and resync logic moved
+ * to the HAL process (see {@code hardware/rockchip/uhf/aidl/default/UhfReader.cpp}); this is
+ * exactly the boundary {@link UhfTransport} was designed to be swappable at (see its own class
+ * doc), and {@link UhfSessionArbiter} does not change at all across this swap — its 74 tests keep
+ * passing unmodified.
+ *
+ * <p>NFR-R-01: a HAL crash must not affect {@code system_server}, and {@code init} restarts a
+ * {@code class hal} service automatically (the HAL's {@code .rc} entry). This class's job in that
+ * story is narrow: notice the death via {@link IBinder.DeathRecipient}, drop the now-dead proxy,
+ * and re-resolve it lazily on the next call — it does not itself restart anything.
+ */
+final class UhfHalTransport implements UhfTransport {
+    private static final String TAG = "UhfHalTransport";
+    private static final String HAL_INSTANCE = IUhfReader.DESCRIPTOR + "/default";
+
+    private final Object mLock = new Object();
+    private IUhfReader mHal; // null until resolved, or after the HAL dies
+    private volatile boolean mStreaming;
+
+    @Override
+    public void open() throws UhfTransportException {
+        try {
+            getHal().open();
+        } catch (RemoteException e) {
+            throw remoteToTransportException(e);
+        } catch (ServiceSpecificException e) {
+            throw serviceSpecificToTransportException(e);
+        }
+    }
+
+    @Override
+    public void close() {
+        IUhfReader hal;
+        synchronized (mLock) {
+            hal = mHal;
+        }
+        if (hal == null) {
+            return;
+        }
+        try {
+            hal.close();
+        } catch (RemoteException e) {
+            Slog.w(TAG, "close(): HAL already gone", e);
+        }
+    }
+
+    @Override
+    public boolean isOpen() {
+        IUhfReader hal;
+        synchronized (mLock) {
+            hal = mHal;
+        }
+        if (hal == null) {
+            return false;
+        }
+        try {
+            return hal.isOpen();
+        } catch (RemoteException e) {
+            return false; // HAL is gone; not open by any definition that matters to a caller
+        }
+    }
+
+    @Override
+    public byte[] transact(int command, byte[] payload, int timeoutMs)
+            throws UhfTransportException {
+        try {
+            return getHal().transact(command, payload, timeoutMs);
+        } catch (RemoteException e) {
+            throw remoteToTransportException(e);
+        } catch (ServiceSpecificException e) {
+            throw serviceSpecificToTransportException(e);
+        }
+    }
+
+    @Override
+    public void startStream(StreamCallback callback) throws UhfTransportException {
+        IUhfReaderCallback wrapper = new IUhfReaderCallback.Stub() {
+            @Override
+            public void onTagBatch(byte[][] rawTagRecords) {
+                callback.onTagBatch(rawTagRecords);
+            }
+
+            @Override
+            public void onError(int errorCode) {
+                mStreaming = false;
+                callback.onError(errorCode);
+            }
+        };
+        try {
+            getHal().startStream(wrapper);
+            mStreaming = true;
+        } catch (RemoteException e) {
+            throw remoteToTransportException(e);
+        } catch (ServiceSpecificException e) {
+            throw serviceSpecificToTransportException(e);
+        }
+    }
+
+    @Override
+    public void stopStream() {
+        mStreaming = false;
+        IUhfReader hal;
+        synchronized (mLock) {
+            hal = mHal;
+        }
+        if (hal == null) {
+            return;
+        }
+        try {
+            hal.stopStream();
+        } catch (RemoteException e) {
+            Slog.w(TAG, "stopStream(): HAL already gone", e);
+        }
+    }
+
+    /** Resolves (or re-resolves, after a death) the HAL proxy. Blocks briefly the first time, per
+     * {@link ServiceManager#waitForDeclaredService} — matches how {@code init} guarantees the VINTF
+     * manifest promises this instance exists, just not necessarily that it has started yet. */
+    private IUhfReader getHal() throws UhfTransportException {
+        synchronized (mLock) {
+            if (mHal != null) {
+                return mHal;
+            }
+            IBinder binder = ServiceManager.waitForDeclaredService(HAL_INSTANCE);
+            if (binder == null) {
+                throw new UhfTransportException(
+                        UhfProtocol.ERROR_DEVICE_LOST, "HAL not declared/available: " + HAL_INSTANCE);
+            }
+            try {
+                binder.linkToDeath(this::onHalDied, 0);
+            } catch (RemoteException e) {
+                throw new UhfTransportException(
+                        UhfProtocol.ERROR_DEVICE_LOST, "HAL died before it could be linked");
+            }
+            mHal = IUhfReader.Stub.asInterface(binder);
+            return mHal;
+        }
+    }
+
+    private void onHalDied() {
+        Slog.w(TAG, "HAL process died (NFR-R-01: init restarts it; re-resolving on next call)");
+        synchronized (mLock) {
+            mHal = null;
+        }
+        mStreaming = false;
+        // UhfService/UhfSessionArbiter observe this through isOpen() returning false and the next
+        // transact()/startStream() throwing ERROR_DEVICE_LOST — there is no separate "HAL died"
+        // signal path here, deliberately: it is the same failure shape as the reader itself being
+        // unplugged, and NFR-R-06's wedged-reader recovery (close/reopen/re-identify) already has
+        // to handle that shape regardless of which layer actually failed.
+    }
+
+    private static UhfTransportException remoteToTransportException(RemoteException e) {
+        return new UhfTransportException(UhfProtocol.ERROR_DEVICE_LOST, "HAL unreachable: " + e);
+    }
+
+    private static UhfTransportException serviceSpecificToTransportException(
+            ServiceSpecificException e) {
+        return new UhfTransportException(e.errorCode, e.getMessage());
+    }
+}
