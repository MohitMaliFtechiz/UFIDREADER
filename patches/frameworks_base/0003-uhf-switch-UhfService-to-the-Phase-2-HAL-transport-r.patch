-// Java-side "0 means not open" sentinel.
-inline jlong fdToHandle(int fd) {
-    return static_cast<jlong>(fd) + 1;
-}
-
-inline int handleToFd(jlong handle) {
-    return static_cast<int>(handle - 1);
-}
