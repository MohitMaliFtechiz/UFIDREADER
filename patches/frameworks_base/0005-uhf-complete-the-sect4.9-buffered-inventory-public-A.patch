+    /** FR-BUF-02. Confirm status pending OI-02: this assumes a status byte followed by a 2-byte
+     * big-endian count, the same general shape as every other status-prefixed reply in this
+     * protocol family; isolated here so a real capture only requires changing this one method. */
+    public synchronized int getBufferedTagCount(Object clientToken) throws UhfTransportException {
+        requireHolder(clientToken);
+        byte[] reply = transport.transact(CMD_BUFFER_COUNT, new byte[0], DEFAULT_TIMEOUT_MS);
+        if (reply.length < 3) {
+            throw new UhfTransportException(UhfProtocol.ERROR_PROTOCOL,
+                    "buffer count reply too short: " + reply.length + " bytes");
+        }
+        int status = reply[0] & 0xFF;
+        int error = UhfProtocol.mapStatusToError(status);
+        if (error != UhfProtocol.ERROR_NONE) {
+            throw new UhfTransportException(error, "buffer count status 0x"
+                    + Integer.toHexString(status));
+        }
+        return ((reply[1] & 0xFF) << 8) | (reply[2] & 0xFF);
+    }
+
+    /** FR-BUF-03: multi-frame replies are handled the same way FR-INV-02 handles them for polled
+     * inventory — {@link UhfTransport}'s contract already assembles a 0x03 chain before returning,
+     * so this reuses {@link #inventory}'s single-frame decode path rather than a second copy of
+     * the same logic. */
+    public synchronized List<UhfProtocol.TagRecord> readBuffer(Object clientToken)
+            throws UhfTransportException {
+        requireHolder(clientToken);
+        byte[] reply = transport.transact(CMD_BUFFER_READ, new byte[0], DEFAULT_TIMEOUT_MS);
+        int status = reply.length > 0 ? (reply[0] & 0xFF) : UhfProtocol.STATUS_NO_OPERABLE_TAGS;
+        int error = UhfProtocol.mapStatusToError(status);
+        if (error != UhfProtocol.ERROR_NONE) {
+            throw new UhfTransportException(error, "buffer read status 0x"
+                    + Integer.toHexString(status));
+        }
+        if (status == UhfProtocol.STATUS_NO_OPERABLE_TAGS) {
+            return new ArrayList<>(); // FR-INV-08's "empty, not an error" applies here too
+        }
+        List<UhfProtocol.Frame> chain = new ArrayList<>();
+        chain.add(new UhfProtocol.Frame(
+                UhfProtocol.ADDRESS_BROADCAST, CMD_BUFFER_READ, reply, reply.length + 5));
+        return UhfProtocol.assembleAndDecodeInventory(chain);
+    }
+
+    /** FR-BUF-04's explicit, mid-session half — see {@link #stopBufferedInventory}'s doc for the
+     * automatic-on-session-end half. Valid regardless of current mode: clearing a buffer that
+     * happens to be empty, or clearing outside a buffered session, is a harmless no-op on the
+     * wire, not an error worth distinguishing here. */
+    public synchronized void clearBuffer(Object clientToken) throws UhfTransportException {
+        requireHolder(clientToken);
+        transport.transact(CMD_BUFFER_CLEAR, new byte[0], DEFAULT_TIMEOUT_MS);
+    }
+
