diff --git a/services/core/java/com/android/server/uhf/UhfService.java b/services/core/java/com/android/server/uhf/UhfService.java
index 8508fd9b..f1159b8d 100644
--- a/services/core/java/com/android/server/uhf/UhfService.java
+++ b/services/core/java/com/android/server/uhf/UhfService.java
@@ -373,7 +373,7 @@ public final class UhfService extends SystemService {
                     params.hasAntennaTargetScanTime(),
                     params.getAntenna(),
                     params.getTarget(),
-                    params.getScanTimeMs()));
+                    params.getScanTimeMillis()));
             int reportedAntenna = params.hasAntennaTargetScanTime() ? params.getAntenna() : 0;
             return toUhfTags(records, reportedAntenna);
         }
