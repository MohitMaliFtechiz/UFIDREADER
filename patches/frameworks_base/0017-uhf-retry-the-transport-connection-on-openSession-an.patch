         arbiter.openSession(client);
         try {
             arbiter.lockTag(client, epcFilter(new byte[] {1, 2}), 0,
@@ -935,6 +1011,7 @@ public class UhfSessionArbiterTest {
         boolean isOpen;
         boolean failStopStream;
         boolean failNextStartStream;
+        boolean failNextTransact;
         final java.util.Map<Integer, byte[]> cannedReplies = new java.util.HashMap<>();
         byte[] lastInventoryPayload;
         byte[] lastBufferedStartPayload;
@@ -965,6 +1042,13 @@ public class UhfSessionArbiterTest {
 
         @Override public byte[] transact(int command, byte[] payload, int timeoutMs)
                 throws UhfTransportException {
+            if (failNextTransact) {
+                failNextTransact = false;
+                // Matches the real bug this simulates: open() on a UART always succeeds as soon
+                // as the device node exists, whether or not a reader is actually attached and
