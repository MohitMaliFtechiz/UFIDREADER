+#pragma once
+
+// Bn*.h is generated by the aidl compiler from ../rockchip/uhf/aidl/*.aidl; found under
+// out/soong/.intermediates/.../aidl_interface/... once this target has actually been built (it
+// has not, in this environment — see service.cpp's header comment).
+#include <aidl/rockchip/uhf/aidl/BnUhfReader.h>
+
+#include <atomic>
+#include <mutex>
+#include <thread>
+
+namespace aidl {
+namespace rockchip {
+namespace uhf {
+namespace aidl {
+namespace impl {
+
+using ::aidl::rockchip::uhf::aidl::BnUhfReader;
+using ::aidl::rockchip::uhf::aidl::IUhfReaderCallback;
+
+/**
+ * UHF-SRS-001 Phase 2 default HAL implementation. Owns the tty and the framing/CRC/resync logic
+ * (via UhfWireProtocol.h, a close port of the tested UhfProtocol.java) and nothing about policy —
+ * that stays in UhfSessionArbiter on the system_server side of this Binder boundary.
+ *
+ * STATUS: written, not built or run — see this directory's service.cpp for the full caveat this
+ * class shares with UhfWireProtocol.h and the rest of this HAL.
+ */
+class UhfReader : public BnUhfReader {
+public:
+    UhfReader();
+    ~UhfReader() override;
+
+    ::ndk::ScopedAStatus isOpen(bool* _aidl_return) override;
+    ::ndk::ScopedAStatus open() override;
+    ::ndk::ScopedAStatus close() override;
+    ::ndk::ScopedAStatus transact(int32_t command, const std::vector<uint8_t>& payload,
+                                   int32_t timeoutMs, std::vector<uint8_t>* _aidl_return) override;
+    ::ndk::ScopedAStatus startStream(
+            const std::shared_ptr<IUhfReaderCallback>& callback) override;
+    ::ndk::ScopedAStatus stopStream() override;
+
+private:
+    void pumpLoop(std::shared_ptr<IUhfReaderCallback> callback);
+    ::ndk::ScopedAStatus requireOpenLocked();
+
+    std::mutex mIoLock; // guards mFd against a concurrent close(); see UhfSessionArbiter's class
+                         // doc on the Java side for why transact()/startStream() calls don't need
+                         // their own transaction-level lock here — the arbiter already serializes
+                         // them (NFR-C-01) before they ever reach this Binder boundary.
+    int mFd = -1; // -1 == not open
+
+    std::atomic<bool> mStreaming{false};
+    std::thread mPumpThread;
+};
+
+}  // namespace impl
+}  // namespace aidl
+}  // namespace uhf
+}  // namespace rockchip
+}  // namespace aidl
diff --git a/aidl/default/UhfWireProtocol.h b/aidl/default/UhfWireProtocol.h
new file mode 100644
index 0000000..762733f
--- /dev/null
+++ b/aidl/default/UhfWireProtocol.h
@@ -0,0 +1,141 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace rockchip {
+namespace uhf {
+
+// A deliberate, close port of com.android.server.uhf.UhfProtocol's CRC16/frame/resync logic
+// (frameworks/base/services/core/java/com/android/server/uhf/UhfProtocol.java), which carries 37
+// passing host-side JUnit tests covering exactly this algorithm — the fuzz test over 1MB of
+// random bytes, the CRC-corrupted-frame stall-recovery case, the reCmd-vs-CRC distinction. This
+// header is NOT independently tested in C++ in this pass (no build of this HAL has been attempted
+// here, per this file's own service implementation's header comment); its correctness claim rests
+// entirely on being a faithful, line-for-line-equivalent port of the Java version that is tested,
+// not on any verification of its own. Keep it that way: if the two ever diverge, treat the Java
+// version as the source of truth and re-port, rather than fixing them independently.
+//
+// Only the subset UhfReader.cpp actually needs is ported: CRC16, frame build, and scan/resync.
+// Status-to-error mapping and payload decoding (0x21, tag records) stay in Java — UhfHalTransport
+// and UhfSessionArbiter do that, the same as they did with the Phase 1 JNI transport, since the
+// HAL's job per SRS §3.2 is framing and timing, not interpreting payload contents.
+
+constexpr int kMinLenField = 4;
+constexpr int kMaxLenField = 0xFF;
+constexpr int kAddressBroadcast = 0xFF;
+constexpr uint16_t kCrc16Init = 0xFFFF; // CRC-16/MODBUS; see UhfProtocol.java's doc on this being
+                                         // an inference pending R1, isolated to one constant.
+
+inline uint16_t crc16(const uint8_t* data, size_t length) {
+    uint32_t crc = kCrc16Init;
+    for (size_t i = 0; i < length; i++) {
+        crc ^= data[i];
+        for (int bit = 0; bit < 8; bit++) {
+            bool lsbSet = (crc & 0x0001) != 0;
+            crc >>= 1;
+            if (lsbSet) {
+                crc ^= 0xA001;
+            }
+        }
+    }
+    return static_cast<uint16_t>(crc & 0xFFFF);
+}
+
+inline bool isCrcValid(const uint8_t* data, size_t length) {
+    return length >= 2 && crc16(data, length) == 0;
+}
+
+// Len | Adr | Cmd | Data[] | CRC16-LSB | CRC16-MSB
+inline std::vector<uint8_t> buildFrame(int address, int command,
+                                        const std::vector<uint8_t>& payload) {
+    size_t len = 2 + payload.size() + 2; // Adr + Cmd + Data + CRC16(2)
+    std::vector<uint8_t> frame(1 + len);
+    frame[0] = static_cast<uint8_t>(len);
+    frame[1] = static_cast<uint8_t>(address);
+    frame[2] = static_cast<uint8_t>(command);
+    std::copy(payload.begin(), payload.end(), frame.begin() + 3);
+    uint16_t crc = crc16(frame.data(), 3 + payload.size());
+    frame[3 + payload.size()] = static_cast<uint8_t>(crc & 0xFF);
+    frame[3 + payload.size() + 1] = static_cast<uint8_t>((crc >> 8) & 0xFF);
+    return frame;
+}
+
+struct Frame {
+    int address;
+    int command;
+    std::vector<uint8_t> data;
+    size_t wireLength;
+};
+
+enum class ScanOutcome { kFrame, kNeedMoreData, kResync };
+
+struct ScanResult {
+    ScanOutcome outcome;
+    Frame frame;         // valid only when outcome == kFrame
+    size_t bytesToDiscard = 0; // valid only when outcome == kResync
+};
+
+// Mirrors UhfProtocol.scan() exactly: a length byte below kMinLenField is unrecoverable garbage
+// (discard 1, rescan); a structurally complete candidate whose CRC fails is discarded the same
+// way, one byte at a time, never assumed "nearly right" and repaired.
+inline ScanResult scan(const uint8_t* buf, size_t length) {
+    if (length == 0) {
+        return {ScanOutcome::kNeedMoreData, {}, 0};
+    }
+    int lenField = buf[0];
+    if (lenField < kMinLenField) {
+        return {ScanOutcome::kResync, {}, 1};
+    }
+    size_t wireLength = 1 + static_cast<size_t>(lenField);
+    if (length < wireLength) {
+        return {ScanOutcome::kNeedMoreData, {}, 0};
+    }
+    if (!isCrcValid(buf, wireLength)) {
+        return {ScanOutcome::kResync, {}, 1};
+    }
+    Frame f;
+    f.address = buf[1];
+    f.command = buf[2];
+    f.wireLength = wireLength;
+    size_t dataLen = static_cast<size_t>(lenField) - 4;
+    f.data.assign(buf + 3, buf + 3 + dataLen);
+    return {ScanOutcome::kFrame, f, 0};
+}
+
+// Mirrors UhfProtocol.scanWithStallRecovery(): pairs frame recovery with FR-LNK-05's inter-byte
+// timeout so a length byte that merely *looks* valid but is actually corrupted receive noise does
+// not stall the parser forever once no more bytes are coming.
+inline ScanResult scanWithStallRecovery(const uint8_t* buf, size_t length, bool staleTimeoutElapsed) {
+    ScanResult r = scan(buf, length);
+    if (r.outcome == ScanOutcome::kNeedMoreData && length > 0 && staleTimeoutElapsed) {
+        return {ScanOutcome::kResync, {}, 1};
+    }
+    return r;
+}
+
+// FR-LNK-06: a reply is only the answer to sentCommand if its echoed command matches — a
+// structurally valid, CRC-correct frame is not enough (an interleaved real-time tag frame passes
+// both those checks too).
+inline bool reCmdMatches(const Frame& reply, int sentCommand) {
+    return reply.command == sentCommand;
+}
+
+}  // namespace uhf
+}  // namespace rockchip
