diff --git a/aidl/Android.bp b/aidl/Android.bp
new file mode 100644
index 0000000..cdcd025
--- /dev/null
+++ b/aidl/Android.bp
@@ -0,0 +1,32 @@
+//
+// UHF-SRS-001 Phase 2: the vendor AIDL boundary between UhfService (system_server) and the
+// reader. Named rockchip.uhf.aidl, not android.hardware.uhf, per this tree's own convention for a
+// Rockchip-specific (non-Treble-core) interface — see hardware/rockchip/hwc_proxy_service/ for
+// the precedent this mirrors: aidl_interface module name, source layout under a package-shaped
+// directory, and stability: "vintf" for the same reason hwc.proxy declares it.
+//
+aidl_interface {
+    name: "rockchip.uhf.aidl",
+    vendor_available: true,
+    srcs: [
+        "rockchip/uhf/aidl/*.aidl",
+    ],
+    stability: "vintf",
+    backend: {
+        java: {
+            platform_apis: true,
+        },
+        cpp: {
+            enabled: false,
+        },
+        ndk: {
+            enabled: true,
+        },
+    },
+    versions_with_info: [
+        {
+            version: "1",
+            imports: [],
+        },
+    ],
+}
diff --git a/aidl/default/Android.bp b/aidl/default/Android.bp
new file mode 100644
index 0000000..4167c41
--- /dev/null
+++ b/aidl/default/Android.bp
@@ -0,0 +1,26 @@
+//
+// UHF-SRS-001 Phase 2 default HAL implementation. Mirrors
+// hardware/rockchip/hwc_proxy_service/default/Android.bp's shape (this tree's own precedent for a
+// custom Rockchip AIDL service) rather than a generic template.
+//
+cc_binary {
+    name: "rockchip.uhf-service",
+    relative_install_path: "hw",
+    init_rc: ["rockchip.uhf-service.rc"],
+    vintf_fragments: ["rockchip.uhf-service.xml"],
+    vendor: true,
+    srcs: [
+        "UhfReader.cpp",
+        "service.cpp",
+    ],
+    shared_libs: [
+        "libbase",
+        "liblog",
+        "libbinder_ndk",
+        "rockchip.uhf.aidl-V1-ndk",
+    ],
+    cflags: [
+        "-Wall",
+        "-Werror",
+    ],
+}
