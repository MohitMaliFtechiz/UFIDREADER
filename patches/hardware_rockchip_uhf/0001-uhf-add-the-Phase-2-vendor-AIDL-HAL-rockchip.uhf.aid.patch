+ * limitations under the License.
+ */
+
+package rockchip.uhf.aidl;
+
+import rockchip.uhf.aidl.IUhfReaderCallback;
+
+/**
+ * UHF-SRS-001 §5.3/§3.2: the vendor process's interface, deliberately as thin as the SRS asks for
+ * it to be — it owns framing, CRC16, resync and timing (the parts that must be close to the wire)
+ * and nothing about policy, permissions, or session arbitration (UhfSessionArbiter's job, on the
+ * system_server side of this boundary). A new reader command needs no change here at all: it is
+ * just a different {@code command}/{@code payload} to {@link #transact}.
+ *
+ * <p>This intentionally mirrors {@code com.android.server.uhf.UhfTransport} (the Phase 1 JNI
+ * interface) method-for-method, so that {@code UhfHalTransport} — the Phase 2 implementation of
+ * that same Java interface — is a thin Binder proxy and {@code UhfSessionArbiter} does not change
+ * at all across the Phase 1/2 boundary, exactly as SRS §3.2 intends.
+ */
+@VintfStability
+interface IUhfReader {
+    boolean isOpen();
+
+    void open();
+
+    void close();
+
+    /**
+     * Sends one framed command and returns its payload once a reply whose {@code reCmd} matches
+     * {@code command} has been received, or throws a {@link android.os.ServiceSpecificException}
+     * with one of the stable error codes (matching {@code UhfTransportException}'s) on timeout or
+     * a reader-reported error status. Multi-frame replies (status 0x03) are assembled here; the
+     * caller sees one concatenated result — FR-INV-02.
+     */
+    byte[] transact(int command, in byte[] payload, int timeoutMs);
+
+    /** Enters real-time streaming mode and delivers batches to {@code callback} until
+     * {@link #stopStream}. Returns once mode entry is acknowledged. */
+    void startStream(IUhfReaderCallback callback);
+
+    /** FR-STR-07: retries the stop frame and confirms the port has gone quiet before returning. */
+    void stopStream();
+}
