+# this tree's own precedent for how a custom Rockchip AIDL service gets pulled into a product.
+#
+# Unlike hwc_proxy_service.mk (inherited from the shared device/rockchip/common/device.mk, so it
+# ships on every Rockchip board), THIS file is inherited only from
