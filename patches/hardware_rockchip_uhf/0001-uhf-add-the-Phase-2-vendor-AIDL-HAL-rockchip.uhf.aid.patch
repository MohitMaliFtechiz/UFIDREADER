+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ * STATUS: this whole default/ directory is written, not built or run. Compiling it would need
+ * `m rockchip.uhf-service` against the full framework (per this patch series' cover note, that
+ * was not attempted in this session), and there is no reader attached to this environment to
+ * exercise it against even if it were built. UhfWireProtocol.h's doc explains what that does and
+ * does not mean for the one piece of logic here worth trusting anyway: it is a close port of
+ * already-tested Java, not new unverified logic.
+ */
+
+#include <android-base/logging.h>
+#include <android/binder_manager.h>
+#include <android/binder_process.h>
+
+#include "UhfReader.h"
+
+using ::aidl::rockchip::uhf::aidl::impl::UhfReader;
+
+int main() {
+    ABinderProcess_setThreadPoolMaxThreadCount(1); // one transaction at a time; NFR-C-01
+    std::shared_ptr<UhfReader> reader = ndk::SharedRefBase::make<UhfReader>();
+
+    const std::string instance = std::string() + UhfReader::descriptor + "/default";
+    binder_status_t status =
+            AServiceManager_addService(reader->asBinder().get(), instance.c_str());
+    CHECK_EQ(status, STATUS_OK);
+
+    ABinderProcess_joinThreadPool();
+    return EXIT_FAILURE; // should not reach
+}
