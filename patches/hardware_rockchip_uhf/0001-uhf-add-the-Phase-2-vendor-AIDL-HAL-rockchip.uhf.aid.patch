+
+#include "UhfReader.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include <android-base/logging.h>
+
+#include "UhfWireProtocol.h"
+
+namespace aidl {
+namespace rockchip {
+namespace uhf {
+namespace aidl {
+namespace impl {
+
+namespace {
+// Mirrors com.android.server.uhf.UhfProtocol.ERROR_* exactly (§5.5). See UhfHalTransport.java on
+// the Java side for the other half of this contract.
+constexpr int32_t kErrorProtocol = 4;
+constexpr int32_t kErrorTimeout = 6;
+constexpr int32_t kErrorDeviceLost = 7;
+
+// FR-LNK-01.
+constexpr const char* kDevicePath = "/dev/ttyUSB0"; // see OI-05 on narrowing this match
+constexpr speed_t kBaudRate = B115200;
+constexpr int64_t kInterByteGapNanos = 15'000'000; // FR-LNK-05
+constexpr int kReadPollTimeoutMs = 500;
+constexpr int kMaxTransactRetries = 2;
+
+int64_t nowNanos() {
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<int64_t>(ts.tv_sec) * 1'000'000'000LL + ts.tv_nsec;
+}
+
+// Returns bytes read (0 on timeout/no data), matching UhfSerialTransport.nativeRead()'s contract.
+ssize_t pollAndRead(int fd, uint8_t* buf, size_t offset, size_t length, int timeoutMs) {
+    pollfd pfd{fd, POLLIN, 0};
+    int r = poll(&pfd, 1, timeoutMs);
+    if (r <= 0) {
+        return 0;
+    }
+    ssize_t n = ::read(fd, buf + offset, length);
+    return n > 0 ? n : 0;
+}
+}  // namespace
+
+UhfReader::UhfReader() = default;
+
+UhfReader::~UhfReader() {
+    close();
+}
+
+::ndk::ScopedAStatus UhfReader::isOpen(bool* _aidl_return) {
+    std::lock_guard<std::mutex> lock(mIoLock);
+    *_aidl_return = mFd >= 0;
+    return ::ndk::ScopedAStatus::ok();
+}
+
+::ndk::ScopedAStatus UhfReader::open() {
+    std::lock_guard<std::mutex> lock(mIoLock);
+    if (mFd >= 0) {
+        return ::ndk::ScopedAStatus::ok(); // idempotent, per the interface's Java-side contract
+    }
+    int fd = ::open(kDevicePath, O_RDWR | O_NOCTTY);
+    if (fd < 0) {
+        LOG(ERROR) << "open(" << kDevicePath << ") failed: " << strerror(errno);
+        return ::ndk::ScopedAStatus::fromServiceSpecificError(kErrorDeviceLost);
+    }
+    termios tty{};
+    if (tcgetattr(fd, &tty) != 0) {
+        ::close(fd);
+        return ::ndk::ScopedAStatus::fromServiceSpecificError(kErrorDeviceLost);
+    }
+    cfmakeraw(&tty);
+    cfsetispeed(&tty, kBaudRate);
+    cfsetospeed(&tty, kBaudRate);
+    tty.c_cflag |= (CLOCAL | CREAD);
+    tty.c_cc[VMIN] = 0;
+    tty.c_cc[VTIME] = 0;
+    if (tcsetattr(fd, TCSANOW, &tty) != 0) {
+        ::close(fd);
+        return ::ndk::ScopedAStatus::fromServiceSpecificError(kErrorDeviceLost);
+    }
+    tcflush(fd, TCIOFLUSH);
+    mFd = fd;
+    return ::ndk::ScopedAStatus::ok();
+}
+
+::ndk::ScopedAStatus UhfReader::close() {
+    {
+        std::lock_guard<std::mutex> lock(mIoLock);
+        if (mFd < 0) {
+            return ::ndk::ScopedAStatus::ok();
+        }
+    }
+    stopStream();
+    std::lock_guard<std::mutex> lock(mIoLock);
+    ::close(mFd);
+    mFd = -1;
+    return ::ndk::ScopedAStatus::ok();
+}
+
+::ndk::ScopedAStatus UhfReader::requireOpenLocked() {
+    if (mFd < 0) {
+        return ::ndk::ScopedAStatus::fromServiceSpecificError(kErrorDeviceLost);
+    }
+    return ::ndk::ScopedAStatus::ok();
+}
+
+::ndk::ScopedAStatus UhfReader::transact(int32_t command, const std::vector<uint8_t>& payload,
+                                          int32_t timeoutMs, std::vector<uint8_t>* _aidl_return) {
+    std::vector<uint8_t> frame = rockchip::uhf::buildFrame(rockchip::uhf::kAddressBroadcast,
+                                                            command, payload);
+    ::ndk::ScopedAStatus lastFailure = ::ndk::ScopedAStatus::ok();
+    for (int attempt = 0; attempt <= kMaxTransactRetries; attempt++) {
+        std::lock_guard<std::mutex> lock(mIoLock);
+        auto openStatus = requireOpenLocked();
+        if (!openStatus.isOk()) {
+            return openStatus;
+        }
+        tcflush(mFd, TCIFLUSH); // FR-LNK-08
+        if (::write(mFd, frame.data(), frame.size()) != static_cast<ssize_t>(frame.size())) {
+            LOG(WARNING) << "short write on transact(0x" << std::hex << command << ")";
+        }
+
+        std::vector<uint8_t> multiFrameData;
+        uint8_t buf[4096];
+        size_t len = 0;
+        int64_t deadline = nowNanos() + static_cast<int64_t>(timeoutMs) * 1'000'000;
+        int64_t lastByteAt = nowNanos();
+        bool timedOut = false;
+
+        while (nowNanos() < deadline) {
+            int remainingMs = static_cast<int>((deadline - nowNanos()) / 1'000'000);
+            ssize_t n = pollAndRead(mFd, buf, len, sizeof(buf) - len,
+                                     std::min(kReadPollTimeoutMs, std::max(0, remainingMs)));
+            if (n > 0) {
+                len += n;
+                lastByteAt = nowNanos();
+            }
+            bool stale = (nowNanos() - lastByteAt) > kInterByteGapNanos;
+
+            size_t offset = 0;
+            bool gotReply = false;
+            while (offset < len) {
+                auto r = rockchip::uhf::scanWithStallRecovery(buf + offset, len - offset, stale);
+                if (r.outcome == rockchip::uhf::ScanOutcome::kNeedMoreData) {
+                    break;
+                }
+                if (r.outcome == rockchip::uhf::ScanOutcome::kResync) {
+                    offset += r.bytesToDiscard;
+                    continue;
+                }
+                offset += r.frame.wireLength;
+                if (!rockchip::uhf::reCmdMatches(r.frame, command)) {
+                    continue; // FR-LNK-06: e.g. an interleaved 0xEE real-time tag frame
+                }
+                int status = !r.frame.data.empty() ? r.frame.data[0] : 0x01;
+                multiFrameData.insert(multiFrameData.end(), r.frame.data.begin(),
+                                       r.frame.data.end());
+                if (status != 0x03 /* STATUS_MORE_FRAMES_FOLLOW, FR-INV-02 */) {
+                    *_aidl_return = multiFrameData;
+                    gotReply = true;
+                    break;
+                }
+            }
+            if (gotReply) {
+                return ::ndk::ScopedAStatus::ok();
+            }
+            if (offset > 0) {
+                memmove(buf, buf + offset, len - offset);
+                len -= offset;
+            }
+        }
+        timedOut = true;
+        (void)timedOut;
+        lastFailure = ::ndk::ScopedAStatus::fromServiceSpecificError(kErrorTimeout);
+    }
+    return lastFailure;
+}
+
+::ndk::ScopedAStatus UhfReader::startStream(const std::shared_ptr<IUhfReaderCallback>& callback) {
+    std::lock_guard<std::mutex> lock(mIoLock);
+    auto openStatus = requireOpenLocked();
+    if (!openStatus.isOk()) {
+        return openStatus;
+    }
+    if (mStreaming.load()) {
+        return ::ndk::ScopedAStatus::ok();
+    }
+    std::vector<uint8_t> enter = rockchip::uhf::buildFrame(rockchip::uhf::kAddressBroadcast, 0x76,
+                                                            {0x01});
+    ::write(mFd, enter.data(), enter.size());
+    mStreaming.store(true);
+    mPumpThread = std::thread(&UhfReader::pumpLoop, this, callback);
+    return ::ndk::ScopedAStatus::ok();
+}
+
+::ndk::ScopedAStatus UhfReader::stopStream() {
+    if (!mStreaming.exchange(false)) {
+        return ::ndk::ScopedAStatus::ok();
+    }
+    // FR-STR-07's retry-and-confirm-quiet loop needs a live reader to validate the "confirm
+    // quiet" half against; this sends the stop frame once and joins the pump thread, same
+    // documented gap as the Phase 1 JNI transport had.
+    {
+        std::lock_guard<std::mutex> lock(mIoLock);
+        if (mFd >= 0) {
+            std::vector<uint8_t> stop = rockchip::uhf::buildFrame(
+                    rockchip::uhf::kAddressBroadcast, 0x76, {0x00});
+            ::write(mFd, stop.data(), stop.size());
+        }
+    }
+    if (mPumpThread.joinable()) {
+        mPumpThread.join();
+    }
+    return ::ndk::ScopedAStatus::ok();
+}
+
+void UhfReader::pumpLoop(std::shared_ptr<IUhfReaderCallback> callback) {
+    uint8_t buf[4096];
+    size_t len = 0;
+    int64_t lastByteAt = nowNanos();
+    while (mStreaming.load()) {
+        int fd;
+        {
+            std::lock_guard<std::mutex> lock(mIoLock);
+            fd = mFd;
+        }
+        if (fd < 0) {
+            callback->onError(kErrorDeviceLost);
+            return;
+        }
+        ssize_t n = pollAndRead(fd, buf, len, sizeof(buf) - len, kReadPollTimeoutMs);
+        if (n > 0) {
+            len += n;
+            lastByteAt = nowNanos();
+        }
+        bool stale = (nowNanos() - lastByteAt) > kInterByteGapNanos;
+
+        std::vector<std::vector<uint8_t>> batch;
+        size_t offset = 0;
+        while (offset < len) {
+            auto r = rockchip::uhf::scanWithStallRecovery(buf + offset, len - offset, stale);
+            if (r.outcome == rockchip::uhf::ScanOutcome::kNeedMoreData) {
+                break;
+            }
+            if (r.outcome == rockchip::uhf::ScanOutcome::kResync) {
+                offset += r.bytesToDiscard;
+                continue;
+            }
+            offset += r.frame.wireLength;
+            if (r.frame.command == 0xEE) { // real-time tag frame, UHF-SRS-001 §1.3
+                batch.push_back(r.frame.data);
+            }
+        }
+        if (offset > 0) {
+            memmove(buf, buf + offset, len - offset);
+            len -= offset;
+        }
+        if (!batch.empty()) {
+            callback->onTagBatch(batch);
+        }
+    }
+}
+
+}  // namespace impl
+}  // namespace aidl
+}  // namespace uhf
+}  // namespace rockchip
+}  // namespace aidl
