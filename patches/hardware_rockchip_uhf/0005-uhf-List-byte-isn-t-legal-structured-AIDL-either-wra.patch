+package rockchip.uhf.aidl;
+
+/**
+ * One raw, still-undecoded tag-record payload (post status-byte-stripping) from
+ * {@link IUhfReaderCallback#onTagBatch}. A one-field wrapper around {@code byte[]}: structured/
+ * stable AIDL has no variable-length-array-of-variable-length-array type (neither {@code byte[][]}
+ * nor {@code List<byte[]>} is legal — confirmed by actually running
+ * {@code m rockchip.uhf.aidl-update-api} against both), so a batch is
+ * {@code UhfRawTagRecord[]} instead: a single-dimensional array of a parcelable, which is exactly
+ * as legal as an array of any other parcelable regardless of what variable-length data the
+ * parcelable itself carries.
+ */
+parcelable UhfRawTagRecord {
+    byte[] data;
+}
