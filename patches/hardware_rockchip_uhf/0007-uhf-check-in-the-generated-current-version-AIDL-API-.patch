+// with such a backward incompatible change, it has a high risk of breaking
+// later when a module using the interface is updated, e.g., Mainline modules.
+
+package rockchip.uhf.aidl;
+@VintfStability
+interface IUhfReader {
+  boolean isOpen();
+  void open();
+  void close();
+  byte[] transact(int command, in byte[] payload, int timeoutMs);
+  void startStream(rockchip.uhf.aidl.IUhfReaderCallback callback);
+  void stopStream();
+}
